  "canonicalCases": [
    {
      "name": "a bare primary subtag lowercases",
      "input": "EN",
      "canonical": "en"
    },
    {
      "name": "an underscore is a separator",
      "input": "en_gb",
      "canonical": "en-GB"
    },
    {
      "name": "a two-character subtag uppercases",
      "input": "en-gb",
      "canonical": "en-GB"
    },
    {
      "name": "a four-character script subtag title-cases",
      "input": "ZH-HANT",
      "canonical": "zh-Hant"
    },
    {
      "name": "surrounding whitespace is trimmed",
      "input": "  zh-hant  ",
      "canonical": "zh-Hant"
    },
    {
      "name": "a three-character subtag lowercases",
      "input": "es-419",
      "canonical": "es-419"
    },
    {
      "name": "so does a five-character one, which is why the key is es-latam",
      "input": "es-LATAM",
      "canonical": "es-latam"
    },
    {
      "name": "an empty tag means automatic",
      "input": "",
      "canonical": "auto"
    },
    {
      "name": "whitespace only means automatic",
      "input": "   ",
      "canonical": "auto"
    },
    {
      "name": "separators with no subtags are not automatic",
      "input": "-",
      "canonical": "-"
    },
    {
      "name": "a three-part tag canonicalizes every subtag",
      "input": "zh_hant_hk",
      "canonical": "zh-Hant-HK"
    }
  ],

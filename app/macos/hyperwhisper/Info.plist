<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUFeedURL</key>
	<string>https://www.hyperwhisper.com/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>bw+WKGOtnCqIDm0Q9FFlq1hSQnaw0RlIYcnY6uGp0e4=</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>HyperWhisper uses Apple Events to send your transcribed text to apps like Notes (Quick Capture) and to adjust audio routing while recording.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>HyperWhisper muffles other apps' audio while you record when Media control is set to Muffle Audio.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>HyperWhisper needs Accessibility access to support bare modifier keys (Control, Command, FN) for Push to Talk recording.</string>
	<!-- Open With / `open -a HyperWhisper <file>` (issue #656). The same types the
	     Transcribe File picker accepts: keep in sync with
	     FileTranscriptionFlow.supportedAudioTypes (OpenedFileRouterTests checks it).
	     Viewer + Alternate only, so HyperWhisper never becomes the default app for
	     .m4a/.mp4 or any other of these types. org.xiph.* are listed for the
	     .ogg/.flac extensions; public.audio covers them where the system declares
	     them as audio. Handled by AppDelegate.application(_:open:). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>com.microsoft.waveform-audio</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>public.aiff-audio</string>
				<string>org.xiph.ogg</string>
				<string>org.xiph.ogg-audio</string>
				<string>org.xiph.flac</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
		<string>es</string>
		<string>zh-Hans</string>
	</array>

	<!-- Sentry Configuration (optional). Injected at build time from
	     Configurations/*.xcconfig (see Configurations/Release.xcconfig.example).
	     Empty by default — SentryService no-ops when the DSN is blank. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SentryEnvironment</key>
	<string>$(SENTRY_ENVIRONMENT)</string>
</dict>
</plist>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness (like the shared-dotnet *.Tests projects): the Whisper
       worker protocol, the client state machine against a fake worker, the
       worker's command loop against a fake Whisper service, and the real worker
       exe end to end. Plain net10.0, so it builds and runs on Linux too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperWhisper.WhisperWorker.Client\HyperWhisper.WhisperWorker.Client.csproj" />
    <!-- For WorkerHost (in process) and so the worker exe is built before the
         end-to-end checks start it from its own bin folder. -->
    <ProjectReference Include="..\HyperWhisper.WhisperWorker\HyperWhisper.WhisperWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The first-run sample clip: real speech for the optional real-model check. -->
    <Content Include="..\HyperWhisper\Assets\Sounds\onboarding-sample.wav" Link="onboarding-sample.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- LIGHT THEME COLORS
         Light mode color palette for HyperWhisper Windows app.
         Follows macOS HyperWhisper design language with bright backgrounds
         and dark text for optimal readability in well-lit environments.
    -->

    <!-- Primary Accent Colors -->
    <Color x:Key="AccentColor">#007AFF</Color>
    <Color x:Key="AccentColorHover">#0A84FF</Color>
    <Color x:Key="AccentColorPressed">#0066D6</Color>

    <!-- Sidebar Icon Colors (consistent across themes for brand recognition) -->
    <Color x:Key="HomeIconColor">#FF6B6B</Color>
    <Color x:Key="HistoryIconColor">#4ECDC4</Color>
    <Color x:Key="ModesIconColor">#45B7D1</Color>
    <Color x:Key="VocabularyIconColor">#F9CA24</Color>
    <Color x:Key="SettingsIconColor">#95A5A6</Color>

    <!-- Status Colors (semantic colors, consistent across themes) -->
    <Color x:Key="SuccessColor">#34C759</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="ErrorColor">#FF3B30</Color>
    <Color x:Key="ProcessingColor">#5856D6</Color>
    <Color x:Key="PostProcessingColor">#AF52DE</Color>

    <!-- Light Theme Background Colors -->
    <Color x:Key="SidebarBackground">#EDEDEEF1</Color>
    <Color x:Key="ContentBackground">#F4F5F5F7</Color>
    <Color x:Key="CardBackground">#FAFCFCFD</Color>
    <Color x:Key="InputBackground">#F8FDFDFE</Color>
    <Color x:Key="HoverBackground">#E4E6EA</Color>
    <Color x:Key="SelectedBackground">#D9E9FF</Color>
    <Color x:Key="BorderColor">#C9D8DAE0</Color>

    <!-- Light Theme Text Colors -->
    <Color x:Key="TextPrimary">#1D1D1F</Color>
    <Color x:Key="TextSecondary">#6E6E73</Color>
    <Color x:Key="TextTertiary">#A1A1A6</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- Semantic Alert Colors - Warning (Yellow/Amber) -->
    <Color x:Key="WarningBackground">#FFF3CD</Color>
    <Color x:Key="WarningForeground">#856404</Color>
    <Color x:Key="WarningBorder">#FFEEBA</Color>

    <!-- Semantic Alert Colors - Error (Red) -->
    <Color x:Key="ErrorBackground">#F8D7DA</Color>
    <Color x:Key="ErrorForeground">#721C24</Color>
    <Color x:Key="ErrorBorder">#F5C6CB</Color>

    <!-- Semantic Alert Colors - Info (Blue) -->
    <Color x:Key="InfoBackground">#E8F4FD</Color>
    <Color x:Key="InfoForeground">#0D6EFD</Color>
    <Color x:Key="InfoBorder">#B8DAFF</Color>

    <!-- Semantic Alert Colors - Success (Green) -->
    <Color x:Key="SuccessBackground">#D4EDDA</Color>
    <Color x:Key="SuccessForeground">#155724</Color>
    <Color x:Key="SuccessBorder">#C3E6CB</Color>

    <!-- Badge Colors -->
    <Color x:Key="BadgeGrayBackground">#F5F5F5</Color>
    <Color x:Key="BadgeGrayForeground">#616161</Color>

    <!-- Progress Bar -->
    <Color x:Key="ProgressBackground">#E0E0E0</Color>

    <!-- Hover States -->
    <Color x:Key="DeleteHoverBackground">#FFEBEE</Color>

    <!-- Statistics Colors -->
    <Color x:Key="StatisticsIconColor">#6366F1</Color>
    <Color x:Key="StatisticsBlue">#3B82F6</Color>
    <Color x:Key="StatisticsGreen">#22C55E</Color>
    <Color x:Key="StatisticsPurple">#A855F7</Color>
    <Color x:Key="StatisticsOrange">#F97316</Color>
    <Color x:Key="StatisticsChartBar">#6366F1</Color>

    <!-- BRUSHES
         Frozen, with this theme's colours resolved at load (StaticResource,
         so each colour above must stay defined before its brush).
         ThemeService swaps this whole dictionary, which re-resolves every
         {DynamicResource XBrush} consumer. A frozen brush takes no Changed
         subscribers, so consumers that leave the tree are not kept alive by
         an app-wide brush (issue #2386). Never write .Color on one; set a
         theme brush in code with SetResourceReference, not FindResource,
         so it follows the next theme switch.
    -->

    <!-- Primary Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorPressed}" po:Freeze="True"/>

    <!-- Sidebar Icon Brushes -->
    <SolidColorBrush x:Key="HomeIconBrush" Color="{StaticResource HomeIconColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="HistoryIconBrush" Color="{StaticResource HistoryIconColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ModesIconBrush" Color="{StaticResource ModesIconColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="VocabularyIconBrush" Color="{StaticResource VocabularyIconColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsIconBrush" Color="{StaticResource SettingsIconColor}" po:Freeze="True"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProcessingBrush" Color="{StaticResource ProcessingColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="PostProcessingBrush" Color="{StaticResource PostProcessingColor}" po:Freeze="True"/>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" po:Freeze="True"/>

    <!-- Semantic Alert Brushes - Warning -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="{StaticResource WarningForeground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorder}" po:Freeze="True"/>

    <!-- Semantic Alert Brushes - Error -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{StaticResource ErrorForeground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorder}" po:Freeze="True"/>

    <!-- Semantic Alert Brushes - Info -->
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoForegroundBrush" Color="{StaticResource InfoForeground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorder}" po:Freeze="True"/>

    <!-- Semantic Alert Brushes - Success -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{StaticResource SuccessForeground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorder}" po:Freeze="True"/>

    <!-- Badge Brushes -->
    <SolidColorBrush x:Key="BadgeGrayBackgroundBrush" Color="{StaticResource BadgeGrayBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BadgeGrayForegroundBrush" Color="{StaticResource BadgeGrayForeground}" po:Freeze="True"/>

    <!-- Progress Bar Brushes -->
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="{StaticResource ProgressBackground}" po:Freeze="True"/>

    <!-- Hover State Brushes -->
    <SolidColorBrush x:Key="DeleteHoverBackgroundBrush" Color="{StaticResource DeleteHoverBackground}" po:Freeze="True"/>

    <!-- Sidebar Icon Brushes - Statistics -->
    <SolidColorBrush x:Key="StatisticsIconBrush" Color="{StaticResource StatisticsIconColor}" po:Freeze="True"/>

    <!-- Statistics Card Accent Brushes -->
    <SolidColorBrush x:Key="StatisticsBlueBrush" Color="{StaticResource StatisticsBlue}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatisticsGreenBrush" Color="{StaticResource StatisticsGreen}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatisticsPurpleBrush" Color="{StaticResource StatisticsPurple}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatisticsOrangeBrush" Color="{StaticResource StatisticsOrange}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatisticsChartBarBrush" Color="{StaticResource StatisticsChartBar}" po:Freeze="True"/>

</ResourceDictionary>

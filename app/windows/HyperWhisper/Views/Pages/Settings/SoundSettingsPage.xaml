<Page x:Class="HyperWhisper.Views.Pages.Settings.SoundSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:HyperWhisper.Localization"
      xmlns:controls="clr-namespace:HyperWhisper.Views.Controls"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidthForm}">
            <TextBlock Text="{loc:Loc settings.sound.title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <!-- Sound Effects Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.sound.enableSoundEffects.title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc settings.sound.enableSoundEffects.subtitle}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <CheckBox x:Name="EnableSoundEffectsCheckbox" Grid.Column="1"
                              VerticalAlignment="Center"
                              Checked="EnableSoundEffectsCheckbox_Checked"
                              Unchecked="EnableSoundEffectsCheckbox_Unchecked"/>
                </Grid>
            </Border>

            <!-- Media Control Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- 200 like the Shortcuts page's ComboBoxes: the longest label (bg
                                 "Приглушаване на звука", 141 px in Segoe UI 13) plus the 42 px of
                                 text margin and chevron the ComboBox template leaves. -->
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.sound.mediaControl.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc settings.sound.mediaControl.subtitle}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="MediaControlModeComboBox" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectionChanged="MediaControlModeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="off" Content="{loc:Loc settings.sound.mediaControl.off}"/>
                            <ComboBoxItem Tag="muteAudio" Content="{loc:Loc settings.sound.mediaControl.muteAudio}"/>
                            <ComboBoxItem Tag="muffleAudio" Content="{loc:Loc settings.sound.mediaControl.muffleAudio}"/>
                        </ComboBox>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Microphone Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Microphone picker. DataContext is a MicrophonePickerViewModel,
                         set by the code-behind; the rows come from MainViewModel's
                         one saved choice, shared with the tray and onboarding. -->
                    <StackPanel x:Name="MicrophonePickerRow" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc menu.microphone}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{loc:Loc settings.sound.microphone.subtitle}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox x:Name="MicrophoneComboBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{loc:Loc menu.microphone}"
                                      ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding HasDevices}"/>
                        </Grid>

                        <!-- Saved device unplugged: one amber line, the choice is kept. -->
                        <TextBlock Text="{Binding FallbackMessage}"
                                   FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFallback}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Level bar + Test. Idle: empty and grey; nothing is open. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:SegmentedLevelBar VerticalAlignment="Center"
                                                        Level="{Binding Level}"
                                                        Active="{Binding IsTesting}"/>

                            <Button Grid.Column="1" Margin="12,0,0,0" MinWidth="72"
                                    Style="{StaticResource MacButtonStyle}"
                                    Content="{Binding TestButtonText}"
                                    Command="{Binding ToggleTestCommand}"
                                    IsEnabled="{Binding CanTest}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Auto-increase Mic Volume -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.sound.autoIncreaseMicVolume.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc settings.sound.autoIncreaseMicVolume.subtitle}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoIncreaseMicVolumeCheckbox" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="AutoIncreaseMicVolumeCheckbox_Checked"
                                  Unchecked="AutoIncreaseMicVolumeCheckbox_Unchecked"/>
                    </Grid>

                    <!-- Keep Microphone Warm -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.sound.keepMicrophoneWarm.title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc settings.sound.keepMicrophoneWarm.subtitle}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="KeepMicrophoneWarmCheckbox" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="KeepMicrophoneWarmCheckbox_Checked"
                                  Unchecked="KeepMicrophoneWarmCheckbox_Unchecked"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

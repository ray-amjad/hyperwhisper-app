<!--
    Step 6 of 8: microphone. Mirrors OnboardingSourceViews.swift:773-875.

    Four renderings, not one. macOS lists devices and effectively never has none;
    Windows genuinely does, and AudioDeviceService distinguishes an empty success
    from a Result failure. Collapsing the two would tell someone with a broken
    audio stack to go and buy a microphone.

      Available          the device list and a live meter
      Blocked            privacy copy plus a link to the privacy page
      NoDevices          "nothing connected" plus a link to Sound settings
      EnumerationFailed  "Windows could not list them", kept visibly distinct

    In the last three the meter draws its explicit inactive state rather than a
    dead flat bar that reads as a broken app. None of the four gates Continue.

    The device list gets its own MaxHeight and its own scrollbar: a developer box
    with a dozen virtual capture devices is the ordinary case, not an edge case.
    BubblesMouseWheel hands the wheel back to the stage at its scroll limits.
-->
<Page x:Class="HyperWhisper.Views.Pages.Onboarding.MicrophoneStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:HyperWhisper.Localization"
      xmlns:onboarding="clr-namespace:HyperWhisper.Views.Controls.Onboarding"
      Title="{loc:Loc onboarding.mic.title}"
      Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyperWhisper;component/Views/Controls/Onboarding/OnboardingResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <onboarding:OnboardingStage>
        <StackPanel Width="{StaticResource OnboardingBodyWidth}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource OnboardingStageMargin}">

            <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE720;"/>
            </Border>

            <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                       Text="{loc:Loc onboarding.mic.title}"/>
            <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                       Text="{loc:Loc onboarding.mic.subtitle}"/>

            <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                <StackPanel>
                    <Border Style="{StaticResource OnboardingCardBlockStyle}">
                        <onboarding:OnboardingLevelMeter Level="{Binding InputLevel}"
                                                         Active="{Binding IsLevelMeterActive}"
                                                         AutomationProperties.Name="{loc:Loc onboarding.a11y.inputLevel}"
                                                         AutomationProperties.HelpText="{Binding InputLevelAccessibleValue}"/>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"/>

                    <!-- System Default is always the first row; the flow model puts it
                         there, so there is no separate toggle to keep in sync. -->
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  onboarding:OnboardingStage.BubblesMouseWheel="True"
                                  Visibility="{Binding HasUsableMicrophone, Converter={StaticResource OnboardingBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding DeviceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Button Style="{StaticResource OnboardingSelectableRowStyle}"
                                                Command="{Binding DataContext.SelectDeviceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource OnboardingRadioMarkStyle}"/>

                                                <!-- The input device name always stays on one line. -->
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource OnboardingRowTitleSingleLineStyle}"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>

                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource OnboardingRowDetailStyle}"
                                                           Text="{Binding Detail}"/>
                                            </Grid>
                                        </Button>
                                        <Border Style="{StaticResource OnboardingDividerStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- The hint line and the remedy. Blocked points at the privacy
                         page; everything else points at Sound settings. -->
                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingNoteTextStyle}"
                                       Text="{Binding MicrophoneHintText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OnboardingButtonStyle}"
                                    Command="{Binding HandleMicrophoneActionCommand}"
                                    Visibility="{Binding ShowsPrivacySettingsAction, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc onboarding.mic.privacySettings}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OnboardingButtonStyle}"
                                    Click="SoundSettings_Click"
                                    Visibility="{Binding ShowsSoundSettingsAction, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc onboarding.mic.soundSettings}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Style="{StaticResource OnboardingQuietNoteStyle}">
                <TextBlock Style="{StaticResource OnboardingNoteGlyphStyle}"/>
                <TextBlock Style="{StaticResource OnboardingNoteTextStyle}" Width="520"
                           Text="{loc:Loc onboarding.mic.note}"/>
            </StackPanel>
        </StackPanel>
    </onboarding:OnboardingStage>
</Page>

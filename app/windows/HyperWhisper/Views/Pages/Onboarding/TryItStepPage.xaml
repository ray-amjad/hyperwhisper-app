<!--
    Step 7 of 8: try it. Mirrors OnboardingView.swift:276-398.

    Two primaries, never both. In Record mode this is macOS's page: keycaps, the
    shortcut hint, and a Record button. In Sample mode there is no microphone at
    all, so the Record button is not disabled, it is absent, and the sample clip
    takes its place. Offering a button whose only outcome is an error toast is
    the failure this fork exists to prevent, and the dev box will be demoed in
    exactly that state.

    The "Try saying" line is Record-only for the same reason: with no microphone
    there is nothing to say.

    The transcript is shown here and pasted nowhere, which the footer row says
    out loud. Its meta line names which of the two paths produced the text, so a
    sample can never read as a live recording.
-->
<Page x:Class="HyperWhisper.Views.Pages.Onboarding.TryItStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:HyperWhisper.Localization"
      xmlns:onboarding="clr-namespace:HyperWhisper.Views.Controls.Onboarding"
      Title="{loc:Loc onboarding.test.title}"
      Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyperWhisper;component/Views/Controls/Onboarding/OnboardingResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The transcript is the payoff of the whole flow, so it gets group
                 header scale. The one trigger turns it red for an error, which is
                 the only thing the view decides for itself and it decides it from
                 a flow model flag. -->
            <Style x:Key="TranscriptBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="24"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TranscriptIsError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <onboarding:OnboardingStage>
        <StackPanel Width="{StaticResource OnboardingBodyWidth}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource OnboardingStageMargin}">

            <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE720;"/>
            </Border>

            <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                       Text="{loc:Loc onboarding.test.title}"/>
            <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                       Text="{loc:Loc onboarding.tryIt.detail}"/>

            <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                <StackPanel>

                    <!-- RECORD MODE: the shortcut and the record control. -->
                    <Border Style="{StaticResource OnboardingCardRowStyle}"
                            Visibility="{Binding IsTryItRecordMode, Converter={StaticResource OnboardingBoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <onboarding:OnboardingKeycaps Grid.Column="0"
                                                          Shortcut="{Binding ShortcutDisplay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource OnboardingNoteTextStyle}"
                                       Text="{loc:Loc onboarding.tryIt.shortcutHint}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource OnboardingPrimaryButtonStyle}"
                                    Content="{loc:Loc onboarding.tryIt.record}"
                                    Command="{Binding ToggleTestRecordingCommand}"
                                    Visibility="{Binding ShowsRecordButton, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource OnboardingButtonStyle}"
                                    Content="{loc:Loc onboarding.test.stop}"
                                    Command="{Binding ToggleTestRecordingCommand}"
                                    Visibility="{Binding ShowsStopButton, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <!-- Stop was pressed and the transcription is running.
                                 Without this the row went straight back to an armed
                                 Record button, which invited a second, overlapping
                                 capture into the same transcript channel. -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource OnboardingNeutralPillStyle}"
                                    Visibility="{Binding ShowsTestRecordingTranscribing, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <TextBlock Style="{StaticResource OnboardingNeutralPillTextStyle}"
                                           Text="{loc:Loc recording.state.transcribing}"/>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource OnboardingGoodPillStyle}"
                                    Visibility="{Binding ShowsRecordedPill, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingCheckGlyphStyle}"
                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                               FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Style="{StaticResource OnboardingGoodPillTextStyle}"
                                               Text="{loc:Loc onboarding.tryIt.recorded}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SAMPLE MODE: no keycaps, because pressing the shortcut with
                         no microphone would do nothing. The hint says why. -->
                    <Border Style="{StaticResource OnboardingCardRowStyle}"
                            Visibility="{Binding IsTryItSampleMode, Converter={StaticResource OnboardingBoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingNoteTextStyle}"
                                       Text="{loc:Loc onboarding.tryIt.sample.hint}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OnboardingPrimaryButtonStyle}"
                                    Content="{loc:Loc onboarding.tryIt.sample.button}"
                                    Command="{Binding TranscribeSampleClipCommand}"
                                    Visibility="{Binding ShowsSampleButton, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <Border Grid.Column="1"
                                    Style="{StaticResource OnboardingNeutralPillStyle}"
                                    Visibility="{Binding IsTranscribingSample, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <TextBlock Style="{StaticResource OnboardingNeutralPillTextStyle}"
                                           Text="{loc:Loc onboarding.tryIt.sample.transcribing}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"/>

                    <!-- The line to read out. Record mode only. -->
                    <Border Style="{StaticResource OnboardingCardBlockStyle}"
                            Visibility="{Binding IsTryItRecordMode, Converter={StaticResource OnboardingBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OnboardingRowDetailStyle}"
                                       Text="{loc:Loc onboarding.tryIt.trySaying}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.tryIt.sampleLine}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"
                            Visibility="{Binding IsTryItRecordMode, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                    <!-- What came back. Three mutually exclusive bodies under one
                         heading, exactly as macOS writes them. -->
                    <Border Style="{StaticResource OnboardingCardBlockStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OnboardingRowDetailStyle}"
                                       Text="{Binding TranscriptHeading}"
                                       HorizontalAlignment="Left"/>

                            <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{loc:Loc onboarding.tryIt.listening}"
                                       Visibility="{Binding IsRecording, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <TextBlock FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Loc onboarding.tryIt.empty}"
                                       Visibility="{Binding ShowsEmptyTranscriptHint, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <!-- A long transcript gets its own scroller rather than
                                 pushing the footer row off the stage. -->
                            <ScrollViewer MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          onboarding:OnboardingStage.BubblesMouseWheel="True"
                                          Visibility="{Binding ShowsTranscriptBody, Converter={StaticResource OnboardingBoolToVisibility}}">
                                <TextBlock Style="{StaticResource TranscriptBodyStyle}"
                                           Text="{Binding TranscriptBody}"/>
                            </ScrollViewer>

                            <TextBlock Style="{StaticResource OnboardingRowCaptionStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="{Binding TranscriptMeta}"
                                       Visibility="{Binding ShowsTranscriptMeta, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <!-- Post-processing was SKIPPED and still returned text.
                                 The GUI toast cannot be seen behind this modal, so
                                 the warning renders here or it reaches nobody. -->
                            <TextBlock Style="{StaticResource OnboardingRowCaptionStyle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding TranscriptWarning}"
                                       Visibility="{Binding ShowsTranscriptWarning, Converter={StaticResource OnboardingBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"
                            Visibility="{Binding ShowsTranscriptFooterRow, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                    <Border Style="{StaticResource OnboardingCardRowStyle}"
                            Visibility="{Binding ShowsTranscriptFooterRow, Converter={StaticResource OnboardingBoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingNoteTextStyle}"
                                       Text="{loc:Loc onboarding.try.transcript.noPaste}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OnboardingButtonStyle}"
                                    Content="{loc:Loc onboarding.tryIt.recordAgain}"
                                    Command="{Binding ToggleTestRecordingCommand}"
                                    Visibility="{Binding ShowsRecordAgain, Converter={StaticResource OnboardingBoolToVisibility}}"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OnboardingButtonStyle}"
                                    Content="{loc:Loc onboarding.tryIt.sample.button}"
                                    Command="{Binding TranscribeSampleClipCommand}"
                                    Visibility="{Binding ShowsSampleAgain, Converter={StaticResource OnboardingBoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Style="{StaticResource OnboardingQuietNoteStyle}">
                <TextBlock Style="{StaticResource OnboardingNoteGlyphStyle}"/>
                <TextBlock Style="{StaticResource OnboardingNoteTextStyle}" Width="520"
                           Text="{loc:Loc onboarding.tryIt.note}"/>
            </StackPanel>
        </StackPanel>
    </onboarding:OnboardingStage>
</Page>

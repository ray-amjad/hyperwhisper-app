<!--
    Step 8 of 8: done. Mirrors OnboardingView.swift:400-435.

    Four summary rows and one accent note. The only honesty requirement here is
    the microphone row: it binds MicrophoneSummary, which reads "None connected"
    when no device exists rather than echoing a device name that is not there.
    The text delivery row binds the auto paste setting, because Windows has no
    Accessibility grant to branch on.

    Nothing on this step is a control. The footer's primary button finishes the
    flow; there is no second way to do it here.
-->
<Page x:Class="HyperWhisper.Views.Pages.Onboarding.DoneStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:HyperWhisper.Localization"
      xmlns:onboarding="clr-namespace:HyperWhisper.Views.Controls.Onboarding"
      Title="{loc:Loc onboarding.completion.title}"
      Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyperWhisper;component/Views/Controls/Onboarding/OnboardingResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <onboarding:OnboardingStage>
        <StackPanel Width="{StaticResource OnboardingBodyWidth}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource OnboardingStageMargin}">

            <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE73E;"/>
            </Border>

            <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                       Text="{loc:Loc onboarding.completion.title}"/>
            <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                       Text="{loc:Loc onboarding.done.detail}"/>

            <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                <StackPanel>

                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.done.summary.transcription}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" MaxWidth="300"
                                       Style="{StaticResource OnboardingRowDetailStyle}"
                                       Text="{Binding SourceSummary}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"/>

                    <!-- MicrophoneSummary, not SelectedDeviceName: with no device
                         this row has to say so rather than name one. -->
                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.done.summary.microphone}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" MaxWidth="300"
                                       Style="{StaticResource OnboardingRowDetailStyle}"
                                       Text="{Binding MicrophoneSummary}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"/>

                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.done.summary.textDelivery}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" MaxWidth="300"
                                       Style="{StaticResource OnboardingRowDetailStyle}"
                                       Text="{Binding TextDeliverySummary}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OnboardingDividerStyle}"/>

                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.done.summary.shortcut}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <onboarding:OnboardingKeycaps Grid.Column="1"
                                                          Shortcut="{Binding ShortcutDisplay}"
                                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OnboardingAccentNoteStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;"
                               FontSize="14" Margin="0,0,8,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource InfoForegroundBrush}"/>
                    <TextBlock Style="{StaticResource OnboardingAccentNoteTextStyle}" Width="480"
                               Text="{loc:Loc onboarding.done.menuBarNote}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </onboarding:OnboardingStage>
</Page>

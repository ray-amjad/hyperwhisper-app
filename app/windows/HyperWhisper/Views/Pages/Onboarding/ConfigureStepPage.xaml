<!--
    Step 4 of 8: configure the chosen source. Mirrors
    OnboardingSourceViews.swift:195-477. Forks four ways.

    macOS switches its scaffold's glyph, question and detail on
    flow.selectedSource. XAML has no switch, so each branch is a whole block
    carrying its own header, its own card and its own note, and the block is shown
    by one bool off the flow model. That keeps every string a parse-time
    {loc:Loc} and keeps the choice of which branch to show in the model.

    The inline test result is cleared on every entry to this step by the flow
    model's ResetConfigureTestResults, so a pass for a previous key can never be
    read as a pass for whatever is in the field now.
-->
<Page x:Class="HyperWhisper.Views.Pages.Onboarding.ConfigureStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:HyperWhisper.Localization"
      xmlns:onboarding="clr-namespace:HyperWhisper.Views.Controls.Onboarding"
      Title="{loc:Loc onboarding.configure.onDevice.title}"
      Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyperWhisper;component/Views/Controls/Onboarding/OnboardingResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <onboarding:OnboardingStage>
        <Grid Width="{StaticResource OnboardingBodyWidth}"
              HorizontalAlignment="Left"
              Margin="{StaticResource OnboardingStageMargin}">

            <!-- ============ HyperWhisper Cloud: access key + read only test ============ -->
            <StackPanel Visibility="{Binding IsCloudSelected, Converter={StaticResource OnboardingBoolToVisibility}}">
                <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                    <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE72E;"/>
                </Border>
                <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                           Text="{loc:Loc onboarding.configure.cloud.title}"/>
                <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                           Text="{loc:Loc onboarding.configure.cloud.subtitle}"/>

                <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource OnboardingCardRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- The Cloud access key stays visible, unlike a BYOK
                                     provider key, so a paste can be checked by eye. -->
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource OnboardingKeyFieldStyle}"
                                         Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0"
                                         AutomationProperties.Name="{loc:Loc onboarding.configure.cloud.placeholder}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource OnboardingButtonStyle}"
                                        Content="{loc:Loc onboarding.configure.cloud.testKey}"
                                        Command="{Binding TestAccessKeyCommand}"
                                        IsEnabled="{Binding CanTestAccessKey}"/>
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding IsTestingKey, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardRowStyle}">
                                <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                           Text="{loc:Loc onboarding.configure.test.testing}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsLicenseTestPassed, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingCheckGlyphStyle}"
                                               FontSize="16" Margin="0,0,12,0"/>
                                    <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                               Text="{loc:Loc onboarding.configure.test.valid}"/>
                                </StackPanel>
                            </Border>

                            <!-- Credits are display only. A pending or failed fetch
                                 renders as an ellipsis and blocks nothing. -->
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource OnboardingBigNumberStyle}"
                                                   Text="{Binding CreditsFormatted}"/>
                                        <TextBlock Style="{StaticResource OnboardingBigNumberCaptionStyle}"
                                                   Text="{loc:Loc onboarding.configure.cloud.creditsCaption}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OnboardingButtonStyle}"
                                            Content="{loc:Loc onboarding.configure.cloud.getCredits}"
                                            Click="GetCredits_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsLicenseTestFailed, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardBlockStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingErrorGlyphStyle}"/>
                                    <TextBlock Style="{StaticResource OnboardingErrorNoteStyle}"
                                               Width="500"
                                               Text="{Binding SetupErrorMessage}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Style="{StaticResource OnboardingQuietNoteStyle}">
                    <TextBlock Style="{StaticResource OnboardingNoteGlyphStyle}"/>
                    <TextBlock Style="{StaticResource OnboardingNoteTextStyle}" Width="520"
                               Text="{loc:Loc onboarding.configure.cloud.note}"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ On this PC: pick a model ============ -->
            <StackPanel Visibility="{Binding IsOnDeviceSelected, Converter={StaticResource OnboardingBoolToVisibility}}">
                <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                    <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE977;"/>
                </Border>
                <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                           Text="{loc:Loc onboarding.configure.onDevice.title}"/>
                <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                           Text="{loc:Loc onboarding.configure.onDevice.subtitle}"/>

                <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                    <ItemsControl ItemsSource="{Binding ModelOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button Style="{StaticResource OnboardingSelectableRowStyle}"
                                            Command="{Binding DataContext.SelectModelCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Model}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource OnboardingRadioMarkStyle}"/>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                                           Text="{Binding DisplayName}"/>
                                                <TextBlock Style="{StaticResource OnboardingRowCaptionStyle}"
                                                           Text="{Binding Subtitle}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource OnboardingGoodPillStyle}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource OnboardingBoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource OnboardingCheckGlyphStyle}"
                                                               FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Style="{StaticResource OnboardingGoodPillTextStyle}"
                                                               Text="{loc:Loc onboarding.model.downloaded}"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource OnboardingMonoDetailStyle}"
                                                       Text="{Binding SizeText}"
                                                       Visibility="{Binding ShowsSize, Converter={StaticResource OnboardingBoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                    <Border Style="{StaticResource OnboardingDividerStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Style="{StaticResource OnboardingQuietNoteStyle}">
                    <TextBlock Style="{StaticResource OnboardingNoteGlyphStyle}"/>
                    <TextBlock Style="{StaticResource OnboardingNoteTextStyle}" Width="520"
                               Text="{loc:Loc onboarding.configure.onDevice.note}"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ Your API key: provider chips + key + test ============ -->
            <StackPanel Visibility="{Binding IsProviderSelected, Converter={StaticResource OnboardingBoolToVisibility}}">
                <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                    <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE72E;"/>
                </Border>
                <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                           Text="{loc:Loc onboarding.configure.provider.title}"/>
                <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                           Text="{loc:Loc onboarding.configure.provider.subtitle}"/>

                <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource OnboardingCardBlockStyle}">
                            <ItemsControl ItemsSource="{Binding ProviderOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Changing the provider clears the entered key
                                             on the flow model, so a stale key can never
                                             be saved under a provider it was not typed
                                             for. -->
                                        <Button Style="{StaticResource OnboardingChipStyle}"
                                                Command="{Binding DataContext.SelectProviderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Provider}"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding AssetPath}" Width="14" Height="14"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource OnboardingChipTextStyle}"
                                                           Text="{Binding DisplayName}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Style="{StaticResource OnboardingDividerStyle}"/>

                        <Border Style="{StaticResource OnboardingCardRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- A BYOK key is masked. PasswordBox has no bindable
                                     Password, so the code-behind on this page carries
                                     it both ways. It has no x:Name because it sits
                                     inside OnboardingStage's name scope; Loaded hands
                                     over the reference instead. -->
                                <PasswordBox Grid.Column="0"
                                             Style="{StaticResource OnboardingKeyPasswordStyle}"
                                             Loaded="ApiKeyBox_Loaded"
                                             PasswordChanged="ApiKeyBox_PasswordChanged"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="{loc:Loc onboarding.configure.provider.keyPlaceholder}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource OnboardingButtonStyle}"
                                        Content="{loc:Loc onboarding.configure.provider.testKey}"
                                        Command="{Binding TestProviderKeyCommand}"
                                        IsEnabled="{Binding CanTestProviderKey}"/>
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding IsTestingKey, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardRowStyle}">
                                <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                           Text="{loc:Loc onboarding.configure.test.testing}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsProviderTestHealthy, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingCheckGlyphStyle}"
                                               FontSize="16" Margin="0,0,12,0"/>
                                    <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                               Text="{loc:Loc onboarding.configure.test.healthy}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsProviderTestUnauthorized, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardBlockStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingErrorGlyphStyle}"/>
                                    <TextBlock Style="{StaticResource OnboardingErrorNoteStyle}" Width="500"
                                               Text="{loc:Loc onboarding.configure.test.unauthorized}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsProviderTestUnreachable, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardBlockStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingErrorGlyphStyle}"/>
                                    <TextBlock Style="{StaticResource OnboardingErrorNoteStyle}" Width="500"
                                               Text="{loc:Loc onboarding.configure.test.unreachable}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowsProviderTestError, Converter={StaticResource OnboardingBoolToVisibility}}">
                            <Border Style="{StaticResource OnboardingDividerStyle}"/>
                            <Border Style="{StaticResource OnboardingCardBlockStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OnboardingErrorGlyphStyle}"/>
                                    <TextBlock Style="{StaticResource OnboardingErrorNoteStyle}" Width="500"
                                               Text="{Binding SetupErrorMessage}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Style="{StaticResource OnboardingQuietNoteStyle}">
                    <TextBlock Style="{StaticResource OnboardingNoteGlyphStyle}" Text="&#xE72E;"/>
                    <TextBlock Style="{StaticResource OnboardingNoteTextStyle}" Width="520"
                               Text="{loc:Loc onboarding.configure.provider.keychainNote}"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ No source chosen ============ -->
            <StackPanel Visibility="{Binding HasNoSourceSelected, Converter={StaticResource OnboardingBoolToVisibility}}">
                <Border Style="{StaticResource OnboardingGlyphTileStyle}">
                    <TextBlock Style="{StaticResource OnboardingGlyphStyle}" Text="&#xE897;"/>
                </Border>
                <TextBlock Style="{StaticResource OnboardingQuestionStyle}"
                           Text="{loc:Loc onboarding.configure.noSource.title}"/>
                <TextBlock Style="{StaticResource OnboardingDetailStyle}"
                           Text="{loc:Loc onboarding.noSource.detail}"/>

                <Border Style="{StaticResource OnboardingCardStyle}" Margin="0,24,0,8">
                    <Border Style="{StaticResource OnboardingCardRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OnboardingRowTitleStyle}"
                                       Text="{loc:Loc onboarding.setup.selectFirst}"/>
                            <TextBlock Style="{StaticResource OnboardingRowCaptionStyle}"
                                       Text="{loc:Loc onboarding.configure.noSource.caption}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </onboarding:OnboardingStage>
</Page>

<Window x:Class="HyperWhisper.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HyperWhisper.ViewModels"
        xmlns:loc="clr-namespace:HyperWhisper.Localization"
        xmlns:controls="clr-namespace:HyperWhisper.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc app.title}" Width="1000" Height="680"
        MinWidth="1000" MinHeight="680" MaxWidth="1000" MaxHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title area. WindowChrome makes this row draggable. -->
        <Border Grid.ColumnSpan="2"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="{loc:Loc window.caption.minimize}"
                            AutomationProperties.Name="{loc:Loc window.caption.minimize}">
                        <Path Width="10" Height="2" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M0,0 H10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Click="MaximizeButton_Click"
                            Visibility="Collapsed"
                            ToolTip="{loc:Loc window.caption.maximize}"
                            AutomationProperties.Name="{loc:Loc window.caption.maximize}">
                        <Path Width="10" Height="10" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M1,1 H9 V9 H1 Z"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="{loc:Loc window.caption.close}"
                            AutomationProperties.Name="{loc:Loc window.caption.close}">
                        <Path Width="10" Height="10" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M1,1 L9,9 M9,1 L1,9"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar. The rail itself lives in Views/Controls/SidebarNav.xaml. -->
        <controls:SidebarNav x:Name="Sidebar" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>

        <!-- Content Frame -->
        <Frame x:Name="ContentFrame" Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" Background="{DynamicResource ContentBackgroundBrush}"/>

        <!-- Status Bar -->
        <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <controls:StatusBarView/>
        </Border>
    </Grid>
</Window>

<!--
    THE "FOCUSED TASK" ONBOARDING DESIGN SYSTEM, WINDOWS EDITION

    The shared parts of the eight step pages. Mirrors the SwiftUI components in
    app/macos/hyperwhisper/Views/Onboarding/OnboardingFocusComponents.swift, but
    expressed the way this app already expresses shared appearance: keyed Styles
    in a ResourceDictionary, not a control per part. Only the five pieces that
    genuinely carry behaviour (the stage, the progress hairline, the level meter,
    the download bar, the keycap strip) are real controls.

    Every value comes off this app's own scale, not a translation of macOS pixels:
    radii from the CardCornerRadius / ButtonCornerRadius / InputCornerRadius
    tokens in Themes/Generic.xaml, spacing on 4 / 8 / 12 / 20 / 24, and typography
    from app/windows/.ui-consistency-sweep.md. Every colour is a DynamicResource
    theme brush, so the whole flow is correct in light and dark and survives a
    runtime theme swap. There is not one hex literal and not one opacity-faded
    brush in this file.

    Merged into each onboarding page's own Page.Resources rather than into
    App.xaml, so the pages construct under the smoke suite's bare
    System.Windows.Application, which merges only the three theme dictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:converters="clr-namespace:HyperWhisper.Converters">

    <converters:BoolToVisibilityConverter x:Key="OnboardingBoolToVisibility"/>
    <converters:InverseBoolConverter x:Key="OnboardingInverseBool"/>

    <!-- The single column every step is written into, and the stage insets.
         760 window minus a 40 leading inset leaves room for the scrollbar. -->
    <sys:Double x:Key="OnboardingBodyWidth">560</sys:Double>
    <Thickness x:Key="OnboardingStageMargin">40,24,40,32</Thickness>

    <!-- =====================================================================
         STEP SCAFFOLD: the anchor glyph, the question, the one supporting line
         ===================================================================== -->

    <!-- 36 pt accent tinted tile. SelectedBackgroundBrush is this app's
         accent-tinted surface, which is what macOS spells accent-at-0.12. -->
    <Style x:Key="OnboardingGlyphTileStyle" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="OnboardingGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingQuestionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="OnboardingDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- =====================================================================
         CARDS
         ===================================================================== -->

    <!-- The card itself carries no padding: its rows and blocks do, so a divider
         can run edge to edge exactly as it does on macOS. -->
    <Style x:Key="OnboardingCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="OnboardingCardRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="OnboardingCardBlockStyle" TargetType="Border">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="OnboardingDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- =====================================================================
         ROW TEXT: the two type sizes every card row uses
         ===================================================================== -->

    <Style x:Key="OnboardingRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="OnboardingRowTitleSingleLineStyle" TargetType="TextBlock"
           BasedOn="{StaticResource OnboardingRowTitleStyle}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="OnboardingRowCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- The trailing label on a row: quietest text on screen, never wraps. -->
    <Style x:Key="OnboardingRowDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingMonoDetailStyle" TargetType="TextBlock"
           BasedOn="{StaticResource OnboardingRowDetailStyle}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- The numbered circle on the welcome step's three tasks. -->
    <Style x:Key="OnboardingStepNumberStyle" TargetType="Border">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="OnboardingStepNumberTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The leading glyph on a card row. -->
    <Style x:Key="OnboardingRowGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- =====================================================================
         STATUS PILLS
         ===================================================================== -->

    <Style x:Key="OnboardingGoodPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingGoodPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingAccentPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingAccentPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingNeutralPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeGrayBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OnboardingNeutralPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource BadgeGrayForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The success tick that ends a check line or marks a selected card. -->
    <Style x:Key="OnboardingCheckGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Text" Value="&#xE73E;"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The not-yet counterpart. Deliberately a distinct glyph rather than a
         faded tick, so an undone step never reads as a done one. -->
    <Style x:Key="OnboardingPendingGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Text" Value="&#xECCA;"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- =====================================================================
         NOTES
         ===================================================================== -->

    <!-- A quiet footnote. Deliberately not a box, so it never reads as another
         thing to click next to the card above it. -->
    <Style x:Key="OnboardingNoteGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Text" Value="&#xE946;"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="OnboardingNoteTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="OnboardingQuietNoteStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="OnboardingAccentNoteStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="OnboardingAccentNoteTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource InfoForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Inline failure copy. Caption scale, so a card never reflows when an
         error appears. It always wraps: a setup error is a whole sentence from
         a manager and clipping it strands the user at the mandatory gate. -->
    <Style x:Key="OnboardingErrorNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="OnboardingErrorGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Text" Value="&#xE7BA;"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="OnboardingWarningBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="OnboardingWarningTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- =====================================================================
         FIELDS
         The implicit TextBox / PasswordBox styles in Generic.xaml already give
         the surface, border, radius and focus ring. Only the monospaced face is
         added, so a pasted key can be checked character by character.
         ===================================================================== -->

    <Style x:Key="OnboardingKeyFieldStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="OnboardingKeyPasswordStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- =====================================================================
         SETUP READOUTS
         ===================================================================== -->

    <Style x:Key="OnboardingBigNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="OnboardingBigNumberCompactStyle" TargetType="TextBlock"
           BasedOn="{StaticResource OnboardingBigNumberStyle}">
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <Style x:Key="OnboardingBigNumberCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- =====================================================================
         SELECTABLE ROWS
         Every list in this flow (sources, models, providers, devices) binds the
         same `IsSelected` on its row record, so one trigger shape covers all
         four. The trigger lives in ControlTemplate.Triggers, which is the only
         place a DataTrigger can reach a named template part.
         ===================================================================== -->

    <!-- A whole card that is itself the tap target: the source picker's three
         doors. Accent fill plus accent stroke when chosen. -->
    <Style x:Key="OnboardingSelectableCardStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource SelectedBackgroundBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row INSIDE a card: no border of its own, because the card already has
         one and the dividers do the separating. -->
    <Style x:Key="OnboardingSelectableRowStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="Transparent" Padding="12">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource SelectedBackgroundBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The radio mark that leads a model or device row. -->
    <Style x:Key="OnboardingRadioMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The provider chip on the Configure step. Wraps onto as many rows as it
         needs inside a WrapPanel, at the same 8 gap macOS uses. -->
    <Style x:Key="OnboardingChipStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Padding="10,5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{DynamicResource SelectedBackgroundBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OnboardingChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>

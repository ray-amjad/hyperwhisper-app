<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Local API checks build a `DefaultHttpContext` to drive the origin
         guard (issue #289). The app head already carries this reference and it
         flows transitively, but stating it here keeps the smoke suite building
         if the head's own reference ever moves. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperWhisper\HyperWhisper.csproj" />
    <ProjectReference Include="..\..\shared-dotnet\HyperWhisper.Application\HyperWhisper.Application.csproj" />
    <!-- The vectors are the cross-platform contract, not a fixture of this
         project: the Linux backup harness runs the same file. -->
    <Content Include="../../../shared-conformance/backup-vectors.json"
             Link="backup-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The LIVE Windows appcast, not a fixture: the AppcastService checks
         replay the very feed the shipped app fetches and pin the 15 releases it
         renders, so #353's move of the selection rules into the shared core is
         proven against real input rather than a hand-written sample. -->
    <Content Include="../../../nextjs/public/appcast-windows.xml"
             Link="appcast-windows.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

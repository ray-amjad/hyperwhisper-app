<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>HyperWhisper.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperWhisper.Application.Tests" />
    <ProjectReference Include="..\HyperWhisper.Platform.Abstractions\HyperWhisper.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\HyperWhisper.AudioNormalization\HyperWhisper.AudioNormalization.csproj" />
    <ProjectReference Include="..\HyperWhisper.CloudAccount\HyperWhisper.CloudAccount.csproj" />
    <ProjectReference Include="..\HyperWhisper.FileTranscription\HyperWhisper.FileTranscription.csproj" />
    <ProjectReference Include="..\HyperWhisper.Diagnostics\HyperWhisper.Diagnostics.csproj" />
    <ProjectReference Include="..\HyperWhisper.ModelManagement\HyperWhisper.ModelManagement.csproj" />
    <ProjectReference Include="..\HyperWhisper.ModelReadiness\HyperWhisper.ModelReadiness.csproj" />
    <ProjectReference Include="..\HyperWhisper.SharedCore\HyperWhisper.SharedCore.csproj" />
    <ProjectReference Include="..\HyperWhisper.SpeechOutput\HyperWhisper.SpeechOutput.csproj" />
    <ProjectReference Include="..\HyperWhisper.Storage\HyperWhisper.Storage.csproj" />
    <ProjectReference Include="..\HyperWhisper.Statistics\HyperWhisper.Statistics.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
  </ItemGroup>

  <!-- The two shared catalogs used to be embedded here for PortableModeDefaults'
       hand-rolled JsonDocument parse. That parse is gone (#285) — the seed's
       catalog lookups happen once, in hw-catalog — and no other type in this
       assembly reads a manifest resource, so the embeds went with it. The heads
       that still decode a catalog embed their own copy under their own logical
       name (HyperWhisper.csproj, HyperWhisper.CloudPostProcessing.csproj). -->

  <!-- These remain at stable source paths during the extraction, but this is
       their sole compiling project. Windows consumes the authoritative types
       through ProjectReference instead of compiling duplicates. -->
  <ItemGroup>
    <Compile Include="..\..\windows\HyperWhisper\Data\HyperWhisperDbContext.cs" Link="Persistence\HyperWhisperDbContext.cs" />
    <Compile Include="..\..\windows\HyperWhisper\Data\Entities\*.cs" Link="Persistence\Entities\%(Filename)%(Extension)" />
    <Compile Include="..\..\windows\HyperWhisper\Migrations\*.cs" Link="Persistence\Migrations\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

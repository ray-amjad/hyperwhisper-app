<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- THE one compiling copy of the generated C# UniFFI binding, for every
       .NET platform head. Windows used to compile a second, vendored copy
       (app/windows/HyperWhisper/Generated/RustCore/) into its own assembly:
       both landed in `namespace uniffi.hyperwhisper_core`, same-assembly
       resolution silently picked the local one, and each assembly kept its own
       UniFFI callback-vtable handle map — so a handle lowered through one map
       could be dispatched against the other (issue #275). Platform heads now
       reference this project instead. tools/check-binding-drift.sh fails the
       build if a vendored .cs copy comes back. -->
  <ItemGroup>
    <Compile Include="../../../shared-core-rs/bindings/csharp/hyperwhisper_core.cs"
             Link="Generated/hyperwhisper_core.cs" />
  </ItemGroup>

  <!-- uniffi-bindgen-cs emits its types as `internal`, so consumers that touch
       the raw binding (rather than only the Portable* surface in
       SharedCoreBridge) need explicit access. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HyperWhisper" />
    <InternalsVisibleTo Include="HyperWhisper.SmokeTests" />
    <!-- Reads the catalog records straight off the binding (issue #280): the
         unified capability list needs whole rows, not the scalar Portable*
         helpers, and copying them into a parallel DTO would be the fifth
         catalog decoder this change exists to delete. -->
    <InternalsVisibleTo Include="HyperWhisper.ModelReadiness" />
    <!-- Runs shared-conformance/catalog-vectors.json against the binding. -->
    <InternalsVisibleTo Include="HyperWhisper.CatalogConformance.Tests" />
    <!-- Runs shared-conformance/backup-vectors.json's macosSettings rows against
         the binding (issue #277, phase 2a). The macOS settings adapter already
         lives in hw-backup, so the only way to capture it from a head that runs
         in CI on Linux is to call the exported functions directly; there is no
         SharedCoreBridge wrapper for them and adding one is not a capture. -->
    <InternalsVisibleTo Include="HyperWhisper.Backup.Application.Tests" />
    <!-- The app-type classifier for every .NET head (issue #279). It maps the
         binding's `AppClassifyRequest` / `AppClassification` records onto the
         platform's own `AppType`, and those records are `internal`. -->
    <InternalsVisibleTo Include="HyperWhisper.AppClassification" />
    <!-- Runs shared-conformance/app-type-vectors.json against the binding. -->
    <InternalsVisibleTo Include="HyperWhisper.AppTypeConformance.Tests" />
    <!-- The Local API's origin guard, bearer check, token encoder and failure
         envelope all come from the binding now (issue #289). The decision and
         failure records are `internal`, and the portable server is where the
         Linux head serves them from. -->
    <InternalsVisibleTo Include="HyperWhisper.LocalApi" />
    <!-- Asserts the head's error-code constants against
         `LocalApiAllErrorCodes()` — the closed set has to be read off the
         binding for the check to mean anything. -->
    <InternalsVisibleTo Include="HyperWhisper.LocalApi.Tests" />
    <!-- The live-streaming protocol adapter is internal (issue #281), and it is
         the head's whole proof that the Rust `HwLiveSession` object is right:
         the connect descriptor, the framing rule, every parser and every ordered
         stop sequence are asserted against it directly rather than inferred from
         a socket transcript. -->
    <InternalsVisibleTo Include="HyperWhisper.SharedCore.Tests" />
    <!-- The parakeet daemon's bounded word-agreement engine is the core's
         `HwBoundedAgreementSession` now (issue #286), and that object and its
         `HwStreamUpdate` / `HwStreamException` are `internal`. The adapter that
         wraps them stays inside the daemon rather than becoming a public
         Portable* wrapper here, because this project is inside the .NET
         coverage gate and tools/parakeet-engine-dotnet is not. This entry is
         the daemon's `AssemblyName`, not its project name
         (parakeet-engine-dotnet). -->
    <InternalsVisibleTo Include="parakeet-engine" />
  </ItemGroup>
</Project>

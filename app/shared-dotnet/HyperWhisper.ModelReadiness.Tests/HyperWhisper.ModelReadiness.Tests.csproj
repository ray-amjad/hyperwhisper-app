<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HyperWhisper.ModelReadiness/HyperWhisper.ModelReadiness.csproj" />
    <!-- Test fixtures, not production data: the assertions derive their expected
         counts from the catalog JSON so they are independent of the code under
         test. Production reads the same files through the Rust core, which
         include_str!'s them at compile time. -->
    <Content Include="../../../shared-models/models-catalog.json" Link="Catalogs/models-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../shared-app-classification/cloud-stt-catalog.json" Link="Catalogs/cloud-stt-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../shared-app-classification/cloud-pp-catalog.json" Link="Catalogs/cloud-pp-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so"
             Condition="Exists('../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so')">
      <Link>libhyperwhisper_core.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnsureSharedCoreNativeLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so')"
           Text="Build shared-core-rs in release mode before running the model-readiness tests — the unified catalog now reads the shared catalogs through the Rust core." />
  </Target>
</Project>

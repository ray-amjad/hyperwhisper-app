<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HyperWhisper.TranscriptionRouting/HyperWhisper.TranscriptionRouting.csproj" />
    <!-- The vectors are the cross-platform contract, not a fixture of this
         project: Rust, Windows and macOS run the same file. -->
    <Content Include="../../../shared-conformance/default-model-vectors.json"
             Link="default-model-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so"
             Condition="Exists('../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so')">
      <Link>libhyperwhisper_core.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="EnsureSharedCoreNativeLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('../../../shared-core-rs/target/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so')"
           Text="Build shared-core-rs in release mode before running routing tests." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyperWhisper.SpeechOutput\HyperWhisper.SpeechOutput.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\HyperWhisper.Platform.Abstractions\HyperWhisper.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\HyperWhisper.Application\HyperWhisper.Application.csproj" />
    <!-- SharedCoreBridge.NormalizeVocabularyTerms; a transitive reference would
         resolve, but this project now depends on the bridge directly. -->
    <ProjectReference Include="..\HyperWhisper.SharedCore\HyperWhisper.SharedCore.csproj" />
    <!-- ModeAwareTranscriptionRouter.DispatchedCloudModelId: the `model` a
         /transcribe response reports has to be the model the send path really
         dispatches, so it is read from the send path itself (issue #533). -->
    <ProjectReference Include="..\HyperWhisper.TranscriptionRouting\HyperWhisper.TranscriptionRouting.csproj" />
  </ItemGroup>
</Project>

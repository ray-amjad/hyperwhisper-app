<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- This harness runs on two CI hosts (Linux CI's shared-dotnet sweep and
       Windows CI), so the native library it loads has a different name and a
       different cargo target directory on each. Resolve both here rather than
       hard-coding the Linux triple the way the older harnesses do. -->
  <PropertyGroup>
    <SharedCoreRoot>$(MSBuildThisFileDirectory)../../../shared-core-rs/target</SharedCoreRoot>
    <SharedCoreNativeLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(SharedCoreRoot)/x86_64-pc-windows-msvc/release/hyperwhisper_core.dll</SharedCoreNativeLibrary>
    <SharedCoreNativeLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(SharedCoreRoot)/release/libhyperwhisper_core.dylib</SharedCoreNativeLibrary>
    <SharedCoreNativeLibrary Condition="'$(SharedCoreNativeLibrary)' == ''">$(SharedCoreRoot)/x86_64-unknown-linux-gnu/release/libhyperwhisper_core.so</SharedCoreNativeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HyperWhisper.SharedCore/HyperWhisper.SharedCore.csproj" />
    <!-- The vectors run against BOTH the raw binding and the platform facade,
         so a mapping bug in either one fails here. -->
    <ProjectReference Include="../HyperWhisper.AppClassification/HyperWhisper.AppClassification.csproj" />
    <!-- The vectors are the cross-platform contract, not a fixture of this
         project: Rust and Swift run the same file. -->
    <Content Include="../../../shared-conformance/app-type-vectors.json"
             Link="app-type-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SharedCoreNativeLibrary)" Condition="Exists('$(SharedCoreNativeLibrary)')">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnsureSharedCoreNativeLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('$(SharedCoreNativeLibrary)')"
           Text="Build shared-core-rs in release mode before running the app-type conformance vectors — expected $(SharedCoreNativeLibrary)." />
  </Target>
</Project>

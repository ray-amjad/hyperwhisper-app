<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HyperWhisper.ModelManagement/HyperWhisper.ModelManagement.csproj" />
    <!-- The three shared catalogs used to be copied next to this assembly and
         parsed here with JsonDocument — a fourth decoder for
         cloud-stt-catalog.json. They are now include_str!'d into the Rust core
         and read through the binding (issue #280), so this project ships no
         catalog files: only the reference that reaches them. The test harness
         still copies the JSON, because it derives its expectations from the
         source data rather than from the code under test. -->
    <ProjectReference Include="../HyperWhisper.SharedCore/HyperWhisper.SharedCore.csproj" />
  </ItemGroup>
</Project>

<Window xmlns="https://github.com/avaloniaui"
        TextOptions.TextRenderingMode="Antialias"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:HyperWhisper.Linux.Overlay"
        x:Class="HyperWhisper.Linux.Overlay.LinuxRecordingOverlayWindow"
        x:DataType="overlay:LinuxRecordingOverlayViewModel"
        Width="264" Height="40"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        FlowDirection="{ReflectionBinding FlowDirection, Source={StaticResource Localization}}">
  <!-- The pill follows macOS's RecordingDialog: 40 px tall and fully rounded, black at 0.85 with a 1 px
       white 0.1 stroke. The batch face is the stop button, the mode badge, the waveform and the timer;
       the streaming face is the connection dot, the connection status badge, the waveform and the timer. -->
  <Border CornerRadius="20"
          Background="#D9000000"
          BorderBrush="#1AFFFFFF"
          BorderThickness="1"
          Padding="8,0">
    <Grid>
      <Grid IsVisible="{Binding IsRecording}" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5">
        <Border x:Name="StopTarget" Width="24" Height="24" CornerRadius="12" Background="#E6FF3B30"
                VerticalAlignment="Center">
          <Border Width="8" Height="8" CornerRadius="1.5" Background="White"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="8" Padding="6,3"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ModeText}" Foreground="#E6FFFFFF" FontSize="9" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis" MaxWidth="64" />
        </Border>
        <overlay:LinuxOverlayWaveform Grid.Column="2" Level="{Binding AudioLevel}" Height="24"
                                      ClipToBounds="True" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#99FFFFFF"
                   FontSize="10" FontFamily="monospace" VerticalAlignment="Center" />
      </Grid>

      <Grid IsVisible="{Binding IsStreaming}" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
        <Border Width="12" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StreamingIndicatorBrush}"
                  HorizontalAlignment="Center" />
        </Border>
        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="8" Padding="6,2"
                VerticalAlignment="Center">
          <!-- The connection captions run to "Live transcription connection lost", so the badge wraps to two lines. -->
          <TextBlock Text="{Binding StatusText}" Foreground="#E6FFFFFF" FontSize="9" FontWeight="Medium"
                     LineHeight="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" MaxWidth="80" />
        </Border>
        <overlay:LinuxOverlayWaveform Grid.Column="2" Level="{Binding AudioLevel}" Height="24"
                                      ClipToBounds="True" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#99FFFFFF"
                   FontSize="10" FontFamily="monospace" VerticalAlignment="Center" />
      </Grid>

      <StackPanel IsVisible="{Binding IsTranscribing}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <overlay:LinuxOverlaySpinner Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" Foreground="#E6FFFFFF"
                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel IsVisible="{Binding IsError}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
        <Border Width="18" Height="18" CornerRadius="9" Background="#FFFF9500">
          <TextBlock Text="!" Foreground="Black" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF"
                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   MaxWidth="205" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel IsVisible="{Binding IsModeChanged}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="✨" FontSize="13" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{ReflectionBinding [statusbar.mode], Source={StaticResource Localization}}" Foreground="#A6FFFFFF" FontSize="12" />
          <TextBlock Text="{Binding ModeText}" Foreground="#F2FFFFFF" FontSize="12"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsCancelled}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="×" Foreground="#FFFF6961" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel IsVisible="{Binding IsPasted}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <Border Width="18" Height="18" CornerRadius="9" Background="#FF34C759">
          <TextBlock Text="{ReflectionBinding [linux.overlay.success_glyph], Source={StaticResource Localization}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold"/>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsCopied}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{ReflectionBinding [linux.overlay.copy_glyph], Source={StaticResource Localization}}" Foreground="#FF5AC8FA" FontSize="18"/>
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold"/>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsSecureField}" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{ReflectionBinding [linux.overlay.secure_glyph], Source={StaticResource Localization}}" FontSize="14"/>
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF" FontSize="11" FontWeight="SemiBold"/>
      </StackPanel>

      <Grid IsVisible="{Binding IsCancelConfirmation}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
        <TextBlock Text="{Binding StatusText}" Foreground="#F2FFFFFF" FontSize="11"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border x:Name="DismissCancelTarget" Grid.Column="1" Background="#33FFFFFF" CornerRadius="11" Padding="9,5"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Text="{ReflectionBinding [linux.overlay.escape_hint], Source={StaticResource Localization}}" Foreground="#B3FFFFFF" FontSize="9"/>
            <TextBlock Text="{ReflectionBinding [common.no], Source={StaticResource Localization}}" Foreground="White" FontSize="9"/>
          </StackPanel>
        </Border>
        <Border x:Name="ConfirmCancelTarget" Grid.Column="2" Background="#E6FF3B30" CornerRadius="11" Padding="9,5"
                VerticalAlignment="Center">
          <TextBlock Text="{ReflectionBinding [common.yes], Source={StaticResource Localization}}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>

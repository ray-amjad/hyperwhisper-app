<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HyperWhisper.PortableApplication.ViewModels" xmlns:local="using:HyperWhisper.Linux" xmlns:data="using:HyperWhisper.Data.Entities" xmlns:platform="using:HyperWhisper.Platform.Abstractions" xmlns:conv="using:Avalonia.Data.Converters" x:Class="HyperWhisper.Linux.MainWindow" x:DataType="vm:ApplicationShellViewModel"
        Title="{ReflectionBinding [app.title], Source={StaticResource Localization}}" FlowDirection="{ReflectionBinding FlowDirection, Source={StaticResource Localization}}"
        FontFamily="{StaticResource HwUiFont}"
        TextOptions.TextRenderingMode="Antialias"
        Width="1000" Height="680" MinWidth="1000" MinHeight="680" MaxWidth="1000" MaxHeight="680"
        CanResize="False" WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource HwContentBackgroundBrush}" Foreground="{DynamicResource HwTextPrimaryBrush}">
  <Window.Resources>
    <!-- One template per sidebar row. Content stays the localized string, so the row still
         reads as text to a screen reader and to the startup self-check; the template only
         adds the coloured tile the Windows sidebar draws.

         The glyph box is 14, not 17. Windows puts a Path of Width/Height 14 inside a 17x17
         ContentPresenter (Generic.xaml:66-68, MainWindow.xaml:109-179); this read the presenter
         box off the template and sized the Path itself to 17, which drew every glyph 17/14 too
         wide: Modes, Vocabulary, Model Library and History measured 16/17/15/16 against
         Windows' 13/14/12/13. The geometries were already byte-identical; only the box was wrong. -->
    <DataTemplate x:Key="NavHome"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileHomeBrush}"><Path Data="{StaticResource HwIconHome}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavModes"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileModesBrush}"><Path Data="{StaticResource HwIconModes}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavVocabulary"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileVocabularyBrush}"><Path Data="{StaticResource HwIconVocabulary}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavModels"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileModelsBrush}"><Path Data="{StaticResource HwIconModels}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavStreaming"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileStreamingBrush}"><Path Data="{StaticResource HwIconStreaming}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavHistory"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileHistoryBrush}"><Path Data="{StaticResource HwIconHistory}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
    <DataTemplate x:Key="NavSettings"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Width="30" Height="30" CornerRadius="8" BoxShadow="1 1 8 0 #18000000" Background="{StaticResource HwTileSettingsBrush}"><Path Data="{StaticResource HwIconGear}" Fill="White" Stretch="Uniform" Width="14" Height="14"/></Border><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="0,0,0,1"/></Grid></DataTemplate>
  </Window.Resources>
  <Window.DataTemplates>
    <!-- HOME
         The Windows page in the same order: the two warning banners, the stats bar, Getting
         started, then Recent Updates. Every section carries its own 16px bottom margin, and the
         column is capped at 720 and centred, exactly as ContentMaxWidthWide does on Windows. -->
    <DataTemplate DataType="vm:HomeViewModel">
      <ScrollViewer x:Name="HomeScreen" Classes="page">
      <StackPanel MaxWidth="720">
        <!-- Shown when a global shortcut failed to register, which on Linux usually means
             another application or the desktop portal already holds the combination. -->
        <Border Classes="warningBanner" IsVisible="{Binding HasShortcutConflicts}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top"
                    Background="{DynamicResource HwWarningBorderBrush}">
              <TextBlock Text="!" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{ReflectionBinding [linux.home.conflict.title], Source={StaticResource Localization}}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"
                         Foreground="{DynamicResource HwWarningForegroundBrush}"/>
              <TextBlock Text="{Binding ShortcutConflictMessage}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource HwWarningForegroundBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{ReflectionBinding [linux.streaming.conflict.openSettings], Source={StaticResource Localization}}"
                        HorizontalAlignment="Left" Padding="12,5" Click="OnGoToShortcuts"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="warningBanner" IsVisible="{Binding HasLowMicVolume}">
          <StackPanel>
            <TextBlock Text="{ReflectionBinding [home.microphone.low.title], Source={StaticResource Localization}}"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            <TextBlock Text="{Binding LowMicVolumeMessage}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="{ReflectionBinding [home.microphone.low.openSoundSettings], Source={StaticResource Localization}}"
                      HorizontalAlignment="Left" Padding="12,4" Click="OnGoToSound"/>
              <Button Content="{ReflectionBinding [home.microphone.low.dismiss], Source={StaticResource Localization}}"
                      HorizontalAlignment="Left" Padding="12,4" Margin="8,0,0,0" Click="OnDismissLowMicVolume"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Stat strip. Windows lays four fixed 132px blocks with a 1px rule between them,
             not an equal-column grid: the rules are what make it read as one instrument. -->
        <Border Classes="card" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="132" Margin="0,0,0,10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="0">
                <TextBlock Text="{Binding AllTime.AverageWordsPerMinute}" Classes="statValue"/>
                <TextBlock Text="{ReflectionBinding [linux.home.stats.wpm], Source={StaticResource Localization}}" Classes="statValue"/>
              </StackPanel>
              <TextBlock Text="{ReflectionBinding [home.stats.averageSpeed], Source={StaticResource Localization}}" Classes="statCaption"/>
            </StackPanel>

            <Border Width="1" Height="32" Margin="8,0,8,10" VerticalAlignment="Center" Background="{DynamicResource HwBorderBrush}"/>

            <StackPanel Width="132" Margin="0,0,0,10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ThisWeek.WordCount}" Classes="statValue"/>
              <TextBlock Text="{ReflectionBinding [home.stats.wordsThisWeek], Source={StaticResource Localization}}" Classes="statCaption"/>
            </StackPanel>

            <Border Width="1" Height="32" Margin="8,0,8,10" VerticalAlignment="Center" Background="{DynamicResource HwBorderBrush}"/>

            <StackPanel Width="132" Margin="0,0,0,10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ThisMonth.WordCount}" Classes="statValue"/>
              <TextBlock Text="{ReflectionBinding [home.stats.wordsThisMonth], Source={StaticResource Localization}}" Classes="statCaption"/>
            </StackPanel>

            <Border Width="1" Height="32" Margin="8,0,8,10" VerticalAlignment="Center" Background="{DynamicResource HwBorderBrush}"/>

            <!-- The typing speed the saving is calculated from lives behind this gear, as it
                 does on Windows, rather than as a combo box row under the page. -->
            <StackPanel Width="132" Margin="0,0,0,10" VerticalAlignment="Center">
              <TextBlock Text="{Binding SavedThisWeekMinutes, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=home.stats.minutesValue}"
                         Classes="statValue compact"/>
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Text="{ReflectionBinding [home.stats.savedThisWeek], Source={StaticResource Localization}}"
                           FontSize="11" Foreground="{DynamicResource HwTextSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="HomeTypingSpeed" Grid.Column="1" Classes="statGear" Click="OnTypingSpeedMenu"
                        ToolTip.Tip="{ReflectionBinding [home.stats.typingSpeedHelp], Source={StaticResource Localization}}">
                  <Path Data="{StaticResource HwIconGear}" Fill="{DynamicResource HwTextSecondaryBrush}"
                        Stretch="Uniform" Width="10" Height="10"/>
                </Button>
              </Grid>
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- Windows hides the whole section once every card is ticked, and brings it back the
             moment one is un-ticked. It is a checklist, not a permanent menu. -->
        <StackPanel Margin="0,0,0,16" IsVisible="{Binding ShowGettingStarted}">
          <TextBlock Text="{ReflectionBinding [home.gettingStarted.title], Source={StaticResource Localization}}" Classes="sectionTitle" Margin="0,0,0,16"/>
          <!-- Windows draws the icon as a 44px circle filled with the row colour at 10%. The
               glyph inside it is NOT that colour: these rows are emoji in a TextBlock, and WPF
               paints Segoe UI Emoji's monochrome outlines pure black over the tint. Sampling
               the reference shot gives 000000 as the darkest pixel in all four circles. The
               row colour therefore appears only in the disc, and the glyph is HwStepGlyphBrush.

               The Margin on each Path is the emoji baseline, not padding. All four glyph boxes
               bottom out at y=33 in the 44px circle, so their centres sit 1-4px BELOW the
               circle's, which a plain VerticalAlignment="Center" would not reproduce. -->
          <Button x:Name="HomeStartRecordingButton" Classes="stepRow" Click="OnStartRecording">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource HwStepBlueTintBrush}">
                <Path Data="{StaticResource HwIconMicHandheld}" Fill="{StaticResource HwStepGlyphBrush}" Stretch="Uniform" Width="20" Height="20" Margin="0,3,0,0"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [home.gettingStarted.recording.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
                  <Border Classes="allDonePill" IsVisible="{Binding IsRecordingStepComplete}">
                    <TextBlock Text="{ReflectionBinding [home.gettingStarted.completed], Source={StaticResource Localization}}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{ReflectionBinding [home.gettingStarted.recording.description], Source={StaticResource Localization}}" Classes="stepDescription"/>
              </StackPanel>
              <Border Grid.Column="2" Classes="shortcutChip"><TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Settings.ToggleShortcutDisplay}"/></Border>
              <Panel Grid.Column="3" VerticalAlignment="Center">
                <Border Classes="stepDoneCircle" IsVisible="{Binding IsRecordingStepComplete}">
                  <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="›" Classes="stepChevron" IsVisible="{Binding !IsRecordingStepComplete}"/>
              </Panel>
            </Grid>
          </Button>
          <Button Classes="stepRow" Click="OnGettingStartedShortcuts">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource HwStepPurpleTintBrush}">
                <Path Data="{StaticResource HwIconKeyboardDetailed}" Fill="{StaticResource HwStepGlyphBrush}" Stretch="Uniform" Width="20" Height="20" Margin="0,8,0,0"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [home.gettingStarted.shortcuts.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
                  <Border Classes="allDonePill" IsVisible="{Binding IsShortcutsStepComplete}">
                    <TextBlock Text="{ReflectionBinding [home.gettingStarted.completed], Source={StaticResource Localization}}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{ReflectionBinding [home.gettingStarted.shortcuts.description], Source={StaticResource Localization}}" Classes="stepDescription"/>
              </StackPanel>
              <Panel Grid.Column="3" VerticalAlignment="Center">
                <Border Classes="stepDoneCircle" IsVisible="{Binding IsShortcutsStepComplete}">
                  <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="›" Classes="stepChevron" IsVisible="{Binding !IsShortcutsStepComplete}"/>
              </Panel>
            </Grid>
          </Button>
          <Button Classes="stepRow" Click="OnGettingStartedModes">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource HwStepGreenTintBrush}">
                <Path Data="{StaticResource HwIconTarget}" Fill="{StaticResource HwStepGlyphBrush}" Stretch="Uniform" Width="20" Height="20" Margin="0,2,0,0"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [home.gettingStarted.mode.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
                  <Border Classes="allDonePill" IsVisible="{Binding IsModeStepComplete}">
                    <TextBlock Text="{ReflectionBinding [home.gettingStarted.completed], Source={StaticResource Localization}}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{ReflectionBinding [home.gettingStarted.mode.description], Source={StaticResource Localization}}" Classes="stepDescription"/>
              </StackPanel>
              <Border Grid.Column="2" Classes="shortcutChip"><TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Settings.ChangeModeShortcutDisplay}"/></Border>
              <Panel Grid.Column="3" VerticalAlignment="Center">
                <Border Classes="stepDoneCircle" IsVisible="{Binding IsModeStepComplete}">
                  <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="›" Classes="stepChevron" IsVisible="{Binding !IsModeStepComplete}"/>
              </Panel>
            </Grid>
          </Button>
          <Button Classes="stepRow" Click="OnGettingStartedVocabulary">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource HwStepOrangeTintBrush}">
                <Path Data="{StaticResource HwIconStackedPages}" Fill="{StaticResource HwStepGlyphBrush}" Stretch="Uniform" Width="20" Height="20" Margin="0,4,0,0"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [home.gettingStarted.vocabulary.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
                  <Border Classes="allDonePill" IsVisible="{Binding IsVocabularyStepComplete}">
                    <TextBlock Text="{ReflectionBinding [home.gettingStarted.completed], Source={StaticResource Localization}}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{ReflectionBinding [home.gettingStarted.vocabulary.description], Source={StaticResource Localization}}" Classes="stepDescription"/>
              </StackPanel>
              <Panel Grid.Column="3" VerticalAlignment="Center">
                <Border Classes="stepDoneCircle" IsVisible="{Binding IsVocabularyStepComplete}">
                  <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="›" Classes="stepChevron" IsVisible="{Binding !IsVocabularyStepComplete}"/>
              </Panel>
            </Grid>
          </Button>
        </StackPanel>

        <!-- RECENT UPDATES
             Windows keeps the heading on screen always and gates the error card on ReleasesError
             being non-null (HomePage.xaml:217-227); with a working feed it draws release cards and
             no error at all. Nothing on Linux reads an appcast yet, so ReleasesError is never set
             and only the heading shows. The card was unconditional here, which meant every Linux
             user was permanently told the release notes had failed to load, on a page where
             Windows shows a list. The card is now wired the way Windows wires it, so it starts
             working as soon as a feed sets ReleasesError. -->
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="{ReflectionBinding [home.recentReleases.title], Source={StaticResource Localization}}" Classes="sectionTitle" Margin="0,0,0,16"/>
          <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding HasReleasesError}">
            <StackPanel HorizontalAlignment="Center" Margin="0,8">
              <TextBlock Text="{ReflectionBinding [home.recentReleases.error], Source={StaticResource Localization}}"
                         Foreground="{DynamicResource HwTextSecondaryBrush}" HorizontalAlignment="Center"/>
              <Button Classes="accent" Content="{ReflectionBinding [home.recentReleases.retry], Source={StaticResource Localization}}"
                      Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="16,6"/>
            </StackPanel>
          </Border>
        <!-- RECORD AND TRANSCRIBE
             Linux needs a visible path to record on a desktop where the global shortcut cannot
             register, and file import has no Windows equivalent either, so neither could simply
             be dropped. It used to sit on the Modes page, which Windows ends at the mode grid
             with no scrollbar; putting it there changed the shape of a page both apps have. Home
             is the page whose lower half is already Linux's own, so it lands here, last, below
             Recent Updates and off the first screen.
             Every value belongs to the shell's Recording view model, so the bindings reach past
             this page's own context. -->
        <TextBlock Text="{ReflectionBinding [linux.ui.record.and.transcribe], Source={StaticResource Localization}}" Classes="sectionTitle"/>
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                  IsVisible="{ReflectionBinding $parent[Window].DataContext.Recording.AudioDevices, Converter={StaticResource AnyItemsConverter}}"><TextBlock Text="{ReflectionBinding [linux.ui.audio.input], Source={StaticResource Localization}}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{ReflectionBinding $parent[Window].DataContext.Recording.AudioDevices}" SelectedItem="{ReflectionBinding $parent[Window].DataContext.Recording.SelectedAudioDevice, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="platform:AudioInputDevice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HomeStopRecordingButton" Content="{ReflectionBinding [linux.ui.stop.and.transcribe], Source={StaticResource Localization}}" Click="OnStopRecording"/><Button x:Name="HomeCancelRecordingButton" Content="{ReflectionBinding [common.cancel], Source={StaticResource Localization}}" Click="OnCancelRecording"/><Button Content="{ReflectionBinding [linux.ui.refresh.devices], Source={StaticResource Localization}}" Command="{ReflectionBinding $parent[Window].DataContext.Recording.RefreshDevicesCommand}"/></StackPanel>
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Recording.State, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.state.value}" Classes="caption"/><TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Recording.Message}" TextWrapping="Wrap" Classes="caption"/><TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Recording.ErrorCode}" IsVisible="{ReflectionBinding $parent[Window].DataContext.Recording.HasError}" Classes="caption"/>
            <Separator/>
            <TextBlock Text="{ReflectionBinding [linux.ui.transcribe.an.existing.audio.file], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="HomeAudioFileInput" Text="{ReflectionBinding $parent[Window].DataContext.Recording.FilePath, Mode=TwoWay}" PlaceholderText="WAV, MP3, M4A, FLAC, OGG, or WebM"/><Button Grid.Column="1" Content="{ReflectionBinding [linux.ui.browse], Source={StaticResource Localization}}" Click="OnBrowseAudioFile"/><Button x:Name="HomeTranscribeFileButton" Grid.Column="2" Content="{ReflectionBinding [linux.ui.transcribe.file], Source={StaticResource Localization}}" Command="{ReflectionBinding $parent[Window].DataContext.Recording.TranscribeFileCommand}"/><Button Grid.Column="3" Content="{ReflectionBinding [linux.ui.cancel.import], Source={StaticResource Localization}}" Command="{ReflectionBinding $parent[Window].DataContext.Recording.CancelCommand}" IsVisible="{ReflectionBinding $parent[Window].DataContext.Recording.IsImporting}"/></Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{ReflectionBinding $parent[Window].DataContext.Recording.ImportProgress}" IsVisible="{ReflectionBinding $parent[Window].DataContext.Recording.IsImporting}"/>
          </StackPanel>
        </Border>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <!-- HISTORY
         The Windows page is a 300px list pane on the sidebar surface, a 1px rule, then the detail.
         Each pane carries its own header and footer band, so the page runs edge to edge with no
         page heading above it. -->
    <DataTemplate DataType="vm:HistoryViewModel">
      <Grid x:Name="HistoryScreen" ColumnDefinitions="300,1,*" KeyDown="OnHistoryKeyDown">
        <!-- Page scoped, not list scoped. Windows puts these three on Page.InputBindings, so they
             fire anywhere on the page, including from the detail pane; on the ListBox they died
             the moment you clicked into the transcript box. The Grid is focusable so a click on
             the detail surface keeps the page in the key route. -->
        <!-- Delete is a KeyDown handler rather than a fourth KeyBinding because it has to reach
             OnHistoryConfirmDelete, and a KeyBinding can only carry an ICommand. Windows can bind
             DeleteCommand from every route because its confirmation lives inside
             HistoryViewModel.DeleteAsync; on Linux the prompt is a ConfirmWindow the view owns, so
             every route has to come through the view. The handler ignores an already handled key,
             which is what keeps Delete inside the detail transcript TextBox editing text. -->
        <Grid.KeyBindings>
          <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}"/>
          <KeyBinding Gesture="Ctrl+R" Command="{Binding RetryCommand}"/>
        </Grid.KeyBindings>
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource HwSidebarBackgroundBrush}">
          <!-- Windows pads this band 16,8 and gives the filter combo a fixed 90px column at
               Margin 12,0,0,0. The search field is a bordered 8px pill with a 12px icon; it
               carries no placeholder, because the band already reads as a search bar. -->
          <!-- Windows makes this band 60 tall around a 44px search field, not the 50/34 a plain
               input takes, and centres the period combo inside it rather than stretching it. -->
          <Border Padding="16,8,16,7" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <Border Height="44" Background="{DynamicResource HwInputBackgroundBrush}" CornerRadius="8"
                      BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                <Path Data="{StaticResource HwIconSearch}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Column="1" x:Name="HistorySearchInput" Classes="bare" FontSize="13" Padding="4,6"
                         VerticalAlignment="Center" Text="{Binding SearchText}"/>
                </Grid>
              </Border>
              <ComboBox x:Name="HistoryPeriod" Grid.Column="1" Margin="12,0,0,0" Width="90" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="OnHistoryPeriodChanged">
                <ComboBoxItem Tag="All" Content="{ReflectionBinding [history.filter.all], Source={StaticResource Localization}}"/>
                <ComboBoxItem Tag="Today" Content="{ReflectionBinding [history.filter.today], Source={StaticResource Localization}}"/>
                <ComboBoxItem Tag="ThisWeek" Content="{ReflectionBinding [history.filter.week], Source={StaticResource Localization}}"/>
                <ComboBoxItem Tag="ThisMonth" Content="{ReflectionBinding [history.filter.month], Source={StaticResource Localization}}"/>
              </ComboBox>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <!-- GroupedItems is Items with a day header inserted before each new date, which is
                 how one Avalonia ListBox draws the groups the WPF ICollectionView owns. A header
                 container takes the .groupHeader class in code behind, so it cannot be selected.
                 SelectionMode is Multiple, not "Multiple,Toggle": Windows uses Extended, where a
                 plain click replaces the selection instead of toggling one row on and off. -->
            <ListBox x:Name="HistoryList" IsVisible="{Binding Items.Count}" Classes="plain flush"
                     ItemsSource="{Binding GroupedItems}" SelectionMode="Multiple"
                     ContainerPrepared="OnHistoryContainerPrepared"
                     SelectionChanged="OnHistorySelectionChanged">
              <!-- Windows reaches Retry With… from the row's context menu, not from a combo box
                   parked in the footer. Delete, Ctrl+C and Ctrl+R do the same three things from
                   the keyboard; the gesture text on each item is what advertises them. -->
              <ListBox.ContextMenu>
                <ContextMenu Opening="OnHistoryContextMenuOpening">
                  <MenuItem Header="{ReflectionBinding [common.copy], Source={StaticResource Localization}}" Command="{Binding CopyCommand}" InputGesture="Ctrl+C"/>
                  <Separator/>
                  <MenuItem Header="{ReflectionBinding [common.retry], Source={StaticResource Localization}}" Command="{Binding RetryCommand}" InputGesture="Ctrl+R"/>
                  <!-- One child per mode, built in code behind: a MenuItem generates MenuItem
                       containers in its own popup name scope, which a per-item Command binding
                       cannot reach from here. -->
                  <MenuItem x:Name="HistoryRetryMode" Header="{ReflectionBinding [history.context.retryWith], Source={StaticResource Localization}}"/>
                  <Separator/>
                  <MenuItem Header="{ReflectionBinding [common.delete], Source={StaticResource Localization}}" Click="OnHistoryConfirmDelete" InputGesture="Delete"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.DataTemplates>
                <!-- A day header. Windows renders it as a 12px SemiBold secondary label with
                     12,12,12,6 padding above the first row of the group. -->
                <DataTemplate DataType="vm:HistoryDateGroup">
                  <TextBlock Classes="groupHeader"
                             Text="{Binding ., Converter={StaticResource HistoryGroupHeaderConverter}}"/>
                </DataTemplate>
                <DataTemplate DataType="data:Transcript">
                  <!-- Windows puts the row padding on the content border, not on the container,
                       so the selection fill runs the full width of the 300px pane. -->
                  <Border Padding="12,10" Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.ColumnSpan="2" Text="{Binding Text}" FontSize="13"
                                 Foreground="{DynamicResource HwTextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40"/>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Date, Converter={StaticResource LocalTimeConverter}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource HwTextTertiaryBrush}"/>
                        <TextBlock Text="{Binding Duration, Converter={StaticResource ShortDurationConverter}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                      </StackPanel>
                      <!-- Up to three pills, exactly as the Windows row draws them. -->
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="statusPill" IsVisible="{Binding ., Converter={StaticResource TranscriptStatusConverter}, ConverterParameter=Processing}">
                          <TextBlock Text="{ReflectionBinding [recording.state.processing], Source={StaticResource Localization}}"/>
                        </Border>
                        <Border Classes="statusPill failed" IsVisible="{Binding ., Converter={StaticResource TranscriptStatusConverter}, ConverterParameter=Failed}">
                          <TextBlock Text="{ReflectionBinding [history.status.failed], Source={StaticResource Localization}}"/>
                        </Border>
                        <Border Classes="statusPill" IsVisible="{Binding ., Converter={StaticResource TranscriptStatusConverter}, ConverterParameter=Retrying}">
                          <TextBlock Text="{ReflectionBinding [history.status.retrying], Source={StaticResource Localization}}"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
            <!-- Two empty states, not one. Windows separates "you have never recorded" from
                 "your filter matched nothing", and the second one names the search. -->
            <StackPanel Classes="emptyState" IsVisible="{Binding IsEmpty}">
              <Path Data="{StaticResource HwIconMemo}" Fill="Transparent" Stroke="{DynamicResource HwEmptyGlyphBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="46" Height="48"/>
              <TextBlock Text="{ReflectionBinding [history.empty.noRecordings], Source={StaticResource Localization}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding HotkeyInstruction}" FontSize="13" Foreground="{DynamicResource HwTextSecondaryBrush}" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Classes="emptyState" IsVisible="{Binding IsFilteredEmpty}">
              <Path Data="{StaticResource HwIconSearch}" Fill="Transparent" Stroke="{DynamicResource HwEmptyGlyphBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="46" Height="48"/>
              <TextBlock Text="{ReflectionBinding [history.empty.title], Source={StaticResource Localization}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,12,0,0"/>
              <TextBlock Text="{ReflectionBinding [history.empty.subtitle], Source={StaticResource Localization}}" FontSize="13" Foreground="{DynamicResource HwTextSecondaryBrush}" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource HwBorderBrush}"/>
        <StackPanel Grid.Column="2" Classes="emptyState" IsVisible="{Binding !HasSelection}">
          <Path Data="{StaticResource HwIconPage}" Fill="Transparent" Stroke="{DynamicResource HwEmptyGlyphBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="46" Height="48"/>
          <TextBlock Text="{ReflectionBinding [history.detail.empty], Source={StaticResource Localization}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,16,0,0"/>
        </StackPanel>
        <!-- More than one row picked: Windows swaps the whole detail pane for a count and one
             destructive action, rather than showing a transcript that is not the only selection. -->
        <StackPanel Grid.Column="2" Classes="emptyState" IsVisible="{Binding HasMultipleSelection}">
          <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="48" Height="48"/>
          <TextBlock Text="{Binding SelectionCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.history.selected.count}"
                     FontSize="18" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}" Margin="0,16,0,8"/>
          <Button x:Name="HistoryDeleteSelectedButton" Classes="accent" Background="{DynamicResource HwErrorBrush}" BorderBrush="{DynamicResource HwErrorBrush}"
                  Content="{ReflectionBinding [history.action.deleteSelected], Source={StaticResource Localization}}"
                  Click="OnHistoryConfirmDelete" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto"
              IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <Border Padding="24,20" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
              <!-- The formatted date is the first element of the header band on Windows. -->
              <TextBlock Text="{Binding SelectedFormattedDate}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
              <!-- Row 1: the grey duration and mode chips. -->
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Classes="hBadge">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource HwIconHistory}" Fill="{DynamicResource HwBadgeGrayForegroundBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Selected.Duration, Converter={StaticResource ShortDurationConverter}}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="hBadge" Margin="8,0,0,0" IsVisible="{Binding Selected.Mode, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource HwIconSettings}" Fill="{DynamicResource HwBadgeGrayForegroundBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Selected.Mode}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- Row 2: the coloured provider badges, the failure badge and the raw-text badge. -->
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Classes="hBadge success" Margin="0,0,8,0" IsVisible="{Binding Selected.TranscriptionProvider, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Selected.TranscriptionProvider}" FontSize="11"/>
                </Border>
                <Border Classes="hBadge info" Margin="0,0,8,0" IsVisible="{Binding Selected.PostProcessingProvider, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Selected.PostProcessingProvider}" FontSize="11"/>
                </Border>
                <Border Classes="hBadge error" Margin="0,0,8,0" IsVisible="{Binding IsSelectedFailed}">
                  <TextBlock Text="{ReflectionBinding [history.status.failed], Source={StaticResource Localization}}" FontSize="11"/>
                </Border>
                <Border Classes="hBadge" Margin="0,0,8,0" IsVisible="{Binding ShowRawTranscript}">
                  <TextBlock Text="{ReflectionBinding [history.badge.originalTranscript], Source={StaticResource Localization}}" FontSize="11"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- No heading above the body: Windows shows the transcript alone, in a read-only but
               selectable field, and switches to a monospace face for the raw text. -->
          <ScrollViewer Grid.Row="1" Padding="24,16">
            <TextBox x:Name="HistoryDetailText" Classes="transcript" IsReadOnly="True" TextWrapping="Wrap"
                     Text="{Binding DetailText, Mode=OneWay}"
                     FontFamily="{Binding ShowRawTranscript, Converter={StaticResource TranscriptFontConverter}}"
                     Foreground="{DynamicResource HwTextPrimaryBrush}"/>
          </ScrollViewer>
          <!-- Playback band. Windows hides the whole band when the audio cannot play and shows a
               one-line warning in its place, instead of a permanently dead transport. -->
          <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,1,0,0"
                  IsVisible="{Binding IsPlaybackAvailable}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="HistoryPlayButton" Classes="playCircle" Command="{Binding PlayCommand}">
                <Panel>
                  <Path Data="{StaticResource HwIconPlay}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="14" Height="14" IsVisible="{Binding !IsPlaying}"/>
                  <Path Data="{StaticResource HwIconPause}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="14" Height="14" IsVisible="{Binding IsPlaying}"/>
                </Panel>
              </Button>
              <Slider x:Name="HistoryPlaybackSlider" Grid.Column="1" Margin="16,0" Minimum="0" VerticalAlignment="Center"
                      Maximum="{Binding PlaybackDurationSeconds}" Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}"/>
              <TextBlock Grid.Column="2" Text="{Binding FormattedPlayback}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,1,0,0"
                  IsVisible="{Binding ShowAudioUnavailableMessage}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource HwIconWarning}" Fill="{DynamicResource HwWarningBrush}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
              <!-- Windows picks between two catalog strings here: the load failed, or the file was
                   never there. Both keys already ship in the shared catalog. -->
              <Panel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{ReflectionBinding [history.audio.notAvailable], Source={StaticResource Localization}}"
                           FontSize="13" Foreground="{DynamicResource HwTextSecondaryBrush}" IsVisible="{Binding !PlaybackLoadFailed}"/>
                <TextBlock Text="{ReflectionBinding [history.audio.loadFailed], Source={StaticResource Localization}}"
                           FontSize="13" Foreground="{DynamicResource HwTextSecondaryBrush}" IsVisible="{Binding PlaybackLoadFailed}"/>
              </Panel>
            </StackPanel>
          </Border>
          <!-- Actions band. Windows paints it on the sidebar surface and puts Delete hard right. -->
          <Border Grid.Row="3" Padding="24,12" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,1,0,0"
                  Background="{DynamicResource HwSidebarBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="HistoryCopyButton" Classes="outline" Margin="0,0,8,0" Command="{Binding CopyCommand}">
                  <Panel>
                    <TextBlock Text="{ReflectionBinding [common.copy], Source={StaticResource Localization}}" IsVisible="{Binding !IsCopiedRecently}"/>
                    <TextBlock Text="{ReflectionBinding [history.copy.copied], Source={StaticResource Localization}}" IsVisible="{Binding IsCopiedRecently}"/>
                  </Panel>
                </Button>
                <!-- Windows swaps this label rather than leaving it on a static "Retry": first
                     time history.context.retry, "Retry Transcription", then
                     history.context.retryAgain, "Retry again", once RetryCount > 0
                     (HistoryPage.xaml:492 through BoolToRetryTextConverter). Same two-TextBlock
                     Panel the Copy button beside it already uses. -->
                <Button x:Name="HistoryRetryButton" Classes="outline" Margin="0,0,8,0"
                        Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanRetry}" IsEnabled="{Binding !IsRetrying}">
                  <Panel>
                    <TextBlock Text="{ReflectionBinding [history.context.retry], Source={StaticResource Localization}}" IsVisible="{Binding !HasRetryInfo}"/>
                    <TextBlock Text="{ReflectionBinding [history.context.retryAgain], Source={StaticResource Localization}}" IsVisible="{Binding HasRetryInfo}"/>
                  </Panel>
                </Button>
                <Button x:Name="HistoryShowRawTranscript" Classes="outline" Margin="0,0,8,0"
                        Click="OnHistoryToggleRawTranscript" IsVisible="{Binding HasRawTranscript}">
                  <Panel>
                    <TextBlock Text="{ReflectionBinding [history.toggle.showOriginal], Source={StaticResource Localization}}" IsVisible="{Binding !ShowRawTranscript}"/>
                    <TextBlock Text="{ReflectionBinding [history.toggle.showProcessed], Source={StaticResource Localization}}" IsVisible="{Binding ShowRawTranscript}"/>
                  </Panel>
                </Button>
              </StackPanel>
              <!-- Windows raises a YesNo MessageBox here (transcripts.delete.single.*) and its
                   text promises the audio file goes with the recording. The Linux flyout asked a
                   different question, had no Cancel, and made the audio deletion an opt-in
                   checkbox that defaulted to off; OnHistoryConfirmDelete now runs the same
                   confirmation both apps show. -->
              <Button x:Name="HistoryDeleteButton" Grid.Column="1" Classes="danger"
                      Click="OnHistoryConfirmDelete"
                      Content="{ReflectionBinding [common.delete], Source={StaticResource Localization}}"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:VocabularyViewModel">
      <ScrollViewer x:Name="VocabularyScreen" Classes="page">
      <StackPanel MaxWidth="720">
        <!-- Once the list is past the hundred terms a provider will boost, Windows says so. -->
        <Border Background="{DynamicResource HwWarningBackgroundBrush}" BorderBrush="{DynamicResource HwWarningBorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12"
                IsVisible="{Binding HasKeywordLimitWarning}">
          <StackPanel>
            <TextBlock Text="{ReflectionBinding [vocabulary.limit.title], Source={StaticResource Localization}}"
                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            <TextBlock Text="{Binding KeywordLimitMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource HwWarningForegroundBrush}"/>
          </StackPanel>
        </Border>

        <!-- INPUT
             Windows has one pill with a single field and the two actions hinted inside it as
             chips with their key caps, not a two-field form with a Save button. Ctrl+Enter (or
             the "Replace with…" chip) reveals the replacement panel below. -->
        <StackPanel x:Name="VocabularyInputSection" Margin="0,0,0,16">
          <Border Classes="inputPill">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="VocabularyWordInput" Classes="bare" FontSize="14" Text="{Binding Word}"
                       KeyDown="OnVocabularyWordKeyDown"
                       PlaceholderText="{ReflectionBinding [vocabulary.input.placeholder], Source={StaticResource Localization}}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Button x:Name="VocabularyAddButton" Classes="actionChip" Margin="0,0,16,0" Click="OnVocabularyAdd">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Named because the edit pencil relabels it to common.update, as Windows
                         does while a row is being edited. -->
                    <TextBlock x:Name="VocabularyAddChipLabel"
                               Text="{ReflectionBinding [vocabulary.action.addWord], Source={StaticResource Localization}}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    <Border Classes="keyCap">
                      <TextBlock Text="↵" FontSize="11" FontWeight="Medium"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
                <Button x:Name="VocabularyReplaceWithChip" Classes="actionChip" Margin="0,0,16,0" Click="OnVocabularyRevealReplacement">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{ReflectionBinding [vocabulary.action.replaceWith], Source={StaticResource Localization}}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    <Border Classes="keyCap" Margin="0,0,3,0">
                      <TextBlock Text="Ctrl" FontSize="10" FontWeight="Medium"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    </Border>
                    <Border Classes="keyCap">
                      <TextBlock Text="↵" FontSize="11" FontWeight="Medium"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
                <Button x:Name="VocabularyCancelButton" IsVisible="False" Padding="10,4" FontSize="12"
                        Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource HwBorderBrush}"
                        Foreground="{DynamicResource HwTextSecondaryBrush}" Click="OnVocabularyCancelEdit"
                        Content="{ReflectionBinding [common.cancel], Source={StaticResource Localization}}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="VocabularyReplacementPanel" IsVisible="False"
                  Background="{DynamicResource HwInputBackgroundBrush}"
                  BorderBrush="{DynamicResource HwAccentBrush}" BorderThickness="2"
                  CornerRadius="10" Padding="16,12" Margin="0,10,0,0">
            <Grid RowDefinitions="*,Auto">
              <TextBox x:Name="VocabularyReplacementInput" Classes="bare" FontSize="14" MinHeight="64"
                       AcceptsReturn="False" TextWrapping="Wrap" VerticalAlignment="Top"
                       VerticalContentAlignment="Top" Text="{Binding Replacement}"
                       KeyDown="OnVocabularyReplacementKeyDown"
                       PlaceholderText="{ReflectionBinding [vocabulary.replacement.field.placeholder], Source={StaticResource Localization}}"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="VocabularyReplaceButton" Classes="actionChip" Click="OnVocabularyAdd">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{ReflectionBinding [vocabulary.action.replace], Source={StaticResource Localization}}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    <Border Classes="keyCap" Margin="0,0,3,0">
                      <TextBlock Text="Ctrl" FontSize="10" FontWeight="Medium"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    </Border>
                    <Border Classes="keyCap">
                      <TextBlock Text="↵" FontSize="11" FontWeight="Medium"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- One error line, under the input, shown only when something failed. -->
          <TextBlock Text="{Binding InputError}" IsVisible="{Binding HasInputError}"
                     FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource HwErrorForegroundBrush}"/>
        </StackPanel>

        <!-- LIST
             One card around the header band, the rows and the empty state. The list itself is
             transparent with no border and no minimum height, so an empty table is the empty
             state and nothing else. -->
        <Border Classes="tableCard">
          <StackPanel>
            <!-- Windows draws no column strip until there is a row to label, so an empty
                 Vocabulary is the empty state alone, not a 30px header over it. -->
            <Border Classes="tableHeaderBand" IsVisible="{Binding Items.Count}">
              <Grid ColumnDefinitions="2*,2*,110,90">
                <TextBlock Text="{ReflectionBinding [vocabulary.word.column], Source={StaticResource Localization}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{ReflectionBinding [vocabulary.replacement.column], Source={StaticResource Localization}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{ReflectionBinding [vocabulary.source.column], Source={StaticResource Localization}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
              </Grid>
            </Border>
            <!-- Windows keeps a 16px header band across the top of this card even with nothing in
                 it, so the empty state sits under the same strip the populated table has. It draws
                 no column labels in that state, only the band. -->
            <Border Classes="tableHeaderBand" Height="16" Padding="0" IsVisible="{Binding !Items.Count}"/>
            <StackPanel HorizontalAlignment="Center" Margin="40,47,40,48" IsVisible="{Binding !Items.Count}">
              <!-- Stroked, not filled: the two page shapes meet at the spine, so a fill reads as
                   a solid block at this size instead of an open book. -->
              <!-- Windows' empty-state glyph measures 44x37; 48 square drew it 50x47 here. -->
              <Path Data="{StaticResource HwIconLibrary}" Stroke="{DynamicResource HwTextSecondaryBrush}" StrokeThickness="1.3"
                    Stretch="Uniform" Width="44" Height="37" HorizontalAlignment="Center" Margin="0,0,0,22"/>
              <TextBlock Text="{ReflectionBinding [vocabulary.empty.title], Source={StaticResource Localization}}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
              <TextBlock Text="{ReflectionBinding [vocabulary.empty.subtitle], Source={StaticResource Localization}}" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
            </StackPanel>
            <ListBox x:Name="VocabularyList" Classes="plain flush" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsVisible="{Binding Items.Count}"
                     ContainerPrepared="OnVocabularyContainerPrepared">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HwBorderBrush}">
                    <Grid ColumnDefinitions="2*,2*,110,90">
                      <TextBlock Text="{Binding Word}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Replacement}" FontSize="13" TextWrapping="Wrap"
                                 VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                      <Border Grid.Column="2" Classes="sourceBadge"
                              IsVisible="{Binding Source, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Source, Converter={StaticResource VocabularySourceConverter}}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                      </Border>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="rowIcon" Tag="{Binding}" Click="OnVocabularyEditRow"
                                ToolTip.Tip="{ReflectionBinding [common.edit], Source={StaticResource Localization}}">
                          <Path Data="{StaticResource HwIconEdit}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="rowIcon" Margin="4,0,0,0" Tag="{Binding}" Click="OnVocabularyDeleteRow"
                                ToolTip.Tip="{ReflectionBinding [common.delete], Source={StaticResource Localization}}">
                          <Path Data="{StaticResource HwIconTrash}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:ModesViewModel">
      <ScrollViewer x:Name="ModesScreen" Classes="page">
      <StackPanel Spacing="16" MaxWidth="720">
        <!-- MODE CARD GRID
             Windows lays the modes out as a two column ListBox with 12px gaps (6px on each
             item) and the list pulled back 4 on each side so the cards line up with the page
             title. The create button sits on the header band, and the gear opens the editor as
             a modal dialog, so this page is the grid and nothing else. -->
        <ListBox x:Name="ModeGrid" Classes="modeGrid" Margin="-4,3,-4,0"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:Mode">
              <!-- 15 at the bottom, not 16. The selection ring is drawn by the ListBoxItem's own
                   ContentPresenter (Styles.axaml:328, BorderThickness 2), which Windows does not
                   have, so the card came out 2px taller than Windows' and the grid drifted a pixel
                   per row: Windows put its card tops at y308/431, Linux at y310/434. Trimming the
                   bottom inset puts the last line 20px above the card edge, exactly as Windows
                   draws it, and restores the 123px row pitch. -->
              <Border Background="{DynamicResource HwCardBackgroundBrush}" CornerRadius="9" Padding="16,16,16,15"
                      BorderThickness="1" BorderBrush="{DynamicResource HwBorderBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" Classes="modeName"/>
                    <Button Grid.Column="1" Classes="cardGear" Tag="{Binding}" Click="OnEditMode"
                            ToolTip.Tip="{ReflectionBinding [linux.ui.mode.editor], Source={StaticResource Localization}}">
                      <Path Data="{StaticResource HwIconSettings}" Fill="{DynamicResource HwTextSecondaryBrush}"
                            Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                  </Grid>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Data="{StaticResource HwIconGlobe}" Fill="{DynamicResource HwTextSecondaryBrush}"
                          Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Language, Converter={StaticResource LanguageDisplayNameConverter}}"
                               FontSize="11" FontWeight="Medium" Margin="4,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  </StackPanel>
                  <!-- Plain inline text, no chips: a cloud mode reads "{Provider} · {Model}" in
                       the accent colour, a local mode reads the model in the success colour, and
                       the two never both show. -->
                  <!-- A Grid, not a StackPanel: the post-processing segment takes the slack
                       and ellipsises, so a long model id stops at the card edge. -->
                  <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding Converter={StaticResource ModeProviderLineConverter}, ConverterParameter=cloudVisible}">
                      <!-- Stroked, not filled. Windows draws Segoe MDL2 E753 here
                           (ModesPage.xaml:203) and MDL2's Cloud is an outline glyph, not a solid
                           one; probing w02_modes.png at 276,252 gives an 11x7 ink box with a hollow
                           interior. A round of this loop filled it on the strength of a written
                           brief rather than the reference pixels, which put the wrong shape on all
                           ten mode cards. The silhouette geometry is reused as the stroke path. -->
                      <Path Data="{StaticResource HwIconCloud}" Stroke="{DynamicResource HwAccentBrush}"
                            StrokeThickness="1.4" Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Converter={StaticResource ModeProviderLineConverter}, ConverterParameter=cloud}"
                                 FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwAccentBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding Converter={StaticResource ModeProviderLineConverter}, ConverterParameter=localVisible}">
                      <Path Data="{StaticResource HwIconChip}" Fill="{DynamicResource HwSuccessBrush}"
                            Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Converter={StaticResource ModeProviderLineConverter}, ConverterParameter=local}"
                                 FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwSuccessBrush}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*"
                          IsVisible="{Binding Converter={StaticResource ModePostProcessingConverter}, ConverterParameter=visible}">
                      <TextBlock Text=" · " FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HwTextTertiaryBrush}"/>
                      <!-- Also stroked. Windows draws Segoe MDL2 E945 (ModesPage.xaml:240), an
                           outlined bolt whose ink box probes at 10x11 with an open middle; the
                           solid bolt here read as a much heavier mark at the same size. -->
                      <Path Grid.Column="1" Data="{StaticResource HwIconBolt}" Stroke="{DynamicResource HwPostProcessingBrush}"
                            StrokeThickness="1.4" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource ModePostProcessingConverter}}"
                                 FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource HwPostProcessingBrush}"/>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- A profile with no modes at all. The grid above simply renders nothing there, which
             left the page blank with no explanation. Drawn with the same stroked glyph and the
             same two-line wording the History and Vocabulary empty states use, so the four
             empty pages read as one set. -->
        <StackPanel Classes="emptyState" IsVisible="{Binding !Items.Count}">
          <Path Data="{StaticResource HwIconModes}" Fill="Transparent" Stroke="{DynamicResource HwEmptyGlyphBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="46" Height="48"/>
          <TextBlock Text="{ReflectionBinding [linux.empty.modes.title], Source={StaticResource Localization}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,12,0,0"/>
          <TextBlock Text="{ReflectionBinding [linux.empty.modes.body], Source={StaticResource Localization}}" FontSize="13" Foreground="{DynamicResource HwTextSecondaryBrush}" TextAlignment="Center"/>
        </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <!-- Live transcription gets its own page, as it does on Windows. Every value still belongs
         to the settings view model; this template only re-presents the streaming half of it. -->
    <DataTemplate DataType="vm:StreamingSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="StreamingScreen" MaxWidth="560">
        <!-- The Windows page is three sections, not one card: General (enable + shortcut),
             Engine (provider, live engine, Deepgram model, fast formatting) with a provider
             status panel and a vocabulary warning under it, then Language on its own. Every row
             is 42,*,220 with a 20px glyph in the first column, and everything below the enable
             row stays hidden until streaming is on. -->
        <Border x:Name="StreamingConflictBanner" IsVisible="False" Padding="12" Margin="0,0,0,18" CornerRadius="9"
                Background="{DynamicResource HwWarningBackgroundBrush}" BorderBrush="{DynamicResource HwWarningBorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top"
                    Background="{DynamicResource HwWarningBorderBrush}">
              <TextBlock Text="!" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{ReflectionBinding [linux.streaming.conflict.title], Source={StaticResource Localization}}"
                         FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HwWarningForegroundBrush}"/>
              <TextBlock x:Name="StreamingConflictMessage" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                         Foreground="{DynamicResource HwWarningForegroundBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{ReflectionBinding [linux.streaming.conflict.change], Source={StaticResource Localization}}" Click="OnFocusStreamingShortcut"/>
                <Button Margin="8,0,0,0" Content="{ReflectionBinding [linux.streaming.conflict.openSettings], Source={StaticResource Localization}}" Click="OnGoToShortcuts"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{ReflectionBinding [settings.nav.general], Source={StaticResource Localization}}" Classes="sectionLabel"/>
        <Border Classes="card" Margin="0,0,0,18">
          <StackPanel>
            <Grid ColumnDefinitions="42,*,Auto" MinHeight="38">
              <Path Data="{StaticResource HwIconStreaming}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="rowTitle" VerticalAlignment="Center"
                         Text="{ReflectionBinding [settings.streaming.enable.title], Source={StaticResource Localization}}"/>
              <CheckBox Grid.Column="2" x:Name="StreamingEnabledToggle" VerticalAlignment="Center" IsChecked="{Binding Settings.StreamingEnabled}"/>
            </Grid>
            <Separator Margin="0,12" IsVisible="{Binding IsStreamingEnabled}"/>
            <Grid ColumnDefinitions="42,*,220" MinHeight="38" IsVisible="{Binding IsStreamingEnabled}">
              <Path Data="{StaticResource HwIconKeyboard}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Classes="rowTitle" Text="{ReflectionBinding [settings.streaming.shortcut.title], Source={StaticResource Localization}}"/>
                <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource HwTextSecondaryBrush}"
                           Text="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
              </StackPanel>
              <!-- Windows puts a REAL 220-wide recorder on this page, not a read-out: the same
                   ShortcutRecorderBox the Shortcuts page uses, under role "Streaming". "boundText"
                   marks the one recorder whose Text is bound, so the handler never stamps a local
                   value over that binding and kills it. Windows enforces the same rule with its
                   BindingOperations.GetBindingExpression check. -->
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBox x:Name="StreamingShortcutBox" Classes="shortcutBox boundText" Tag="streaming" IsReadOnly="True"
                         KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                         Text="{Binding Settings.StreamingShortcutDisplay, Mode=OneWay}"
                         ToolTip.Tip="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
                <TextBlock x:Name="StreamingShortcutBoxError" Classes="shortcutError"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding IsStreamingEnabled}">
          <TextBlock Text="{ReflectionBinding [linux.streaming.section.engine], Source={StaticResource Localization}}" Classes="sectionLabel"/>
          <Border Classes="card" Margin="0,0,0,18">
            <StackPanel>
              <Grid ColumnDefinitions="42,*,220" MinHeight="38">
                <Path Data="{StaticResource HwIconCloud}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="rowTitle" VerticalAlignment="Center"
                           Text="{ReflectionBinding [settings.streaming.provider.title], Source={StaticResource Localization}}"/>
                <ComboBox Grid.Column="2" x:Name="StreamingProviderChoice" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          SelectionChanged="OnStreamingProviderChanged">
                  <ComboBoxItem Tag="hyperwhisper" Content="{ReflectionBinding [settings.streaming.provider.hyperwhisperCloud], Source={StaticResource Localization}}"/>
                  <ComboBoxItem Tag="deepgram" Content="{ReflectionBinding [settings.streaming.provider.deepgram], Source={StaticResource Localization}}"/>
                  <ComboBoxItem Tag="elevenlabs" Content="{ReflectionBinding [settings.streaming.provider.elevenLabs], Source={StaticResource Localization}}"/>
                  <ComboBoxItem Tag="openai" Content="{ReflectionBinding [settings.streaming.provider.openAI], Source={StaticResource Localization}}"/>
                  <ComboBoxItem Tag="grok" Content="{ReflectionBinding [settings.streaming.provider.xai], Source={StaticResource Localization}}"/>
                  <ComboBoxItem Tag="geminiTranscribe" Content="{ReflectionBinding [settings.streaming.provider.geminiTranscribe], Source={StaticResource Localization}}"/>
                </ComboBox>
              </Grid>

              <StackPanel IsVisible="{Binding Settings.StreamingUsesHyperWhisperCloud}">
                <Separator Margin="0,12"/>
                <Grid ColumnDefinitions="42,*,220" MinHeight="38">
                  <Path Data="{StaticResource HwIconChip}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="rowTitle" Text="{ReflectionBinding [settings.streaming.cloudTier.title], Source={StaticResource Localization}}"/>
                    <TextBlock FontSize="12" Margin="0,2,20,0" TextWrapping="Wrap" Foreground="{DynamicResource HwTextSecondaryBrush}"
                               Text="{ReflectionBinding [settings.streaming.cloudTier.subtitle], Source={StaticResource Localization}}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" x:Name="StreamingCloudTierChoice" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            ItemsSource="{Binding Settings.StreamingCloudTiers}" SelectedItem="{Binding Settings.StreamingCloudTier}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource OptionLabelConverter}, ConverterParameter=modes.cloudAccuracy.|.label}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding UsesDeepgram}">
                <Separator Margin="0,12"/>
                <Grid ColumnDefinitions="42,*,220" MinHeight="38">
                  <Path Data="{StaticResource HwIconChip}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Classes="rowTitle" VerticalAlignment="Center"
                             Text="{ReflectionBinding [settings.streaming.deepgram.model.title], Source={StaticResource Localization}}"/>
                  <ComboBox Grid.Column="2" x:Name="StreamingModelInput" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            SelectionChanged="OnStreamingDeepgramModelChanged">
                    <ComboBoxItem Tag="nova-3-general" Content="{ReflectionBinding [settings.streaming.deepgram.model.general], Source={StaticResource Localization}}"/>
                    <ComboBoxItem Tag="nova-3-medical" Content="{ReflectionBinding [settings.streaming.deepgram.model.medical], Source={StaticResource Localization}}"/>
                  </ComboBox>
                </Grid>
              </StackPanel>

              <Separator Margin="0,12"/>
              <Grid ColumnDefinitions="42,*,Auto" MinHeight="46">
                <Path Data="{StaticResource HwIconSparkle}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="{ReflectionBinding [settings.streaming.fastFormatting.title], Source={StaticResource Localization}}"/>
                  <TextBlock FontSize="12" Margin="0,2,20,0" TextWrapping="Wrap" Foreground="{DynamicResource HwTextSecondaryBrush}"
                             Text="{ReflectionBinding [settings.streaming.fastFormatting.subtitle], Source={StaticResource Localization}}"/>
                </StackPanel>
                <CheckBox Grid.Column="2" x:Name="StreamingFastFormattingToggle" VerticalAlignment="Center" IsChecked="{Binding Settings.StreamingFastFormatting}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="StreamingProviderStatusPanel" Padding="12,10" Margin="42,0,0,10" CornerRadius="8"
                  Background="{DynamicResource HwInputBackgroundBrush}" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource HwIconInfo}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,8,0"/>
              <TextBlock Grid.Column="1" x:Name="StreamingProviderStatusText" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource HwTextSecondaryBrush}"/>
            </Grid>
          </Border>

          <Border x:Name="StreamingVocabularyWarningPanel" IsVisible="False" Padding="12,10" Margin="42,0,0,18" CornerRadius="8"
                  Background="{DynamicResource HwWarningBackgroundBrush}" BorderBrush="{DynamicResource HwWarningBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource HwIconWarning}" Fill="{DynamicResource HwWarningForegroundBrush}" Stretch="Uniform"
                    Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,8,0"/>
              <TextBlock Grid.Column="1" x:Name="StreamingVocabularyWarningText" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource HwTextSecondaryBrush}"/>
            </Grid>
          </Border>

          <TextBlock Text="{ReflectionBinding [settings.streaming.language.title], Source={StaticResource Localization}}" Classes="sectionLabel"/>
          <Border Classes="card">
            <Grid ColumnDefinitions="42,*,220" MinHeight="38">
              <Path Data="{StaticResource HwIconGlobe}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="rowTitle" VerticalAlignment="Center"
                         Text="{ReflectionBinding [settings.streaming.language.title], Source={StaticResource Localization}}"/>
              <ComboBox Grid.Column="2" x:Name="StreamingLanguageInput" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding DisplayName}"/>
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- SETTINGS SECTIONS
         One template per Windows settings page, in the same order, with the same cards, the same
         row copy and the same 20px page title. Every row reads a value off Settings, which is the
         one view model all seven sections share. -->
    <DataTemplate DataType="vm:GeneralSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="SettingsScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.general.title], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.launchAtLogin.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.general.launchAtLogin.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsAutostart" IsChecked="{Binding Settings.AutostartEnabled}" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.launchMinimized.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.general.launchMinimized.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsLaunchMinimized" IsChecked="{Binding Settings.LaunchMinimized}" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.minimizeToTray.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.general.minimizeToTray.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsMinimizeToTray" IsChecked="{Binding Settings.MinimizeToTray}" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Classes="settingRow last"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.showRecordingWindow.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.general.showRecordingWindow.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsShowRecordingWindow" IsChecked="{Binding Settings.ShowRecordingWindow}" VerticalAlignment="Center"/>
          </Grid></Border>
        </StackPanel></Border>
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.errorLogging.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.general.errorLogging.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsEnableErrorLogging" IsChecked="{Binding Settings.EnableErrorLogging}" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.shareSpeedData.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.general.shareSpeedData.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
              <!-- Windows ends this row with an accent link to the public latency page, at
                   FontSize 11 and Margin 0,4,0,0, not with a second sentence of body copy. -->
              <Button x:Name="SettingsSpeedComparisonLink" Classes="linkAccent" FontSize="11" Margin="0,4,0,0"
                      HorizontalAlignment="Left" Click="OnOpenSpeedComparison"
                      Content="{ReflectionBinding [settings.general.shareSpeedData.link], Source={StaticResource Localization}}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsShareSpeedData" IsChecked="{Binding Settings.ShareAnonymousSpeedData}" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Classes="settingRow last"><Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.general.autoUpdate.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.general.autoUpdate.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsAutoUpdate" IsChecked="{Binding Settings.AutoUpdateEnabled}" VerticalAlignment="Center"/>
          </Grid></Border>
        </StackPanel></Border>
        <!-- Windows closes the page with a Need help? card: the title left, one button right, in
             a *,Auto grid. It used to sit on the Linux About page. -->
        <Border Classes="card" Margin="0,0,0,20"><Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{ReflectionBinding [settings.general.support.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
          <!-- ONE button, as Windows draws it. The Documentation button that used to sit beside
               it is gone: Windows has no docs button on this card either, and the same
               https://hyperwhisper.com/docs site is reached from Settings > Local API > Docs,
               which is exactly where Windows puts its only in-app docs button. -->
          <Button Grid.Column="1" x:Name="SettingsSupportButton" Click="OnOpenSupport" VerticalAlignment="Center"
                  Content="{ReflectionBinding [menu.command.contact.support], Source={StaticResource Localization}}"/>
        </Grid></Border>
        <!-- Windows ends the page with the app version at 12px secondary, not a status line. -->
        <TextBlock x:Name="SettingsVersionText" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="4,0,0,0"/>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- Sound. Windows is THREE cards at Margin 0,0,0,20 — Sound Effects, Media Control and
         Microphone — not one card of hairline-separated rows. The two rows inside the microphone
         card carry no divider at all; the second one only takes Margin 0,12,0,0. -->
    <DataTemplate DataType="vm:SoundSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="SoundScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.sound.title], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card" Margin="0,0,0,20"><Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="{ReflectionBinding [settings.sound.enableSoundEffects.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Text="{ReflectionBinding [settings.sound.enableSoundEffects.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
          </StackPanel>
          <CheckBox Grid.Column="1" x:Name="SettingsSoundEffects" IsChecked="{Binding Settings.EnableSoundEffects}" VerticalAlignment="Center"/>
        </Grid></Border>
        <!-- Windows offers two localized items in a fixed 130px column, not the three raw
             lowercase policy strings the shared list carries. The Tag is the stored value, the
             way the Windows page writes it, and code behind syncs the pick on navigation. -->
        <Border Classes="card" Margin="0,0,0,20"><Grid ColumnDefinitions="*,130">
          <StackPanel Spacing="2">
            <TextBlock Text="{ReflectionBinding [settings.sound.mediaControl.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Text="{ReflectionBinding [settings.sound.mediaControl.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
          </StackPanel>
          <ComboBox Grid.Column="1" x:Name="SettingsAudioEnvironmentPolicy" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" SelectionChanged="OnAudioEnvironmentPolicyChanged">
            <ComboBoxItem Tag="unchanged" Content="{ReflectionBinding [settings.sound.mediaControl.off], Source={StaticResource Localization}}"/>
            <ComboBoxItem Tag="mute" Content="{ReflectionBinding [settings.sound.mediaControl.muteAudio], Source={StaticResource Localization}}"/>
          </ComboBox>
        </Grid></Border>
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.sound.autoIncreaseMicVolume.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.sound.autoIncreaseMicVolume.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsBoostMicrophone" IsChecked="{Binding Settings.AutoIncreaseMicVolume}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <StackPanel Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.sound.keepMicrophoneWarm.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.sound.keepMicrophoneWarm.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsKeepMicrophoneWarm" IsChecked="{Binding Settings.KeepMicrophoneWarm}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel></Border>
        <!-- Windows ends the page at the Microphone card. The sound-effect volume slider and the
             silence-trim switch that used to follow it are gone: both defaults already match what
             Windows does (volume 1.0, which is the only level Windows ever plays at), and the
             per-application level is a desktop mixer concern on this platform. -->
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- STORAGE
         Windows draws three cards at Margin 0,0,0,12 with a free-standing notice row between the
         first and the second: recordings folder + Show, then audio compression alone, then
         auto-delete. The Linux-only "keep app-owned audio" switch gets its own card rather than
         being folded into the compression one, which Windows keeps to a single row. -->
    <DataTemplate DataType="vm:StorageSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="StorageScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.section.storage], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card" Margin="0,0,0,12"><StackPanel>
          <!-- The path is read-only and monospaced under the title, not an editable field: the
               folder is chosen through the picker, which validates it. -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{ReflectionBinding [settings.storage.recordings.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock x:Name="SettingsRecordingsDirectory" Classes="monoValue secondary" Margin="0,2,0,0"
                         Text="{Binding Settings.RecordingsDirectory}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SettingsChooseRecordingsDirectory" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{ReflectionBinding [settings.storage.choose.button], Source={StaticResource Localization}}"
                    Click="OnChooseRecordingsDirectory"/>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{ReflectionBinding [settings.storage.showFolder.title], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SettingsStorageOpenFolder" Classes="accent" Margin="12,0,0,0"
                    Content="{ReflectionBinding [linux.storage.showFolder.button], Source={StaticResource Localization}}"
                    Click="OnOpenRecordingsFolder"/>
          </Grid>
          <TextBlock x:Name="StorageErrorText" Classes="errorText" Margin="0,8,0,0" IsVisible="False"/>
        </StackPanel></Border>

        <!-- The notice is its own row BELOW the card on Windows, with an info glyph. -->
        <Grid ColumnDefinitions="Auto,*" Margin="4,0,4,12">
          <Path Data="{StaticResource HwIconInfo}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                Width="12" Height="12" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <!-- One sentence only, the Windows one. The Linux restart caveat used to sit here as a
               second paragraph and pushed every card below it down 49px. -->
          <TextBlock Grid.Column="1" Text="{ReflectionBinding [linux.settings.storage.notice], Source={StaticResource Localization}}" Classes="rowSubtitle"/>
        </Grid>

        <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,Auto">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{ReflectionBinding [settings.storage.storeAsM4A.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Text="{ReflectionBinding [linux.settings.storage.storeAsM4A.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
          </StackPanel>
          <CheckBox Grid.Column="1" x:Name="SettingsStoreAsM4A" IsChecked="{Binding Settings.StoreAsM4A}" VerticalAlignment="Center"/>
        </Grid></Border>

        <Border Classes="card" Margin="0,0,0,12"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.storage.autoDelete.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.storage.autoDelete.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsAutoDeleteEnabled" IsChecked="{Binding Settings.AutoDeleteEnabled}" VerticalAlignment="Center"/>
          </Grid>
          <!-- Windows keeps the retention row, the last-cleanup line and Delete Now hidden until
               the toggle is on: an off switch has nothing to configure. -->
          <StackPanel IsVisible="{Binding Settings.AutoDeleteEnabled}">
            <Border Classes="divider"/>
            <Grid ColumnDefinitions="*,Auto">
              <!-- Windows reverses the usual emphasis here: the label is 12px secondary and the
                   "days" unit is primary, because the number is what the row is about. -->
              <TextBlock Text="{ReflectionBinding [settings.storage.autoDelete.deleteAfter], Source={StaticResource Localization}}"
                         Classes="rowSubtitle" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows rejects non-digits as they are typed and clamps to 1-365 on
                     LostFocus, rewriting the box (StorageSettingsPage.xaml.cs:146-162). The view
                     model already clamps what it stores, but a plain two-way binding left the box
                     showing "0" or "abcd" after the value behind it had refused them. -->
                <TextBox x:Name="SettingsAutoDeleteDays" Width="60" TextAlignment="Center"
                         TextInput="OnAutoDeleteDaysTextInput" LostFocus="OnAutoDeleteDaysLostFocus"
                         Text="{Binding Settings.AutoDeleteDaysOld, Mode=TwoWay}"/>
                <TextBlock Text="{ReflectionBinding [settings.storage.autoDelete.days], Source={StaticResource Localization}}"
                           FontSize="13" Foreground="{DynamicResource HwTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </Grid>
            <Border Classes="divider"/>
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource HwIconHistory}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="11" Height="11" VerticalAlignment="Top" Margin="0,2,8,0"/>
              <TextBlock Grid.Column="1" x:Name="StoragePathText" Classes="caption"/>
            </Grid>
          </StackPanel>
          <Button x:Name="SettingsStorageDeleteNow" HorizontalAlignment="Left" Margin="0,12,0,0"
                  IsVisible="{Binding Settings.AutoDeleteEnabled}"
                  Content="{ReflectionBinding [settings.storage.autoDelete.deleteNow], Source={StaticResource Localization}}"
                  Click="OnDeleteStoredAudioNow"/>
        </StackPanel></Border>

        <!-- Windows ends the page at the Auto-Delete card. The Linux-only card that used to
             follow it is gone: keeping app-owned audio after transcription is what Windows always
             does and what this setting already defaults to, retention is reached through
             Automatic Cleanup above, and Windows reports no disk usage on this page at all. -->
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- TEXT OUTPUT
         Two Windows cards separated by a 16px "Clipboard" heading, with 10/10 rules inside each
         card. The three Linux-only rows (word timestamps, the clipboard-history status line and
         the default language) sit in a third card at the foot rather than inside a Windows one. -->
    <DataTemplate DataType="vm:OutputSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="OutputScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.section.output], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.output.paste.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.output.paste.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsPasteResultText" IsChecked="{Binding Settings.PasteResultText}" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="divider mid" Margin="0,12,0,12"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.output.removeFillerWords.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.output.removeFillerWords.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsRemoveFillerWords" IsChecked="{Binding Settings.RemoveFillerWords}" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="divider mid" Margin="0,12,0,12"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.output.autocapitalizeInsert.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.output.autocapitalizeInsert.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Windows runs a UI-Automation self-test the moment this is switched on and, if it
                 throws, explains that browsers and Electron apps may not expose the focused field
                 (OutputSettingsPage.xaml.cs:102-126). It deliberately leaves the toggle on. The
                 Linux equivalent probes AT-SPI, which is the same capability on this desktop. -->
            <CheckBox Grid.Column="1" x:Name="SettingsAutocapitalizeInsert" IsChecked="{Binding Settings.AutocapitalizeInsert}" VerticalAlignment="Center"
                      IsCheckedChanged="OnAutocapitalizeInsertChanged"/>
          </Grid>
        </StackPanel></Border>

        <TextBlock Text="{ReflectionBinding [settings.output.clipboard.section], Source={StaticResource Localization}}"
                   Classes="cardTitle" Margin="4,0,0,20"/>
        <Border Classes="card" Margin="0,0,0,12"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.output.restoreClipboard.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.output.restoreClipboard.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsRestoreClipboard" IsChecked="{Binding Settings.RestoreClipboardAfterPaste}" VerticalAlignment="Center"/>
          </Grid>
          <!-- The delay only means anything while the restore itself is on. -->
          <StackPanel IsVisible="{Binding Settings.RestoreClipboardAfterPaste}">
            <Border Classes="divider mid" Margin="0,12,0,12"/>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{ReflectionBinding [settings.output.restoreDelay.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
                <TextBlock Text="{ReflectionBinding [settings.output.restoreDelay.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
              </StackPanel>
              <!-- Windows steps this value with a 32x32 pair around its own read-out, not a
                   spinner: the delay is a whole number of seconds and the buttons are the whole
                   control surface. -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows disables the two buttons at the bounds rather than letting them no-op:
                     "-" at 1 second and "+" at 60 (OutputSettingsPage.xaml.cs:160-161). -->
                <Button Classes="stepper" Content="−" Click="OnClipboardRestoreDelayDecrease"
                        IsEnabled="{Binding Settings.CanDecreaseClipboardRestoreDelay}"
                        ToolTip.Tip="{ReflectionBinding [settings.output.restoreDelay.title], Source={StaticResource Localization}}"/>
                <TextBlock x:Name="SettingsClipboardRestoreDelay" FontSize="13" MinWidth="50" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource HwTextPrimaryBrush}"
                           Text="{Binding Settings.ClipboardRestoreDelaySeconds, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.restoreDelay.seconds}"/>
                <Button Classes="stepper" Content="+" Click="OnClipboardRestoreDelayIncrease"
                        IsEnabled="{Binding Settings.CanIncreaseClipboardRestoreDelay}"
                        ToolTip.Tip="{ReflectionBinding [settings.output.restoreDelay.title], Source={StaticResource Localization}}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
          <Border Classes="divider mid" Margin="0,12,0,12"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.output.hideClipboardHistory.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <!-- The shared subtitle reads "...in Windows clipboard history", which means nothing
                   on this desktop; the Linux override is the same sentence without the noun. -->
              <TextBlock Text="{ReflectionBinding [linux.settings.output.hideClipboardHistory.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Windows draws two lines in this row and no third. Enforcement here still depends on
                 the desktop and the clipboard backend, so that caveat is the switch's tooltip
                 rather than a Linux-only third line. -->
            <CheckBox Grid.Column="1" x:Name="SettingsHideClipboardHistory" IsChecked="{Binding Settings.HideFromClipboardHistory}" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding Settings.ClipboardHistoryPrivacyStatus}"/>
          </Grid>
        </StackPanel></Border>

        <!-- Windows ends the page at the Clipboard card. The Linux-only row that used to follow
             it is gone: word timestamps are stored unconditionally here, exactly as Windows stores
             them, and a per-transcription language is picked in the mode editor, which is the
             only place Windows has a language control either. -->
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- LOCAL API
         The only settings page Windows draws at 720 rather than 560, and the only one with tabs:
         a status card, then a Connection / MCP setup / cURL strip whose whole body is hidden
         until the server is switched on. The Windows blurb names %LOCALAPPDATA%, so the Linux
         one names the XDG data directory the discovery file is really written to. -->
    <DataTemplate DataType="vm:LocalApiSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="LocalApiScreen" MaxWidth="720">
        <TextBlock Text="{ReflectionBinding [settings.localApi.title], Source={StaticResource Localization}}"
                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
        <TextBlock Text="{ReflectionBinding [linux.localApi.blurb], Source={StaticResource Localization}}"
                   Classes="rowSubtitle large" Margin="4,8,4,20"/>

        <!-- Status card: the switch FIRST, then the state, then Docs hard right. -->
        <Border Classes="card" Padding="14,12" Margin="0,0,0,20">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <CheckBox x:Name="SettingsLocalApiEnabled" Margin="0,0,14,0" VerticalAlignment="Center"
                      IsChecked="{Binding Settings.LocalApiEnabled}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SettingsLocalApiEnabledLabel" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource HwTextPrimaryBrush}"
                         Text="{ReflectionBinding [settings.localApi.toggle.disabled], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsLocalApiStatus" Classes="smallLabel" Margin="0,2,0,0"
                         Text="{ReflectionBinding [settings.localApi.status.idle], Source={StaticResource Localization}}"/>
            </StackPanel>
            <!-- Windows draws this one 69x35, not at the compact size the reveal and port-file
                 buttons take; at Padding 10,3 it came out 24 tall and read as squashed. -->
            <Button Grid.Column="2" x:Name="SettingsLocalApiDocsButton" Click="OnOpenLocalApiDocs"
                    Height="35" MinHeight="35" Padding="12,0" VerticalContentAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource HwIconOpenExternal}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.localApi.docs], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Windows' ActionStatusText: one shared line between the status card and the tab strip,
             so it stays visible whichever tab is showing. It reports what a Copy or Regenerate
             actually did; Linux used to report only failures, and only into the page's own status
             line at the very bottom. It never auto-hides on Windows either; the next action
             replaces it. The negative top margin closes the gap the card below already leaves. -->
        <TextBlock x:Name="LocalApiActionStatus" FontSize="11" TextWrapping="Wrap"
                   Margin="0,-8,0,14" IsVisible="False"/>

        <StackPanel x:Name="LocalApiTabsRoot" IsVisible="{Binding Settings.LocalApiEnabled}">
          <Border Classes="tabStrip"><StackPanel Orientation="Horizontal" Margin="4,0,0,0">
            <Button Classes="tab" Tag="connection" Margin="0,0,22,0" Click="OnLocalApiTab">
              <StackPanel>
                <TextBlock x:Name="LocalApiTabConnectionLabel" FontSize="13"
                           Foreground="{DynamicResource HwTextPrimaryBrush}"
                           Text="{ReflectionBinding [settings.localApi.tab.connection], Source={StaticResource Localization}}"/>
                <Rectangle x:Name="LocalApiTabConnectionRule" Height="2" Margin="0,4,0,0" Fill="{DynamicResource HwAccentBrush}"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Tag="mcp" Margin="0,0,22,0" Click="OnLocalApiTab">
              <StackPanel>
                <TextBlock x:Name="LocalApiTabMcpLabel" FontSize="13"
                           Foreground="{DynamicResource HwTextSecondaryBrush}"
                           Text="{ReflectionBinding [settings.localApi.tab.mcp], Source={StaticResource Localization}}"/>
                <Rectangle x:Name="LocalApiTabMcpRule" Height="2" Margin="0,4,0,0" Fill="Transparent"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Tag="curl" Click="OnLocalApiTab">
              <StackPanel>
                <TextBlock x:Name="LocalApiTabCurlLabel" FontSize="13"
                           Foreground="{DynamicResource HwTextSecondaryBrush}"
                           Text="{ReflectionBinding [settings.localApi.tab.curl], Source={StaticResource Localization}}"/>
                <Rectangle x:Name="LocalApiTabCurlRule" Height="2" Margin="0,4,0,0" Fill="Transparent"/>
              </StackPanel>
            </Button>
          </StackPanel></Border>

          <!-- Connection: three 100/*/Auto rows, an 11px secondary label against a 13px or
               monospaced value, and 8/8 rules between them. -->
          <Border x:Name="LocalApiConnectionTab" Classes="card" Padding="14,12"><StackPanel>
            <Grid ColumnDefinitions="100,*,Auto">
              <TextBlock Classes="smallLabel" VerticalAlignment="Center"
                         Text="{ReflectionBinding [settings.localApi.row.port], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsLocalApiBoundPort" Grid.Column="1" Margin="12,0,0,0" FontSize="13"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource HwTextPrimaryBrush}"/>
              <Button Grid.Column="2" Classes="compact" Click="OnCopyLocalApiPort"
                      Content="{ReflectionBinding [settings.localApi.copy], Source={StaticResource Localization}}"/>
            </Grid>
            <Border Classes="divider tight"/>
            <Grid ColumnDefinitions="100,*,Auto">
              <TextBlock Classes="smallLabel" VerticalAlignment="Center"
                         Text="{ReflectionBinding [settings.localApi.row.token], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsLocalApiToken" Grid.Column="1" Margin="12,0,0,0" Classes="monoValue"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SettingsLocalApiReveal" Classes="compact" Margin="0,0,6,0" Click="OnRevealLocalApiToken"
                        Content="{ReflectionBinding [settings.localApi.reveal], Source={StaticResource Localization}}"/>
                <Button Classes="compact" Margin="0,0,6,0" Click="OnCopyLocalApiToken"
                        Content="{ReflectionBinding [settings.localApi.copy], Source={StaticResource Localization}}"/>
                <!-- Regenerate is an icon button on Windows: it is destructive and should not
                     read as loudly as Copy. -->
                <Button Width="30" Height="26" Padding="0" MinHeight="0" MinWidth="0" Click="OnRegenerateLocalApiToken"
                        ToolTip.Tip="{ReflectionBinding [settings.localApi.regenerate], Source={StaticResource Localization}}">
                  <Path Data="{StaticResource HwIconRefresh}" Fill="{DynamicResource HwTextPrimaryBrush}" Stretch="Uniform"
                        Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
              </StackPanel>
            </Grid>
            <Border Classes="divider tight"/>
            <Grid ColumnDefinitions="100,*,Auto">
              <TextBlock Classes="smallLabel" VerticalAlignment="Center"
                         Text="{ReflectionBinding [settings.localApi.row.portFile], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsLocalApiDiscoveryPath" Grid.Column="1" Margin="12,0,0,0" Classes="monoValue"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="compact" x:Name="SettingsLocalApiShowPortFile" Click="OnShowLocalApiPortFile"
                      Content="{ReflectionBinding [settings.localApi.show], Source={StaticResource Localization}}"/>
            </Grid>
            <Border Classes="divider tight"/>
            <!-- Linux-only: the preferred port the server tries before falling back. It takes the
                 same 11px secondary label as the rows above so it does not shout over them. -->
            <Grid ColumnDefinitions="100,*,Auto">
              <TextBlock Classes="smallLabel" VerticalAlignment="Center"
                         Text="{ReflectionBinding [linux.ui.preferred.port.falls.back.to.an.available.loopback.port], Source={StaticResource Localization}}"/>
              <NumericUpDown Grid.Column="2" x:Name="SettingsLocalApiPort" Width="140" Minimum="0" Maximum="65535"
                             Value="{Binding Settings.LocalApiPort}"/>
            </Grid>
            <TextBlock Classes="smallLabel" Margin="0,12,0,0"
                       Text="{ReflectionBinding [settings.localApi.helperAuth], Source={StaticResource Localization}}"/>
          </StackPanel></Border>

          <Border x:Name="LocalApiMcpTab" Classes="card" Padding="14,12" IsVisible="False"><StackPanel>
            <TextBlock Classes="smallLabel" Margin="0,0,0,10"
                       Text="{ReflectionBinding [linux.settings.localApi.mcp.caption], Source={StaticResource Localization}}"/>
            <Border Classes="inset">
              <TextBox x:Name="SettingsLocalApiMcpSnippet" Classes="snippet" AcceptsReturn="True" IsReadOnly="True"/>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
              <Button Classes="linkAccent" VerticalAlignment="Center" Click="OnOpenLocalApiMcpGuide"
                      Content="{ReflectionBinding [settings.localApi.mcp.guide], Source={StaticResource Localization}}"/>
              <Button Grid.Column="1" Classes="compact" Click="OnCopyLocalApiMcpSnippet"
                      Content="{ReflectionBinding [settings.localApi.copy], Source={StaticResource Localization}}"/>
            </Grid>
          </StackPanel></Border>

          <Border x:Name="LocalApiCurlTab" Classes="card" Padding="14,12" IsVisible="False"><StackPanel>
            <TextBlock Classes="smallLabel" Margin="0,0,0,10"
                       Text="{ReflectionBinding [settings.localApi.curl.caption], Source={StaticResource Localization}}"/>
            <Border Classes="inset">
              <TextBox x:Name="SettingsLocalApiCurlSnippet" Classes="snippet" AcceptsReturn="True" IsReadOnly="True"/>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
              <Button Grid.Column="1" Classes="compact" Click="OnCopyLocalApiCurlSnippet"
                      Content="{ReflectionBinding [settings.localApi.copy], Source={StaticResource Localization}}"/>
            </Grid>
          </StackPanel></Border>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- SHORTCUTS
         A conflict banner, then a Global Shortcuts card whose four rows are split by 14/14 rules
         and end in a 240px recorder, then a Push to Talk card that draws NO rules at all — its
         rows are separated by Margin 0,14,0,0 only, because each one appears and disappears with
         the mode above it and a rule would be left hanging. -->
    <DataTemplate DataType="vm:ShortcutsSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="ShortcutsScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.section.shortcuts], Source={StaticResource Localization}}" Classes="pageTitle"/>

        <!-- The conflict state lives on the Home view model, which owns the registration result;
             this page re-presents it rather than keeping a second copy. -->
        <Border Classes="warningBanner" IsVisible="{ReflectionBinding $parent[Window].DataContext.Home.HasShortcutConflicts}">
          <StackPanel>
            <TextBlock Text="{ReflectionBinding [linux.home.conflict.title], Source={StaticResource Localization}}"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource HwWarningForegroundBrush}"/>
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Home.ShortcutConflictMessage}"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource HwWarningForegroundBrush}"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,240">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.toggle.label], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SettingsToggleKey" Classes="shortcutBox" Tag="toggle" IsReadOnly="True"
                       KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                       ToolTip.Tip="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsToggleKeyError" Classes="shortcutError"/>
            </StackPanel>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,240">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.cancel.label], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SettingsCancelKey" Classes="shortcutBox" Tag="cancel" IsReadOnly="True"
                       KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                       ToolTip.Tip="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsCancelKeyError" Classes="shortcutError"/>
            </StackPanel>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,240">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.changeMode.label], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SettingsChangeModeKey" Classes="shortcutBox" Tag="changeMode" IsReadOnly="True"
                       KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                       ToolTip.Tip="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsChangeModeKeyError" Classes="shortcutError"/>
            </StackPanel>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,240">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.streaming.label], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SettingsStreamingShortcutKey" Classes="shortcutBox" Tag="streaming" IsReadOnly="True"
                       KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                       ToolTip.Tip="{ReflectionBinding [settings.shortcuts.tooltip], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsStreamingShortcutKeyError" Classes="shortcutError"/>
            </StackPanel>
          </Grid>
        </StackPanel></Border>

        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,200">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Windows lists three localized options against the raw enum names the settings
                 file stores, so the item carries the value on its Tag and code behind maps it. -->
            <ComboBox Grid.Column="1" x:Name="SettingsPushToTalkMode" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      SelectionChanged="OnPushToTalkModeChanged">
              <ComboBoxItem Tag="Disabled" Content="{ReflectionBinding [settings.shortcuts.mode.disabled], Source={StaticResource Localization}}"/>
              <ComboBoxItem Tag="Modifier" Content="{ReflectionBinding [settings.shortcuts.mode.modifier], Source={StaticResource Localization}}"/>
              <ComboBoxItem Tag="CustomShortcut" Content="{ReflectionBinding [settings.shortcuts.mode.custom], Source={StaticResource Localization}}"/>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,200" Margin="0,14,0,0" IsVisible="{Binding Settings.PushToTalkUsesModifier}">
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Classes="rowTitle"
                       Text="{ReflectionBinding [settings.shortcuts.pushToTalk.modifier.label], Source={StaticResource Localization}}"/>
            <ComboBox Grid.Column="1" x:Name="SettingsPushToTalkModifier" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      SelectionChanged="OnPushToTalkModifierChanged">
              <ComboBoxItem Tag="LeftAlt" Content="{ReflectionBinding [keyboard.leftAlt], Source={StaticResource Localization}}"/>
              <ComboBoxItem Tag="RightAlt" Content="{ReflectionBinding [keyboard.rightAlt], Source={StaticResource Localization}}"/>
              <ComboBoxItem Tag="Shift" Content="{ReflectionBinding [keyboard.shift], Source={StaticResource Localization}}"/>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,200" Margin="0,14,0,0" IsVisible="{Binding Settings.PushToTalkUsesCustomShortcut}">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.custom.label], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.custom.tooltip], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SettingsPushToTalkCustomKey" Classes="shortcutBox" Tag="pushToTalk" IsReadOnly="True"
                       KeyDown="OnShortcutBoxKeyDown" KeyUp="OnShortcutBoxKeyUp" GotFocus="OnShortcutBoxGotFocus"
                       ToolTip.Tip="{ReflectionBinding [settings.shortcuts.pushToTalk.custom.tooltip], Source={StaticResource Localization}}"/>
              <TextBlock x:Name="SettingsPushToTalkCustomKeyError" Classes="shortcutError"/>
            </StackPanel>
          </Grid>
          <!-- Modifier mode only. Windows shows the double-press row under the Modifier branch of
               ShortcutsSettingsPage and nowhere else; PushToTalkIsEnabled is also true for
               CustomShortcut, where a double press has nothing to lock. -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0" IsVisible="{Binding Settings.PushToTalkUsesModifier}">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.doublePress], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.shortcuts.pushToTalk.doublePress.subtitle], Source={StaticResource Localization}}" Classes="caption" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="SettingsPushToTalkDoubleLock" IsChecked="{Binding Settings.PushToTalkDoublePressLock}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel></Border>
        <Button x:Name="SettingsResetShortcuts" Content="{ReflectionBinding [settings.shortcuts.reset.button], Source={StaticResource Localization}}" Command="{Binding Settings.ResetShortcutsCommand}" HorizontalAlignment="Left" Click="OnShortcutsReset"/>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- APPEARANCE
         Windows draws ONE card here: a 16px "Theme" heading, a 13px subtitle and three filled,
         selectable tiles. There is no rule under the heading and no second card — the local
         Whisper and LLM backend pickers Linux used to keep here are runtime choices about
         models, so they moved to the end of the Model Library page. -->
    <DataTemplate DataType="vm:AppearanceSettingsViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="AppearanceScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.appearance.title], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card"><StackPanel>
          <TextBlock Text="{ReflectionBinding [settings.appearance.theme.title], Source={StaticResource Localization}}" Classes="cardTitle"/>
          <TextBlock Text="{ReflectionBinding [settings.appearance.theme.subtitle], Source={StaticResource Localization}}" Classes="cardSubtitle"/>
          <!-- The whole tile is the hit target on Windows, not just the radio. -->
          <Border Classes="themeTile" PointerPressed="OnThemeTilePressed"><Grid ColumnDefinitions="Auto,*">
            <RadioButton x:Name="SettingsThemeMode" GroupName="ThemeMode" VerticalAlignment="Center" Margin="0,0,2,0"
                         IsChecked="{Binding Settings.ThemeIsSystem, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.appearance.theme.system], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <!-- The shared string names Windows ("based on Windows settings"), which is wrong
                   on this desktop; the Linux catalogue names the desktop theme setting instead. -->
              <TextBlock Text="{ReflectionBinding [linux.appearance.theme.system.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
          </Grid></Border>
          <Border Classes="themeTile" PointerPressed="OnThemeTilePressed"><Grid ColumnDefinitions="Auto,*">
            <RadioButton GroupName="ThemeMode" VerticalAlignment="Center" Margin="0,0,2,0"
                         IsChecked="{Binding Settings.ThemeIsLight, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.appearance.theme.light], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.appearance.theme.light.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
          </Grid></Border>
          <Border Classes="themeTile last" PointerPressed="OnThemeTilePressed"><Grid ColumnDefinitions="Auto,*">
            <RadioButton GroupName="ThemeMode" VerticalAlignment="Center" Margin="0,0,2,0"
                         IsChecked="{Binding Settings.ThemeIsDark, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{ReflectionBinding [settings.appearance.theme.dark], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.appearance.theme.dark.subtitle], Source={StaticResource Localization}}" Classes="caption"/>
            </StackPanel>
          </Grid></Border>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- Model library. The third column draws the same two five-segment gauges Windows does; the
         ratings behind them are no longer a Windows-only C# table but ModelRatings in the shared
         HyperWhisper.Application project, which both heads read. Use for live transcription and
         Refresh readiness have no Windows button: they live in the row's context menu. -->
    <DataTemplate DataType="vm:ModelLibraryViewModel">
      <!-- MODEL LIBRARY
           Windows scrolls the whole page as one and caps it at 720 centred, so the search pill,
           the filter strip, the table card, the legend and the endpoints card all move together
           rather than the table scrolling under a pinned header. -->
      <ScrollViewer Classes="page"><StackPanel x:Name="ModelsScreen" MaxWidth="720">

        <!-- Search pill: a glyph, a bare field, the clearable chips for whatever filters are on,
             and the funnel that opens the checkable Type / Location / Features menu. -->
        <Border Classes="searchPill">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Path Data="{StaticResource HwIconSearch}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                  Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="ModelSearch" Classes="bare" FontSize="13" Text="{Binding SearchText}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Border Classes="filterChip" IsVisible="{Binding WorkloadFilter, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding WorkloadFilter}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <Button Classes="rowIcon" Width="14" Height="14" Margin="6,0,0,0" Click="OnModelClearWorkloadFilter"
                          ToolTip.Tip="{ReflectionBinding [linux.models.filter.clear], Source={StaticResource Localization}}">
                    <Path Data="{StaticResource HwIconClose}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="8" Height="8"/>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="filterChip" IsVisible="{Binding DeploymentFilter, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding DeploymentFilter}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <Button Classes="rowIcon" Width="14" Height="14" Margin="6,0,0,0" Click="OnModelClearDeploymentFilter"
                          ToolTip.Tip="{ReflectionBinding [linux.models.filter.clear], Source={StaticResource Localization}}">
                    <Path Data="{StaticResource HwIconClose}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="8" Height="8"/>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="filterChip" IsVisible="{Binding VocabularyFilter}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [linux.models.chip.vocabulary], Source={StaticResource Localization}}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <Button Classes="rowIcon" Width="14" Height="14" Margin="6,0,0,0" Click="OnModelClearVocabularyFilter"
                          ToolTip.Tip="{ReflectionBinding [linux.models.filter.clear], Source={StaticResource Localization}}">
                    <Path Data="{StaticResource HwIconClose}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="8" Height="8"/>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="filterChip" IsVisible="{Binding CloudAvailableFilter}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{ReflectionBinding [linux.models.chip.cloud], Source={StaticResource Localization}}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <Button Classes="rowIcon" Width="14" Height="14" Margin="6,0,0,0" Click="OnModelClearCloudFilter"
                          ToolTip.Tip="{ReflectionBinding [linux.models.filter.clear], Source={StaticResource Localization}}">
                    <Path Data="{StaticResource HwIconClose}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="8" Height="8"/>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
            <Button Grid.Column="3" x:Name="ModelFilterButton" Classes="rowIcon" Width="22" Height="22" Margin="8,0,0,0"
                    Click="OnModelFilterMenu" ToolTip.Tip="{ReflectionBinding [linux.models.filter.title], Source={StaticResource Localization}}">
              <Path Data="{StaticResource HwIconFilter}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13"/>
            </Button>
          </Grid>
        </Border>

        <!-- Filter strip: the provider menu on the left, the language menu with its count and a
             Show all link in the middle, and the API keys button hard right. -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
          <Button x:Name="ModelProviderButton" Classes="filterButton" Click="OnModelProviderMenu">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ProviderFilter}" FontSize="12" VerticalAlignment="Center"/>
              <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
            <Button x:Name="ModelLanguageButton" Classes="filterButton" Click="OnModelLanguageMenu">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource HwIconGlobe}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding LanguageFilterLabel}" FontSize="12" VerticalAlignment="Center"/>
                <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding LanguageCountText}" IsVisible="{Binding HasLanguageFilter}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
            <Button Classes="linkAccent" Margin="8,0,0,0" IsVisible="{Binding HasLanguageFilter}" Click="OnModelClearLanguageFilter"
                    Content="{ReflectionBinding [linux.models.language.showAll], Source={StaticResource Localization}}"/>
          </StackPanel>
          <Button Grid.Column="2" x:Name="ModelCredentialButton" Classes="filterButton" Click="OnModelCredentialAction">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource HwIconKey}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                    Width="13" Height="13" VerticalAlignment="Center"/>
              <TextBlock Text="{ReflectionBinding [linux.ui.api.keys], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- One card: the sortable header row, a 1px divider, the rows and the empty state. -->
        <Border Classes="tableCard" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="14,8" ColumnDefinitions="*,64,120,210">
              <Button Classes="sortHeader" Click="OnModelSortByName">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="columnHeader" Text="{ReflectionBinding [linux.ui.column.model.name], Source={StaticResource Localization}}"/>
                  <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="9" Height="9" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding SortedByName}"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="sortHeader" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="OnModelSortByType">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="columnHeader" Text="{ReflectionBinding [linux.ui.column.type], Source={StaticResource Localization}}"/>
                  <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="9" Height="9" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding SortedByType}"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="sortHeader" Click="OnModelSortByRating">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="columnHeader" Text="{ReflectionBinding [linux.ui.column.rating], Source={StaticResource Localization}}"/>
                  <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="9" Height="9" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding SortedByRating}"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="3" Classes="sortHeader" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Click="OnModelSortByLocation">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="columnHeader" Text="{ReflectionBinding [linux.ui.column.location], Source={StaticResource Localization}}"/>
                  <Path Data="{StaticResource HwIconChevronDown}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                        Width="9" Height="9" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding SortedByLocation}"/>
                </StackPanel>
              </Button>
            </Grid>
            <Border Height="1" Background="{DynamicResource HwBorderBrush}"/>

            <ListBox x:Name="ModelList" Classes="plain flush noselect" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,0,1">
                    <!-- The row grid has to repeat the header's columns exactly. It carried 168 in the
                         last column against the header's 210, to win the name back 42px, but a Grid
                         gives the slack to the star column, so every column after it (Type,
                         Readiness, Location) moved 42px right of the header it belongs under, and
                         the Type glyph landed at x617 against Windows' x576. Windows uses *,64,120,210
                         in both grids (ModelsSettingsPage.xaml:292-295 and :386-389) and so does this.

                         The vertical margin is 8, not 8.5. Layout rounding collapsed the half pixel,
                         so the row measured 49 against Windows' 50; the missing pixel was really the
                         short line box, and the Windows line height now sizes the name/provider stack
                         to the 33px that puts the row at 8+33+8+1. -->
                    <Grid Margin="14,8" ColumnDefinitions="*,64,120,210" ToolTip.Tip="{Binding DetailToolTip}">
                      <Grid ColumnDefinitions="Auto,*">
                        <!-- The provider's own mark, not one generic glyph on all 80-odd rows.
                             The PNGs are the Windows app's, linked into this csproj as
                             AvaloniaResource rather than copied. A provider with no PNG (Meta)
                             falls back to a letter monogram, which is what Windows draws too;
                             HasProviderAsset, not a null image, decides which one shows. -->
                        <Border Width="32" Height="32" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{DynamicResource HwInputBackgroundBrush}">
                          <Panel>
                            <Image Width="22" Height="22" IsVisible="{Binding HasProviderAsset}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Source="{Binding ProviderAssetName, Converter={StaticResource ProviderLogoConverter}}"/>
                            <TextBlock Text="{Binding ProviderMonogram}" FontSize="15" FontWeight="SemiBold"
                                       IsVisible="{Binding !HasProviderAsset}" Foreground="#1877F2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Panel>
                        </Border>
                        <!-- UseLayoutRounding is off for this one stack. Windows sizes it to
                             17.29 + 1 + 14.63 = 32.92 and the row to 8+32.92+8+1 = 49.92, which
                             paints a 50px pitch. Avalonia rounds each line box up on its own
                             (18 and 15), so the same stack measured 34 and the row 51, and by row
                             8 the list had drifted 7px. Rounding off, the stack keeps the
                             fractional height and only the row border rounds, as WPF does.
                             Scoped here: text lays out on subpixels anyway, and the 1px column
                             rules outside this stack keep their own rounding. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" UseLayoutRounding="False">
                          <!-- The name takes the slack and ellipsises, so the pill always sits
                               inside the column instead of running under the Type glyph. -->
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" MaxWidth="280"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                            <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasTag}">
                              <TextBlock Text="{Binding TagText}" FontSize="10" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                            </Border>
                          </Grid>
                          <!-- Provider alone on the sub-line. Windows draws no runtime chip here;
                               the runtime stays on the row tooltip. -->
                          <TextBlock Text="{Binding ProviderName}" FontSize="11" Margin="0,1,0,0"
                                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                        </StackPanel>
                      </Grid>
                      <Path Grid.Column="1" Data="{Binding KindGlyphKey, Converter={StaticResource IconKeyConverter}}"
                            Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding KindToolTip}"/>
                      <!-- Speed over accuracy, 4px apart, exactly as Windows stacks them
                           (ModelsSettingsPage.xaml:468-479). This column used to print the
                           readiness WORD here, which is the one thing the column is not: the
                           readiness already has the glyph in the last column and the row
                           tooltip. Both bars take their lit colour from the same GaugeBrushKey
                           so a locked or broken row greys or reddens as one. -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <local:GaugeBar Rating="{Binding Speed}" FilledBrushKey="{Binding GaugeBrushKey}"
                                        ToolTip.Tip="{ReflectionBinding [linux.ui.gauge.speed], Source={StaticResource Localization}}"/>
                        <local:GaugeBar Rating="{Binding Accuracy}" FilledBrushKey="{Binding GaugeBrushKey}" Margin="0,4,0,0"
                                        ToolTip.Tip="{ReflectionBinding [linux.ui.gauge.accuracy], Source={StaticResource Localization}}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Windows prints the download size here and leaves it blank for a cloud
                             model. The location itself is what the Cloud / Offline glyph column says. -->
                        <TextBlock Text="{Binding DownloadSizeText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                   TextAlignment="Right" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                        <Button MinHeight="30" MinWidth="92" Padding="8,5" Click="OnModelRowPrimaryAction" Tag="{Binding}">
                          <Grid ColumnDefinitions="14,Auto">
                            <Path Data="{Binding StatusGlyphKey, Converter={StaticResource IconKeyConverter}}"
                                  Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PrimaryActionText}" FontSize="12" Margin="6,0,0,0"
                                       MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          </Grid>
                        </Button>
                        <Button Classes="iconAction" Tag="{Binding}" IsVisible="{Binding CanCancelRow}" Click="OnModelRowCancel">
                          <Path Data="{StaticResource HwIconClose}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button Classes="iconAction" Tag="{Binding}" IsVisible="{Binding CanDelete}" Click="OnModelRowDelete">
                          <Path Data="{StaticResource HwIconTrash}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                      </StackPanel>
                      <ProgressBar Grid.ColumnSpan="4" Height="3" VerticalAlignment="Bottom" Margin="42,0,0,-8"
                                   Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" Margin="0,40" IsVisible="{Binding IsEmpty}">
              <TextBlock Text="{Binding EmptyStateText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                         MaxWidth="560" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
              <Button x:Name="ModelClearFiltersButton" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Center"
                      IsVisible="{Binding HasActiveFilters}" Click="OnModelClearFilters"
                      Content="{ReflectionBinding [settings.models.clearFilters], Source={StaticResource Localization}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Status legend: what the three row glyphs mean. -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
          <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
            <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwSuccessBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="{ReflectionBinding [linux.models.legend.enabled], Source={StaticResource Localization}}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
            <Path Data="{StaticResource HwIconLock}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="{ReflectionBinding [linux.models.legend.locked], Source={StaticResource Localization}}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource HwIconWarning}" Fill="{DynamicResource HwWarningBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="{ReflectionBinding [linux.models.legend.keyInvalid], Source={StaticResource Localization}}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>

        <Border Classes="card" Padding="12" Margin="0,0,0,14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{ReflectionBinding [linux.models.endpoints.title], Source={StaticResource Localization}}"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
              <TextBlock Text="{Binding CustomEndpointsSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                         Foreground="{DynamicResource HwTextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ModelAddEndpointButton" Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnModelAddEndpoint">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource HwIconPlus}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                      Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [linux.models.endpoints.add], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- The local runtime pickers. Windows has no equivalent anywhere, and the Linux app used
             to keep them as a second card on Appearance, which Windows draws as one Theme card and
             nothing else. They choose how a downloaded model actually runs, so the Model Library is
             where they belong. The rows bind past this page's own context to the shell. -->
        <Border Classes="card" Margin="0,0,0,14"><StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{ReflectionBinding [linux.ui.local.whisper.backend], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="SettingsLocalWhisperBackend" MinWidth="180"
                      ItemsSource="{ReflectionBinding $parent[Window].DataContext.Settings.LocalWhisperBackends}"
                      SelectedItem="{ReflectionBinding $parent[Window].DataContext.Settings.LocalWhisperBackend, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource OptionLabelConverter}, ConverterParameter=linux.settings.backend.}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{ReflectionBinding [linux.ui.fall.back.to.cpu.if.the.selected.whisper.gpu.runtime.cannot.start], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" x:Name="SettingsLocalWhisperCpuFallback" VerticalAlignment="Center"
                      IsChecked="{ReflectionBinding $parent[Window].DataContext.Settings.AllowLocalWhisperCpuFallback, Mode=TwoWay}"/>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{ReflectionBinding [linux.ui.local.llm.backend], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="SettingsLocalLlmBackend" MinWidth="180"
                      ItemsSource="{ReflectionBinding $parent[Window].DataContext.Settings.LocalLlmBackends}"
                      SelectedItem="{ReflectionBinding $parent[Window].DataContext.Settings.LocalLlmBackend, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource OptionLabelConverter}, ConverterParameter=linux.settings.backend.}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{ReflectionBinding [linux.ui.fall.back.to.cpu.if.gpu.model.loading.fails], Source={StaticResource Localization}}" Classes="rowTitle" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" x:Name="SettingsLocalLlmCpuFallback" VerticalAlignment="Center"
                      IsChecked="{ReflectionBinding $parent[Window].DataContext.Settings.AllowLocalLlmCpuFallback, Mode=TwoWay}"/>
          </Grid>
          <Border Classes="divider"/>
          <StackPanel Spacing="2">
            <TextBlock x:Name="SettingsLocalWhisperRuntimeStatus" Classes="caption"
                       Text="{ReflectionBinding $parent[Window].DataContext.Settings.LocalWhisperRuntimeStatus}"/>
            <TextBlock Classes="caption" Text="{ReflectionBinding $parent[Window].DataContext.Settings.LocalLlmRuntimeStatus}"/>
          </StackPanel>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- Backup. Windows shows one Export card, one Import card and a footnote; the Linux
         extras (inspect, preview, confirm) stay, but inside the same two cards. -->
    <DataTemplate DataType="vm:BackupViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="BackupScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.section.backup], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <!-- EXPORT. Windows sizes every descriptive line on this page at 12px, heads the section
             list at 12px SemiBold secondary, and keeps the card's own status text inside it. -->
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.backup.export.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.backup.export.subtitle], Source={StaticResource Localization}}" Classes="rowSubtitle" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackupExportButton" Classes="accent" Content="{ReflectionBinding [settings.backup.export.button], Source={StaticResource Localization}}" Click="OnExportBackup" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="divider mid"/>
          <TextBlock Text="{ReflectionBinding [settings.backup.export.sections.header], Source={StaticResource Localization}}"
                     Classes="smallLabel semi" Margin="0,0,0,6"/>
          <CheckBox x:Name="BackupExportSettings" Margin="0,0,0,4" Content="{ReflectionBinding [settings.backup.export.section.settings], Source={StaticResource Localization}}" IsChecked="{Binding ExportSettings}"/>
          <CheckBox x:Name="BackupExportModes" Margin="0,0,0,4" Content="{ReflectionBinding [settings.backup.export.section.modes], Source={StaticResource Localization}}" IsChecked="{Binding ExportModes}"/>
          <!-- Windows carries the word count in the label on both sides of the page. -->
          <CheckBox x:Name="BackupExportVocabulary" Margin="0,0,0,4" IsChecked="{Binding ExportVocabulary}"
                    Content="{ReflectionBinding $parent[Window].DataContext.Vocabulary.Items.Count, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=settings.backup.export.section.vocabulary}"/>
          <Border Classes="divider mid"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.backup.export.includeApiKeys], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.backup.export.apiKeysWarning], Source={StaticResource Localization}}" Classes="rowSubtitle" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="BackupExportApiKeys" IsChecked="{Binding ExportCredentials}" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel IsVisible="{Binding ExportCredentials}" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding PlaintextCredentialWarning}" Classes="rowSubtitle" Foreground="{DynamicResource HwWarningBrush}"/>
            <CheckBox x:Name="BackupAcknowledgePlaintextApiKeys" Content="{ReflectionBinding [linux.ui.i.understand.this.backup.will.contain.plaintext.api.keys], Source={StaticResource Localization}}" IsChecked="{Binding PlaintextCredentialExportAcknowledged}"/>
          </StackPanel>
        </StackPanel></Border>

        <!-- IMPORT. The Windows selection panel opens with "This file contains:" and ends with
             the apply button at Margin 0,12,0,0; the Linux inspect/preview/confirm steps keep
             their place inside it and take the same row treatment. -->
        <Border Classes="card" Margin="0,0,0,20"><StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{ReflectionBinding [settings.backup.import.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.backup.import.subtitle], Source={StaticResource Localization}}" Classes="rowSubtitle" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackupChooseImportButton" Classes="accent" Content="{ReflectionBinding [settings.backup.import.chooseFile], Source={StaticResource Localization}}" Click="OnChooseBackup" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel IsVisible="{Binding HasInspectedBackup}">
            <Border Classes="divider mid"/>
            <TextBlock Text="{ReflectionBinding [settings.backup.import.contains], Source={StaticResource Localization}}"
                       Classes="smallLabel semi" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ContentsSummary}" Classes="rowSubtitle" Margin="0,0,0,8"/>
            <CheckBox x:Name="BackupImportSettings" Margin="0,0,0,4" Content="{ReflectionBinding [settings.backup.import.section.settings], Source={StaticResource Localization}}" IsChecked="{Binding ImportSettings}"/>
            <CheckBox x:Name="BackupImportModes" Margin="0,0,0,4" Content="{ReflectionBinding [settings.backup.import.section.modes], Source={StaticResource Localization}}" IsChecked="{Binding ImportModes}"/>
            <CheckBox x:Name="BackupImportVocabulary" Margin="0,0,0,4" IsChecked="{Binding ImportVocabulary}"
                      Content="{Binding Contents.VocabularyCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=settings.backup.import.section.vocabulary}"/>
            <CheckBox x:Name="BackupImportApiKeys" Margin="0,0,0,4" Content="{ReflectionBinding [settings.backup.import.section.apiKeys], Source={StaticResource Localization}}" IsChecked="{Binding ImportCredentials}" IsVisible="{Binding ContainsImportableCredentials}"/>
            <CheckBox x:Name="BackupReplaceAllModes" Margin="0,0,0,4" Content="{ReflectionBinding [linux.ui.replace.all.modes.uncheck.to.merge.only.selected.modes], Source={StaticResource Localization}}" IsChecked="{Binding ReplaceAllModes}"/>
            <ItemsControl ItemsSource="{Binding ImportModeSelections}" IsVisible="{Binding ImportModes}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="20,2,0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Margin="20,6,0,0">
              <TextBlock Text="{ReflectionBinding [settings.backup.import.vocabConflict.header], Source={StaticResource Localization}}"
                         Classes="rowSubtitle" Margin="0,0,0,4"/>
              <RadioButton x:Name="BackupVocabularySkip" GroupName="VocabularyConflict" Margin="0,0,0,2" Content="{ReflectionBinding [settings.backup.import.vocabConflict.skip], Source={StaticResource Localization}}" IsChecked="{Binding SkipVocabularyConflicts}"/>
              <RadioButton x:Name="BackupVocabularyReplace" GroupName="VocabularyConflict" Content="{ReflectionBinding [settings.backup.import.vocabConflict.replace], Source={StaticResource Localization}}" IsChecked="{Binding ReplaceVocabularyConflicts}"/>
            </StackPanel>
            <Button x:Name="BackupPreviewButton" Margin="0,12,0,0" HorizontalAlignment="Right"
                    Content="{ReflectionBinding [linux.ui.preview.selected.import], Source={StaticResource Localization}}" Command="{Binding PreviewCommand}"/>
            <TextBlock Text="{Binding PreviewSummary}" Classes="rowSubtitle" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0"><TextBlock Classes="caption" Text="{Binding PreviewModesAdded, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.modes.added.value}"/><TextBlock Grid.Column="1" Classes="caption" Text="{Binding PreviewModesReplaced, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.modes.replaced.value}"/><TextBlock Grid.Column="2" Classes="caption" Text="{Binding PreviewModesRemoved, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.modes.removed.value}"/></Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,2,0,0"><TextBlock Classes="caption" Text="{Binding PreviewVocabularyAdded, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.added.value}"/><TextBlock Grid.Column="1" Classes="caption" Text="{Binding PreviewVocabularyReplaced, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.replaced.value}"/><TextBlock Grid.Column="2" Classes="caption" Text="{Binding PreviewVocabularySkipped, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.skipped.value}"/></Grid>
            <CheckBox x:Name="BackupConfirmImport" Margin="0,8,0,0" Content="{ReflectionBinding [linux.ui.i.reviewed.this.preview.and.confirm.these.changes], Source={StaticResource Localization}}" IsChecked="{Binding ImportConfirmed}"/>
            <Button x:Name="BackupImportButton" Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Right"
                    Content="{ReflectionBinding [settings.backup.import.applyButton], Source={StaticResource Localization}}" Command="{Binding ImportCommand}"/>
          </StackPanel>
        </StackPanel></Border>

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
          <Path Data="{StaticResource HwIconInfo}" Fill="{DynamicResource HwTextSecondaryBrush}" Stretch="Uniform"
                Width="12" Height="12" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <TextBlock Grid.Column="1" Text="{ReflectionBinding [settings.backup.notice], Source={StaticResource Localization}}" Classes="rowSubtitle"/>
        </Grid>

        <!-- Windows ends the page at that footnote and draws nothing after it. The Linux-only
             card that used to sit here is gone: vocabulary now travels in the backup file itself,
             through the Vocabulary checkbox both cards above already carry, and choosing an
             archive inspects it the way the Windows Choose File... button does. -->
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- HYPERWHISPER CLOUD
         Windows draws TWO sibling views over one header and shows exactly one of them. Licensed
         is balance + account information + actions; unlicensed is the activation card and the
         Get Credits call to action, and nothing else. Linux used to show every card at once,
         which put an account card with no account above an activation field. -->
    <DataTemplate DataType="vm:CloudAccountViewModel">
      <!-- Stretch, not Left: hugging its content made the two cards 517 wide where every other
           settings page draws a 519-wide card. -->
      <ScrollViewer x:Name="AccountScreen" Classes="page">
        <StackPanel MaxWidth="560">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="4">
              <TextBlock Text="{ReflectionBinding [settings.nav.cloud], Source={StaticResource Localization}}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
              <TextBlock Text="{ReflectionBinding [settings.credits.subtitle], Source={StaticResource Localization}}" Classes="caption" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- The icon-only refresh Windows pins to the top right of the licensed header. -->
            <Button Grid.Column="1" x:Name="AccountStatusRefreshButton" Width="34" Height="32" Padding="0"
                    VerticalAlignment="Top" Margin="12,2,0,0" IsVisible="{Binding IsActiveAccount}"
                    Command="{Binding RefreshCreditsCommand}"
                    ToolTip.Tip="{ReflectionBinding [settings.credits.refresh], Source={StaticResource Localization}}">
              <Path Data="{StaticResource HwIconRefresh}" Fill="{DynamicResource HwTextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
          </Grid>

          <!-- LICENSED VIEW -->
          <StackPanel IsVisible="{Binding IsActiveAccount}">
            <Border Classes="card" Margin="0,0,0,20"><StackPanel>
              <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40" IsVisible="{Binding ShowCreditsLoading}">
                <TextBlock Text="{ReflectionBinding [settings.credits.loading], Source={StaticResource Localization}}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
              </StackPanel>
              <Border Background="{DynamicResource HwErrorBackgroundBrush}" BorderBrush="{DynamicResource HwErrorBorderBrush}"
                      BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,16" IsVisible="{Binding HasCreditsError}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{ReflectionBinding [settings.credits.error.title], Source={StaticResource Localization}}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource HwErrorForegroundBrush}"/>
                  <Button Grid.Column="1" Classes="accent" Margin="12,0,0,0" Padding="12,4"
                          Content="{ReflectionBinding [common.retry], Source={StaticResource Localization}}" Command="{Binding RefreshCreditsCommand}"/>
                </Grid>
              </Border>
              <StackPanel IsVisible="{Binding HasCredits}">
                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,16">
                  <TextBlock Text="{Binding MinutesRemaining}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                  <TextBlock Text="{ReflectionBinding [settings.credits.minutesRemaining], Source={StaticResource Localization}}" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding DollarBalance}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                </StackPanel>
                <Border Background="{DynamicResource HwWarningBackgroundBrush}" BorderBrush="{DynamicResource HwWarningBorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,16" IsVisible="{Binding IsCreditsLow}">
                  <TextBlock Text="{ReflectionBinding [linux.settings.credits.lowWarning], Source={StaticResource Localization}}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource HwWarningForegroundBrush}"/>
                </Border>
                <Border Background="{DynamicResource HwErrorBackgroundBrush}" BorderBrush="{DynamicResource HwErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,16" IsVisible="{Binding IsCreditsExhausted}">
                  <TextBlock Text="{ReflectionBinding [linux.settings.credits.exhaustedWarning], Source={StaticResource Localization}}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource HwErrorForegroundBrush}"/>
                </Border>
              </StackPanel>
            </StackPanel></Border>

            <Border Classes="card" Margin="0,0,0,20"><StackPanel>
              <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.title], Source={StaticResource Localization}}" Classes="rowTitle" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,0,0,12"/>
              <Border Height="1" Background="{DynamicResource HwBorderBrush}" Margin="0,0,0,16"/>
              <!-- Two columns, four rows: the last two rows span both columns, exactly as the
                   Windows stats grid does. Labels 12px secondary, values 13px Medium primary. -->
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <StackPanel Margin="0,0,8,12">
                  <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.credits], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding Credits}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                  <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.costPerMinute], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding CostPerMinute}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,8,12">
                  <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.accountType], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding AccountTypeLabel}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12" IsVisible="{Binding HasCustomerId}">
                  <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.customerId], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding CustomerId}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,8,12" IsVisible="{Binding HasCustomerEmail}">
                  <TextBlock Text="{ReflectionBinding [settings.cloud.account.email], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding CustomerEmail}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding HasDailyReset}">
                  <TextBlock Text="{ReflectionBinding [settings.credits.accountInfo.dailyReset], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock Text="{Binding DailyReset}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
                </StackPanel>
              </Grid>
              <!-- The wallet itself: masked key, a reveal button and a copy button, both 34x30. -->
              <Border Height="1" Background="{DynamicResource HwBorderBrush}" Margin="0,4,0,16"/>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{ReflectionBinding [settings.cloud.licenseKey], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}"/>
                  <TextBlock x:Name="AccountKeyValueText" Text="{Binding AccountKeyDisplay}" FontSize="13" FontWeight="Medium"
                             FontFamily="DejaVu Sans Mono, Liberation Mono, monospace"
                             Foreground="{DynamicResource HwTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="AccountKeyRevealButton" Width="34" Height="30" Padding="0"
                        Margin="8,0,0,0" VerticalAlignment="Center" Click="OnToggleAccountKeyReveal"
                        IsEnabled="{Binding HasStoredAccountKey}"
                        ToolTip.Tip="{ReflectionBinding [settings.cloud.key.reveal], Source={StaticResource Localization}}">
                  <Path Data="{StaticResource HwIconEye}" Fill="{DynamicResource HwTextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="2" x:Name="AccountKeyCopyButton" Width="34" Height="30" Padding="0"
                        Margin="8,0,0,0" VerticalAlignment="Center" Click="OnCopyAccountKey"
                        IsEnabled="{Binding HasStoredAccountKey}"
                        ToolTip.Tip="{ReflectionBinding [settings.cloud.key.copy], Source={StaticResource Localization}}">
                  <!-- Named so the copy handler can swap it to a checkmark for 1500ms, which is
                       the only confirmation Windows gives that the key reached the clipboard. -->
                  <Path x:Name="AccountKeyCopyGlyph" Data="{StaticResource HwIconCopy}" Fill="{DynamicResource HwTextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
                </Button>
              </Grid>
            </StackPanel></Border>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
              <Button Classes="accent" Content="{ReflectionBinding [settings.cloud.purchaseCredits], Source={StaticResource Localization}}" Command="{Binding PurchaseCommand}"/>
              <Button x:Name="AccountManageButton" Content="{ReflectionBinding [license.button.manageBilling], Source={StaticResource Localization}}" Command="{Binding ManageCommand}"/>
              <Button x:Name="AccountDeactivateButton" Content="{ReflectionBinding [license.button.deactivate], Source={StaticResource Localization}}" Click="OnDeactivateLicense"/>
            </StackPanel>
          </StackPanel>

          <!-- UNLICENSED VIEW -->
          <StackPanel IsVisible="{Binding IsUnlicensed}">
            <!-- A key that lapsed earns the reason it did, rather than a fresh-install screen. -->
            <Border Background="{DynamicResource HwWarningBackgroundBrush}" BorderBrush="{DynamicResource HwWarningBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,20" IsVisible="{Binding HasLicenseProblem}">
              <StackPanel>
                <TextBlock Text="{Binding AccountState}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource HwWarningForegroundBrush}"/>
                <TextBlock Text="{Binding CustomerEmail}" FontSize="12" FontWeight="Medium" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCustomerEmail}"
                           Foreground="{DynamicResource HwWarningForegroundBrush}"/>
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,0,20"><StackPanel>
              <TextBlock Text="{ReflectionBinding [settings.cloud.activate.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [linux.settings.cloud.activate.subtitle], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,2,0,12" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto">
                <!-- Windows shows the key it is being given: a plain monospace field, no mask
                     and no placeholder, so a mistyped character is visible before Activate. -->
                <TextBox x:Name="AccountKeyInput" Classes="valueField" Text="{Binding AccountKey}" FontFamily="DejaVu Sans Mono, Liberation Mono, monospace"/>
                <!-- Windows disables this button and relabels it "Activating..." for as long as the
                     key is being validated. ActivateCommand's own CanExecute already does the
                     disabling; the label is the two-TextBlock swap the History Copy button uses,
                     which keeps both strings in the catalog instead of assigning Content in code. -->
                <Button Grid.Column="1" x:Name="AccountActivateButton" Classes="accent" Margin="8,0,0,0"
                        Command="{Binding ActivateCommand}">
                  <Panel>
                    <TextBlock IsVisible="{Binding !IsActivating}"
                               Text="{ReflectionBinding [license.button.activate], Source={StaticResource Localization}}"/>
                    <TextBlock IsVisible="{Binding IsActivating}"
                               Text="{ReflectionBinding [license.button.activating], Source={StaticResource Localization}}"/>
                  </Panel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ActivationError}" IsVisible="{Binding HasActivationError}" FontSize="12"
                         Foreground="{DynamicResource HwErrorForegroundBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Classes="card" Margin="0,0,0,20"><StackPanel>
              <TextBlock Text="{ReflectionBinding [settings.cloud.getCredits.title], Source={StaticResource Localization}}" Classes="rowTitle"/>
              <TextBlock Text="{ReflectionBinding [settings.cloud.getCredits.subtitle], Source={StaticResource Localization}}" FontSize="12" Foreground="{DynamicResource HwTextSecondaryBrush}" Margin="0,2,0,12" TextWrapping="Wrap"/>
              <Button x:Name="AccountPurchaseButton" Classes="accent" Content="{ReflectionBinding [settings.cloud.getCredits.button], Source={StaticResource Localization}}" Command="{Binding PurchaseCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Border>
          </StackPanel>

          <!-- Windows ends both views with its own last card and nothing after it. Provider API
               keys are not an account concern on Windows either: they live behind the Model
               Library's "API keys" button, which this app now has, so the Linux-only credentials
               card that used to sit here is gone. -->
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <!-- About. Windows uses an identity card, then one card per action. Linux keeps the same
         shape and adds the two rows Windows does not have: documentation and support. -->
    <!-- ABOUT
         Windows draws exactly four cards: identity, Open Log Folder, Export Diagnostics and
         Check for Updates, the last with no bottom margin. The identity card prints ONE version
         line at 12px; the Linux package version belongs with the update card, which is the only
         place it means anything. Need help? moved to General in an earlier round. -->
    <DataTemplate DataType="vm:AboutViewModel">
      <ScrollViewer Classes="page"><StackPanel x:Name="AboutScreen" MaxWidth="560">
        <TextBlock Text="{ReflectionBinding [settings.section.about], Source={StaticResource Localization}}" Classes="pageTitle"/>
        <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="52,*,Auto" MinHeight="54">
          <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource HwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="H" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HwOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{ReflectionBinding [settings.about.appTitle], Source={StaticResource Localization}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
            <TextBlock Margin="0,2,0,0" Classes="rowSubtitle"
                       Text="{Binding AppVersion, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.version}"/>
          </StackPanel>
          <Border Grid.Column="2" Classes="badgeGray">
            <TextBlock Text="{ReflectionBinding [linux.ui.linux.1.0], Source={StaticResource Localization}}"/>
          </Border>
        </Grid></Border>
        <Border Classes="card" Padding="12" Margin="0,0,0,12"><Grid ColumnDefinitions="36,*,Auto" MinHeight="42">
          <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource HwHoverBackgroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="{StaticResource HwIconDocument}" Fill="{DynamicResource HwAccentBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{ReflectionBinding [settings.about.openLogFolder], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Margin="0,2,0,0" Classes="rowSubtitle large"
                       Text="{ReflectionBinding [settings.about.openLogFolder.description], Source={StaticResource Localization}}"/>
          </StackPanel>
          <Button Grid.Column="2" x:Name="AboutLogsButton" Height="43" MinHeight="43" Padding="14,0" VerticalContentAlignment="Center" Content="{ReflectionBinding [linux.ui.open.private.logs], Source={StaticResource Localization}}" Click="OnOpenLogs" VerticalAlignment="Center"/>
        </Grid></Border>
        <Border Classes="card" Padding="12" Margin="0,0,0,12"><Grid ColumnDefinitions="36,*,Auto" MinHeight="42">
          <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource HwHoverBackgroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="{StaticResource HwIconLibrary}" Fill="{DynamicResource HwAccentBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{ReflectionBinding [settings.about.exportDiagnostics], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Margin="0,2,0,0" Classes="rowSubtitle large"
                       Text="{ReflectionBinding [settings.about.exportDiagnostics.description], Source={StaticResource Localization}}"/>
          </StackPanel>
          <!-- What the bundle contains used to be a line of body copy in a Linux-only card at the
               foot of the page. Windows draws no such line, so it is the button's tooltip. -->
          <Button Grid.Column="2" x:Name="AboutExportDiagnosticsButton" Height="43" MinHeight="43" Padding="14,0" VerticalContentAlignment="Center" Content="{ReflectionBinding [settings.about.exportDiagnostics], Source={StaticResource Localization}}" Click="OnExportDiagnostics" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding DiagnosticsPrivacyDescription}"/>
        </Grid></Border>
        <Border Classes="card" Padding="12" Margin="0,0,0,12"><Grid ColumnDefinitions="36,*,Auto" MinHeight="42">
          <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource HwHoverBackgroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="{StaticResource HwIconRefresh}" Fill="{DynamicResource HwAccentBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{ReflectionBinding [settings.about.checkUpdates], Source={StaticResource Localization}}" Classes="rowTitle"/>
            <TextBlock Margin="0,2,0,0" Classes="rowSubtitle large"
                       Text="{ReflectionBinding [settings.about.checkUpdates.description], Source={StaticResource Localization}}"/>
          </StackPanel>
          <!-- Linux never self-updates: the button refreshes what the package manager reports.
               The caveat is the tooltip and the result is a dialog, because Windows reports its
               own check in a dialog too and draws nothing under this card. -->
          <Button Grid.Column="2" x:Name="AboutUpdateRefreshButton" Height="43" MinHeight="43" Padding="14,0" VerticalContentAlignment="Center" Content="{ReflectionBinding [linux.update.refresh], Source={StaticResource Localization}}" Click="OnRefreshPackageStatus" VerticalAlignment="Center"
                  ToolTip.Tip="{ReflectionBinding [linux.update.instructions], Source={StaticResource Localization}}"/>
        </Grid></Border>

        <!-- Windows ends the page at the Check for Updates card, with nothing after it. The
             five-line Linux text dump that used to follow is gone: the version is already on the
             identity card, the diagnostics privacy note is now the Export Diagnostics button's
             tooltip, and the package-manager caveat and the refresh result are now the Check for
             Updates button's tooltip and a dialog — which is how Windows reports a check too. -->
      </StackPanel></ScrollViewer>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="232,*" RowDefinitions="44,*,Auto">
    <!-- Custom title row. Windows owns its caption through WindowChrome and draws the two
         buttons itself; ExtendClientAreaToDecorationsHint is the Avalonia equivalent, and the
         row starts a manual drag so the window still moves without a system title bar. -->
    <Border x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent"
            BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
        <Button x:Name="WindowMinimizeButton" Classes="caption" Click="OnMinimizeWindow"
                ToolTip.Tip="{ReflectionBinding [window.caption.minimize], Source={StaticResource Localization}}">
          <Path Data="{StaticResource HwIconCaptionMinimize}" Width="10" Height="2" Stretch="Fill"
                Stroke="{DynamicResource HwTextSecondaryBrush}" StrokeThickness="1.6"
                StrokeLineCap="Round"/>
        </Button>
        <Button x:Name="WindowCloseButton" Classes="caption" Click="OnCloseWindow"
                ToolTip.Tip="{ReflectionBinding [window.caption.close], Source={StaticResource Localization}}">
          <Path Data="{StaticResource HwIconCaptionClose}" Width="10" Height="10" Stretch="Fill"
                Stroke="{DynamicResource HwTextSecondaryBrush}" StrokeThickness="1.5"
                StrokeLineCap="Round"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- Sidebar. It spans the title row too, exactly as the Windows sidebar does, so the
         hairline under the caption stops at the sidebar edge. The row groups are spaced with a
         top margin on the first row of each group, which reproduces the Windows spacer rows
         without a second list to keep in sync. -->
    <Border Grid.RowSpan="3" Background="{DynamicResource HwSidebarBackgroundBrush}" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Height="54">
          <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{ReflectionBinding [app.title], Source={StaticResource Localization}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HwTextPrimaryBrush}"/>
        </Border>
        <ListBox x:Name="Navigation" Classes="nav" Grid.Row="1" Margin="10,0" Padding="6" SelectionChanged="OnNavigationChanged">
          <ListBoxItem Content="{ReflectionBinding [sidebar.home], Source={StaticResource Localization}}" Tag="home" IsSelected="True" ContentTemplate="{StaticResource NavHome}"/>
          <ListBoxItem Content="{ReflectionBinding [sidebar.modes], Source={StaticResource Localization}}" Tag="modes" ContentTemplate="{StaticResource NavModes}" Margin="0,14,0,0"/>
          <ListBoxItem Content="{ReflectionBinding [sidebar.vocabulary], Source={StaticResource Localization}}" Tag="vocabulary" ContentTemplate="{StaticResource NavVocabulary}"/>
          <ListBoxItem Content="{ReflectionBinding [settings.nav.models], Source={StaticResource Localization}}" Tag="models" ContentTemplate="{StaticResource NavModels}" Margin="0,14,0,0"/>
          <ListBoxItem Content="{ReflectionBinding [settings.nav.streaming], Source={StaticResource Localization}}" Tag="streaming" ContentTemplate="{StaticResource NavStreaming}"/>
          <ListBoxItem Content="{ReflectionBinding [sidebar.history], Source={StaticResource Localization}}" Tag="history" ContentTemplate="{StaticResource NavHistory}" Margin="0,14,0,0"/>
          <ListBoxItem Content="{ReflectionBinding [sidebar.settings], Source={StaticResource Localization}}" Tag="settings" ContentTemplate="{StaticResource NavSettings}" Margin="0,14,0,0"/>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="10,0,10,10">
          <Border Height="1" Opacity="0.5" Margin="10,8" Background="{DynamicResource HwBorderBrush}"/>
          <!-- Hidden until the machine carries a Cloud account, the way the Windows licensed
               card is Collapsed until the license is Active. -->
          <Border x:Name="LicensedSidebarCard" Classes="editionBadge"
                  IsVisible="{Binding Account.HasAccount, FallbackValue=False, TargetNullValue=False}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{StaticResource HwIconCheck}" Fill="{DynamicResource HwSuccessBrush}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{ReflectionBinding [app.title], Source={StaticResource Localization}}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <!-- Windows' LicensedSidebarCard pill is app.badge.pro, "PRO". The edition string
                   belongs on the About identity card, which still shows "Linux"; this pill says
                   what the licence is, and it is the same licence. -->
              <Border Grid.Column="2" Classes="editionPill"><TextBlock x:Name="EditionText" Text="{ReflectionBinding [app.badge.pro], Source={StaticResource Localization}}" FontSize="10" FontWeight="SemiBold"/></Border>
            </Grid>
          </Border>
          <!-- The Cloud call to action Windows pins to the bottom of its sidebar. Windows runs it
               the full width of the nav column (x10-220, 211 wide) at 32 tall; hugging its content
               made it 187x34, narrower and taller than the rows above it. -->
          <Button x:Name="CloudSidebarCta" Classes="accent" Padding="14,0" Height="32" MinHeight="32"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnGoToCloud"
                  IsVisible="{Binding Account.HasAccount, Converter={x:Static conv:BoolConverters.Not}, FallbackValue=True, TargetNullValue=True}">
            <!-- Auto,Auto,Auto centred, not Auto,*,Auto stretched. Windows declares a * middle
                 column too, but its button style pins the content presenter to Center, so the
                 three parts ride together in the middle of the button: measured on Home, the
                 Windows group runs x40-188 inside a 10-220 button, 16px clear on the left and
                 18px on the right. A real * column pushed the Linux chevron out to x196-201,
                 hard against the right edge, and opened a 42px hole after the label. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
              <Path Data="{StaticResource HwIconCloud}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{ReflectionBinding [app.cloud.cta.title], Source={StaticResource Localization}}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Path Grid.Column="2" Data="{StaticResource HwIconChevron}" Fill="{DynamicResource HwOnAccentBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Header band, then the page. Windows draws the title on the content background with a
         hairline under it, and the Settings pages add a second column of sub-pages. -->
    <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="Auto,Auto,*">
      <!-- Windows pads the band 24,20 and caps its content at the SAME MaxWidth the body below
           uses, so the title and the content share one centred column. GoTo sets that width per
           page: 720 on the wide pages, 560 on Streaming. -->
      <!-- 21 below, not 20 and not 25. Windows rules this band at y144 on Modes and Vocabulary,
           y142 on Model Library and y159 on Streaming; at 25 the Linux rule sat at 148/148/148/165,
           4-6px low, which carried every page under it down with it. 21 lands Modes and Vocabulary
           exactly and leaves the other two 2px low, which is the Windows title block itself being
           2px shorter there, not this padding. -->
      <Border x:Name="PageHeader" Padding="24,20,24,21" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,0,1">
        <Grid x:Name="PageHeaderContent" MaxWidth="720" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="{Binding PageTitle}" Classes="pageHeading"/>
            <TextBlock x:Name="PageSubtitle" Classes="pageSubheading" Margin="0,6,0,0"/>
          </StackPanel>
          <!-- Windows puts "Create Mode" on the header row beside the title, not in the body. -->
          <Button x:Name="ModeNewButton" Grid.Column="1" Classes="accent" IsVisible="False"
                  VerticalAlignment="Top" Click="OnCreateMode"
                  Content="{ReflectionBinding [modes.header.create], Source={StaticResource Localization}}"/>
        </Grid>
      </Border>
      <Border x:Name="PlatformNotice" Grid.Row="1" Classes="notice" Margin="24,14,24,0" Padding="12,7" IsVisible="False">
        <TextBlock x:Name="PlatformStatusText" Classes="caption" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #PlatformStatusText.Text}"/>
      </Border>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <Border x:Name="SettingsNavPane" Width="200" IsVisible="False" Padding="8,16,8,0" Background="{DynamicResource HwSidebarBackgroundBrush}" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,0,1,0">
          <!-- The same ten sections the Windows settings pane lists, in the same order. -->
          <ListBox x:Name="SettingsNav" Classes="nav sub" UseLayoutRounding="False" SelectionChanged="OnSettingsNavigationChanged">
            <!-- No IsSelected here. The pane starts collapsed, so this item's container is only
                 realized on the first navigation into Settings, which can land after GoTo has
                 already moved the selection elsewhere. The stale local value then painted a
                 second selected row. GoTo calls Select for every page in the family, so the
                 selection is always set by the time the pane is visible. -->
            <ListBoxItem Tag="settings">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconSettings}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.general], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="sound">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconVolume}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.sound], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="account">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconCertificate}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.cloud], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="storage">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconDocument}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.storage], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="output">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconBraces}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.output], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="localapi">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconDevTools}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.localApi], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="shortcuts">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconKeyboard}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.shortcuts], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="backup">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconDownload}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.backup], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="appearance">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconPersonalize}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.appearance], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="about">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource HwIconInfo}" Fill="{Binding $parent[ListBoxItem].Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{ReflectionBinding [settings.nav.about], Source={StaticResource Localization}}" VerticalAlignment="Center"/>
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="*,Auto">
          <ContentControl x:Name="PageContent" Content="{Binding CurrentPage}"/>
          <!-- Windows has no save band: every settings change applies at once, and the Linux head
               now does the same from a debounced listener in code behind. Only a failed save has
               anything to say, so only the error code stays on screen. -->
          <Border x:Name="SettingsFooter" Grid.Row="1" Padding="24,10" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,1,0,0"
                  IsVisible="{Binding Settings.Status.HasError}">
            <TextBlock Text="{Binding Settings.Status.Message}" Classes="caption" Foreground="{DynamicResource HwErrorForegroundBrush}" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Grid.Row="2" Padding="12,5" Background="{DynamicResource HwSidebarBackgroundBrush}" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="0,1,0,0">
      <!-- Windows keeps column 0 to one TextBlock and folds the hint into the status string
           itself ("Ready - Press Ctrl+Alt to record"), so the code behind composes the message,
           the error code and the shortcut hint into StatusText rather than laying three
           TextBlocks side by side. The mode and model groups always show, with a None
           fallback, instead of disappearing when nothing is selected. -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource HwTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"
                    IsVisible="{Binding HasLocalPostProcessingStatus}">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource HwWarningForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="{ReflectionBinding [statusbar.postProcessing], Source={StaticResource Localization}}" Foreground="{DynamicResource HwTextTertiaryBrush}" FontSize="11"/>
          <TextBlock Text="{Binding LocalPostProcessingStatus}" Foreground="{DynamicResource HwTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <TextBlock Text="{ReflectionBinding [statusbar.mode], Source={StaticResource Localization}}" Foreground="{DynamicResource HwTextTertiaryBrush}" FontSize="11"/>
          <TextBlock Text="{Binding Modes.Selected.Name, FallbackValue=None, TargetNullValue=None}" Foreground="{DynamicResource HwTextSecondaryBrush}" FontSize="11" FontWeight="Medium"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{ReflectionBinding [statusbar.model], Source={StaticResource Localization}}" Foreground="{DynamicResource HwTextTertiaryBrush}" FontSize="11"/>
          <TextBlock Text="{Binding Modes.Selected.Model, FallbackValue=None, TargetNullValue=None}" Foreground="{DynamicResource HwTextSecondaryBrush}" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- FallbackValue is load bearing. InitializeOnboardingAsync returns without assigning a
         DataContext whenever setup is already done, and a binding with no source leaves
         IsVisible at its default of true. The overlay then covered every page and swallowed
         every click on the second and every later launch. -->
    <Border x:Name="OnboardingOverlay" x:DataType="local:LinuxOnboardingViewModel" Grid.ColumnSpan="2" Grid.RowSpan="3" ZIndex="100" Background="{DynamicResource HwScrimBrush}" IsVisible="{Binding IsVisible, FallbackValue=False, TargetNullValue=False}">
      <Border Width="680" MaxHeight="600" Padding="28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource HwCardBackgroundBrush}" BorderBrush="{DynamicResource HwBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="*,Auto" RowSpacing="24">
          <ScrollViewer><StackPanel Spacing="14">
            <StackPanel IsVisible="{Binding IsWelcome}" Spacing="12"><TextBlock Text="{ReflectionBinding [linux.onboarding.welcome.title], Source={StaticResource Localization}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.onboarding.welcome.body], Source={StaticResource Localization}}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel IsVisible="{Binding IsCapabilities}" Spacing="10"><TextBlock Text="{ReflectionBinding [linux.onboarding.capabilities.title], Source={StaticResource Localization}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.onboarding.capabilities.body], Source={StaticResource Localization}}" TextWrapping="Wrap"/><CheckBox Content="{ReflectionBinding [linux.onboarding.capability.audio], Source={StaticResource Localization}}" IsChecked="{Binding Capabilities.AudioCapture}" IsEnabled="False"/><CheckBox Content="{ReflectionBinding [linux.onboarding.capability.clipboard], Source={StaticResource Localization}}" IsChecked="{Binding Capabilities.Clipboard}" IsEnabled="False"/><CheckBox Content="{ReflectionBinding [linux.onboarding.capability.uinput], Source={StaticResource Localization}}" IsChecked="{Binding Capabilities.UInput}" IsEnabled="False"/><CheckBox Content="{ReflectionBinding [linux.onboarding.capability.shortcuts], Source={StaticResource Localization}}" IsChecked="{Binding Capabilities.GlobalShortcuts}" IsEnabled="False"/><CheckBox Content="{ReflectionBinding [linux.onboarding.capability.portal], Source={StaticResource Localization}}" IsChecked="{Binding Capabilities.DesktopPortal}" IsEnabled="False"/></StackPanel>
            <StackPanel IsVisible="{Binding IsProvider}" Spacing="12"><TextBlock Text="{ReflectionBinding [linux.onboarding.provider.title], Source={StaticResource Localization}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.onboarding.provider.body], Source={StaticResource Localization}}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" SelectionChanged="OnOnboardingModeChanged"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:Mode"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding ProviderType}" FontSize="11" Opacity="0.65"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{ReflectionBinding [linux.onboarding.provider.unavailable], Source={StaticResource Localization}}" IsVisible="{Binding !IsSelectedModeAvailable}" TextWrapping="Wrap" Foreground="Orange"/></StackPanel>
            <StackPanel IsVisible="{Binding IsMicrophone}" Spacing="12"><TextBlock Text="{ReflectionBinding [linux.onboarding.microphone.title], Source={StaticResource Localization}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.onboarding.microphone.body], Source={StaticResource Localization}}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"><ComboBox.ItemTemplate><DataTemplate x:DataType="platform:AudioInputDevice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{ReflectionBinding [linux.onboarding.microphone.unavailable], Source={StaticResource Localization}}" IsVisible="{Binding !Capabilities.AudioCapture}" TextWrapping="Wrap" Foreground="Orange"/></StackPanel>
            <StackPanel IsVisible="{Binding IsTest}" Spacing="12"><TextBlock Text="{ReflectionBinding [linux.onboarding.test.title], Source={StaticResource Localization}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.onboarding.test.body], Source={StaticResource Localization}}" TextWrapping="Wrap"/><Button Content="{ReflectionBinding [linux.onboarding.test.button], Source={StaticResource Localization}}" Click="OnOnboardingTestDictation" IsEnabled="{Binding IsTestReady}" HorizontalAlignment="Left"/><TextBlock Text="{Binding TestStatus}" TextWrapping="Wrap"/><TextBlock Text="{ReflectionBinding [linux.onboarding.test.privacy], Source={StaticResource Localization}}" Classes="caption"/></StackPanel>
          </StackPanel></ScrollViewer>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Button Content="{ReflectionBinding [linux.onboarding.back], Source={StaticResource Localization}}" Click="OnOnboardingBack" IsEnabled="{Binding CanGoBack}"/><Button Grid.Column="2" Content="{ReflectionBinding [linux.onboarding.skip], Source={StaticResource Localization}}" Click="OnOnboardingSkip"/><Button Grid.Column="3" Classes="accent" Content="{ReflectionBinding [linux.onboarding.continue], Source={StaticResource Localization}}" Click="OnOnboardingNext" IsEnabled="{Binding CanGoNext}"/></Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>

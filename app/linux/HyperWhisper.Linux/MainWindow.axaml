<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HyperWhisper.PortableApplication.ViewModels" xmlns:local="using:HyperWhisper.Linux" xmlns:data="using:HyperWhisper.Data.Entities" xmlns:platform="using:HyperWhisper.Platform.Abstractions" x:Class="HyperWhisper.Linux.MainWindow" x:DataType="vm:ApplicationShellViewModel"
        Title="{ReflectionBinding [app.title], Source={StaticResource Localization}}" FlowDirection="{ReflectionBinding FlowDirection, Source={StaticResource Localization}}" Width="1040" Height="680" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HwContentBackgroundBrush}" Foreground="{DynamicResource HwTextPrimaryBrush}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <ScrollViewer x:Name="HomeScreen" Classes="page">
      <StackPanel Spacing="20">
        <TextBlock Text="{ReflectionBinding [linux.ui.record.and.transcribe], Source={StaticResource Localization}}" Classes="sectionTitle" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Text="{ReflectionBinding [linux.ui.audio.input], Source={StaticResource Localization}}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Recording.AudioDevices}" SelectedItem="{Binding Recording.SelectedAudioDevice}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HomeStartRecordingButton" Classes="accent" Content="{ReflectionBinding [linux.ui.start.recording], Source={StaticResource Localization}}" Click="OnStartRecording"/><Button x:Name="HomeStopRecordingButton" Content="{ReflectionBinding [linux.ui.stop.and.transcribe], Source={StaticResource Localization}}" Click="OnStopRecording"/><Button x:Name="HomeCancelRecordingButton" Content="{ReflectionBinding [common.cancel], Source={StaticResource Localization}}" Click="OnCancelRecording"/><Button Content="{ReflectionBinding [linux.ui.refresh.devices], Source={StaticResource Localization}}" Command="{Binding Recording.RefreshDevicesCommand}"/></StackPanel>
            <TextBlock Text="{Binding Recording.State, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.state.value}"/><TextBlock Text="{Binding Recording.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Recording.ErrorCode}" IsVisible="{Binding Recording.HasError}" Opacity="0.7"/>
            <Separator/>
            <TextBlock Text="{ReflectionBinding [linux.ui.transcribe.an.existing.audio.file], Source={StaticResource Localization}}" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="HomeAudioFileInput" Text="{Binding Recording.FilePath}" PlaceholderText="WAV, MP3, M4A, FLAC, OGG, or WebM"/><Button Grid.Column="1" Content="{ReflectionBinding [linux.ui.browse], Source={StaticResource Localization}}" Click="OnBrowseAudioFile"/><Button x:Name="HomeTranscribeFileButton" Grid.Column="2" Content="{ReflectionBinding [linux.ui.transcribe.file], Source={StaticResource Localization}}" Command="{Binding Recording.TranscribeFileCommand}"/><Button Grid.Column="3" Content="{ReflectionBinding [linux.ui.cancel.import], Source={StaticResource Localization}}" Command="{Binding Recording.CancelCommand}" IsVisible="{Binding Recording.IsImporting}"/></Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Recording.ImportProgress}" IsVisible="{Binding Recording.IsImporting}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{ReflectionBinding [linux.ui.your.impact], Source={StaticResource Localization}}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
          <Border Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [linux.ui.this.week], Source={StaticResource Localization}}" FontWeight="SemiBold"/><TextBlock Text="{Binding ThisWeek.WordCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.value}"/><TextBlock Text="{Binding ThisWeek.DictatedDurationSeconds, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.dictated.values}"/><TextBlock Text="{Binding ThisWeek.AverageWordsPerMinute, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.speaking.value.wpm}"/><TextBlock Text="{Binding SavedThisWeekMinutes, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.saved.value.min}"/></StackPanel></Border>
          <Border Grid.Column="1" Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [linux.ui.this.month], Source={StaticResource Localization}}" FontWeight="SemiBold"/><TextBlock Text="{Binding ThisMonth.WordCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.value}"/><TextBlock Text="{Binding ThisMonth.DictatedDurationSeconds, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.dictated.values}"/><TextBlock Text="{Binding ThisMonth.EstimatedTypingMinutes, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.typing.value.min}"/><TextBlock Text="{Binding ThisMonth.EstimatedTimeSavedMinutes, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.saved.value.min.0c59c485}"/></StackPanel></Border>
          <Border Grid.Column="2" Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [linux.ui.all.time], Source={StaticResource Localization}}" FontWeight="SemiBold"/><TextBlock Text="{Binding AllTime.WordCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.words.value}"/><TextBlock Text="{Binding AllTime.DictatedDurationSeconds, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.dictated.values}"/><TextBlock Text="{Binding AllTime.AverageWordsPerMinute, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.speaking.value.wpm}"/><TextBlock Text="{Binding AllTime.EstimatedTimeSavedMinutes, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.saved.value.min.0c59c485}"/></StackPanel></Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{ReflectionBinding [linux.ui.estimated.typing.speed], Source={StaticResource Localization}}" VerticalAlignment="Center"/><ComboBox x:Name="HomeTypingSpeed" ItemsSource="{Binding TypingSpeedChoices}" SelectedItem="{Binding TypingSpeedWordsPerMinute}" Width="100"/><TextBlock Text="{ReflectionBinding [linux.ui.wpm], Source={StaticResource Localization}}" VerticalAlignment="Center"/></StackPanel>
        <TextBlock Text="{ReflectionBinding [linux.ui.local.library], Source={StaticResource Localization}}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
          <Border Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [sidebar.history], Source={StaticResource Localization}}"/><TextBlock Text="{Binding HistoryCount}" Classes="metricValue"/></StackPanel></Border>
          <Border Grid.Column="1" Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [sidebar.vocabulary], Source={StaticResource Localization}}"/><TextBlock Text="{Binding VocabularyCount}" Classes="metricValue"/></StackPanel></Border>
          <Border Grid.Column="2" Classes="metricCard"><StackPanel><TextBlock Text="{ReflectionBinding [sidebar.modes], Source={StaticResource Localization}}"/><TextBlock Text="{Binding ModeCount}" Classes="metricValue"/></StackPanel></Border>
        </Grid>
        <Button x:Name="HomeRefreshButton" Content="{ReflectionBinding [linux.ui.refresh.library], Source={StaticResource Localization}}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status.Message}" /><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
      </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <Grid x:Name="HistoryScreen" ColumnDefinitions="3*,4*" ColumnSpacing="24">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="HistorySearchInput" Text="{Binding SearchText}" PlaceholderText="{ReflectionBinding [linux.ui.search.transcripts], Source={StaticResource Localization}}"/><Button x:Name="HistorySearchButton" Classes="accent" Grid.Column="1" Content="{ReflectionBinding [linux.ui.search], Source={StaticResource Localization}}" Command="{Binding SearchCommand}"/><Button Grid.Column="2" Content="{ReflectionBinding [settings.credits.refresh], Source={StaticResource Localization}}" Command="{Binding RefreshCommand}"/></Grid>
          <!-- A DatePicker is wider than a star column at this pane width, so the two pickers
               and the button used to be drawn on top of each other. Give the pickers Auto
               columns and move the button to its own row. -->
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4"><TextBlock Text="{ReflectionBinding [linux.ui.from.date], Source={StaticResource Localization}}" Classes="fieldLabel"/><TextBlock Grid.Column="1" Text="{ReflectionBinding [linux.ui.through.date], Source={StaticResource Localization}}" Classes="fieldLabel"/><DatePicker x:Name="HistoryStartDate" Grid.Row="1" SelectedDate="{Binding StartDate}"/><DatePicker x:Name="HistoryEndDate" Grid.Row="1" Grid.Column="1" SelectedDate="{Binding EndDate}"/><Button x:Name="HistoryClearFilters" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="{ReflectionBinding [settings.models.clearFilters], Source={StaticResource Localization}}" Command="{Binding ClearFiltersCommand}"/></Grid>
          <ListBox x:Name="HistoryList" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Multiple,Toggle" SelectionChanged="OnHistorySelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Text}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Date}" FontSize="11" Opacity="0.65"/><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding FailedReason}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="12">
          <TextBlock Text="{ReflectionBinding [linux.ui.transcript.detail], Source={StaticResource Localization}}" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding SelectedStatusLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFailureReason}" Foreground="IndianRed" IsVisible="{Binding IsSelectedFailed}"/><TextBlock Text="{ReflectionBinding [linux.ui.retry.in.progress], Source={StaticResource Localization}}" IsVisible="{Binding IsSelectedRetrying}"/></StackPanel>
          <CheckBox x:Name="HistoryShowRawTranscript" Content="{ReflectionBinding [linux.ui.show.raw.transcription], Source={StaticResource Localization}}" IsChecked="{Binding ShowRawTranscript}" IsEnabled="{Binding HasRawTranscript}"/>
          <TextBlock x:Name="HistoryDetailLabel" Text="{Binding DetailLabel}" FontWeight="SemiBold"/><TextBlock x:Name="HistoryDetailText" Text="{Binding DetailText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HistoryCopyButton" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}"/><TextBlock Text="{Binding Selected.TranscriptionProvider, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.provider.value}"/><TextBlock Text="{Binding Selected.Duration, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.duration.values}"/></StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Button x:Name="HistoryPlayButton" Content="{Binding PlayPauseLabel}" Command="{Binding PlayCommand}"/><Slider x:Name="HistoryPlaybackSlider" Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDurationSeconds}" Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}" IsEnabled="{Binding IsPlaybackAvailable}"/><TextBlock Grid.Column="2" Text="{Binding FormattedPlaybackPosition}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding FormattedPlaybackDuration, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=linux.format.value}" VerticalAlignment="Center"/></Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox x:Name="HistoryRetryMode" ItemsSource="{Binding AvailableRetryModes}" SelectedItem="{Binding SelectedRetryMode}" DisplayMemberBinding="{Binding Name}" PlaceholderText="{ReflectionBinding [linux.ui.retry.mode], Source={StaticResource Localization}}"/><Button x:Name="HistoryRetryButton" Grid.Column="1" Content="{ReflectionBinding [linux.ui.transcribe.again], Source={StaticResource Localization}}" Command="{Binding RetryCommand}"/></Grid>
          <CheckBox x:Name="HistoryDeleteAudio" Content="{ReflectionBinding [linux.ui.also.delete.app.owned.recordings.off.by.default], Source={StaticResource Localization}}" IsChecked="{Binding DeleteAudio}"/>
          <Button x:Name="HistoryDeleteButton" Content="{ReflectionBinding [linux.ui.delete.selected.transcript.s], Source={StaticResource Localization}}" Command="{Binding DeleteCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{ReflectionBinding [linux.ui.caller.owned.files.and.symbolic.link.targets.are.always.retained], Source={StaticResource Localization}}" TextWrapping="Wrap" Opacity="0.65"/><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:VocabularyViewModel">
      <Grid x:Name="VocabularyScreen" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="VocabularyWordInput" PlaceholderText="{ReflectionBinding [linux.ui.word.or.phrase], Source={StaticResource Localization}}" Text="{Binding Word}" Width="220"/><TextBox x:Name="VocabularyReplacementInput" PlaceholderText="{ReflectionBinding [linux.ui.replacement.optional], Source={StaticResource Localization}}" Text="{Binding Replacement}" Width="220"/><Button x:Name="VocabularyAddButton" Classes="accent" Content="{ReflectionBinding [common.save], Source={StaticResource Localization}}" Command="{Binding AddCommand}"/></StackPanel><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="VocabularyTransferPath" Text="{Binding TransferPath}" PlaceholderText="/path/to/vocabulary.tsv"/><Button x:Name="VocabularyImportButton" Grid.Column="1" Content="{ReflectionBinding [linux.ui.import], Source={StaticResource Localization}}" Command="{Binding ImportCommand}"/><Button x:Name="VocabularyExportButton" Grid.Column="2" Content="{ReflectionBinding [linux.ui.export], Source={StaticResource Localization}}" Command="{Binding ExportCommand}"/></Grid></StackPanel>
        <StackPanel Grid.Row="1" Spacing="10"><ListBox x:Name="VocabularyList" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="2*,2*,Auto" Margin="0,4"><TextBlock Text="{Binding Word}"/><TextBlock Grid.Column="1" Text="{Binding Replacement}"/><Button Grid.Column="2" Content="{ReflectionBinding [common.delete], Source={StaticResource Localization}}" Command="{Binding $parent[ListBox].DataContext.DeleteCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ModesViewModel">
      <Grid x:Name="ModesScreen" ColumnDefinitions="2*,3*" ColumnSpacing="20">
        <ListBox x:Name="ModesList" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        <ScrollViewer Grid.Column="1"><StackPanel Spacing="10">
          <TextBlock Text="{ReflectionBinding [linux.ui.mode.editor], Source={StaticResource Localization}}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [mode.editor.field.name], Source={StaticResource Localization}}" Classes="fieldLabel"/><TextBox x:Name="ModeNameInput" PlaceholderText="{ReflectionBinding [mode.editor.field.name], Source={StaticResource Localization}}" Text="{Binding Name}"/><TextBlock Text="{ReflectionBinding [linux.ui.language.code], Source={StaticResource Localization}}" Classes="fieldLabel"/><TextBox x:Name="ModeLanguageInput" PlaceholderText="{ReflectionBinding [linux.ui.language.code], Source={StaticResource Localization}}" Text="{Binding Language}"/>
          <TextBlock Text="{ReflectionBinding [linux.ui.transcription.provider], Source={StaticResource Localization}}"/><ComboBox x:Name="ModeProviderType" ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding ProviderType}"/><TextBlock Text="{ReflectionBinding [linux.ui.local.engine.used.for.local.modes], Source={StaticResource Localization}}"/><ComboBox x:Name="ModeLocalEngine" ItemsSource="{Binding LocalEngines}" SelectedItem="{Binding LocalEngine}"/><TextBlock Text="{ReflectionBinding [linux.ui.model.id.or.provider.catalog.model], Source={StaticResource Localization}}"/><TextBox x:Name="ModeTranscriptionModel" Text="{Binding TranscriptionModel}"/>
          <TextBlock Text="{ReflectionBinding [linux.ui.cloud.provider.used.for.cloud.modes], Source={StaticResource Localization}}"/><ComboBox x:Name="ModeCloudProvider" ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding CloudProvider}"/><TextBlock Text="{ReflectionBinding [linux.ui.hyperwhisper.cloud.accuracy.tier], Source={StaticResource Localization}}"/><ComboBox x:Name="ModeCloudAccuracyTier" ItemsSource="{Binding CloudAccuracyTiers}" SelectedItem="{Binding CloudAccuracyTier}"/><TextBlock Text="{ReflectionBinding [linux.ui.hyperwhisper.cloud.domain], Source={StaticResource Localization}}"/><ComboBox x:Name="ModeCloudDomain" ItemsSource="{Binding CloudDomains}" SelectedItem="{Binding CloudDomain}"/><TextBlock Text="{ReflectionBinding [linux.ui.gemini.custom.prompt], Source={StaticResource Localization}}"/><TextBox x:Name="ModeGeminiPrompt" Text="{Binding GeminiPrompt}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="{ReflectionBinding [linux.ui.mode.vocabulary.comma.or.line.separated], Source={StaticResource Localization}}"/><TextBox x:Name="ModeCustomVocabulary" Text="{Binding CustomVocabulary}" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="ModeEnableScreenOcr" Content="{ReflectionBinding [linux.ui.use.screen.ocr.context.for.enhancement], Source={StaticResource Localization}}" IsChecked="{Binding EnableScreenOcr}"/>
          <Separator/><TextBlock Text="{ReflectionBinding [settings.api.postProcessing.title], Source={StaticResource Localization}}" FontWeight="SemiBold"/><ComboBox x:Name="ModePostProcessingMode" ItemsSource="{Binding PostProcessingModes}" SelectedItem="{Binding PostProcessingMode}"/><TextBlock Text="{ReflectionBinding [linux.ui.cloud.provider], Source={StaticResource Localization}}"/><ComboBox x:Name="ModePostProcessingProvider" ItemsSource="{Binding PostProcessingProviders}" SelectedItem="{Binding PostProcessingProvider}"/><TextBlock Text="{ReflectionBinding [linux.ui.byok.provider.model], Source={StaticResource Localization}}"/><TextBox x:Name="ModePostProcessingModel" Text="{Binding PostProcessingModel}" PlaceholderText="gpt-4.1-mini"/><TextBlock Text="{ReflectionBinding [linux.ui.hyperwhisper.cloud.provider.model], Source={StaticResource Localization}}"/><TextBox x:Name="ModeHyperWhisperCloudModel" Text="{Binding HyperWhisperCloudModel}" PlaceholderText="anthropic:claude-haiku-4-5"/><TextBlock Text="{ReflectionBinding [linux.ui.local.gguf.filename.in.models.llm], Source={StaticResource Localization}}"/><TextBox x:Name="ModeLocalPostProcessingModel" PlaceholderText="gemma-4-E2B-it-Q4_K_M.gguf" Text="{Binding LocalPostProcessingModel}"/>
          <TextBlock Text="{ReflectionBinding [linux.ui.custom.openai.compatible.endpoint], Source={StaticResource Localization}}" FontWeight="SemiBold"/><TextBox x:Name="ModeCustomEndpointName" Text="{Binding CustomEndpointName}" PlaceholderText="{ReflectionBinding [linux.ui.endpoint.name], Source={StaticResource Localization}}"/><TextBox x:Name="ModeCustomEndpointUrl" Text="{Binding CustomEndpointUrl}" PlaceholderText="https://host/v1/chat/completions"/><TextBox x:Name="ModeCustomEndpointModel" Text="{Binding CustomEndpointModel}" PlaceholderText="{ReflectionBinding [linux.ui.model.name], Source={StaticResource Localization}}"/><TextBox x:Name="ModeCustomEndpointApiKey" Text="{Binding CustomEndpointApiKey}" PasswordChar="●" PlaceholderText="{ReflectionBinding [linux.ui.new.api.key.optional.for.local.endpoints], Source={StaticResource Localization}}"/><TextBlock Text="{ReflectionBinding [linux.ui.endpoint.credentials.are.kept.in.secret.service.or.owner.onl.dfdbd389], Source={StaticResource Localization}}" Classes="caption"/>
          <TextBlock Text="{ReflectionBinding [linux.ui.formatting.and.prompt], Source={StaticResource Localization}}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><CheckBox x:Name="ModePunctuation" Content="{ReflectionBinding [mode.editor.section.punctuation], Source={StaticResource Localization}}" IsChecked="{Binding Punctuation}"/><CheckBox x:Name="ModeCapitalization" Content="{ReflectionBinding [linux.ui.capitalization], Source={StaticResource Localization}}" IsChecked="{Binding Capitalization}"/><CheckBox x:Name="ModeProfanityFilter" Content="{ReflectionBinding [linux.ui.profanity.filter], Source={StaticResource Localization}}" IsChecked="{Binding ProfanityFilter}"/><CheckBox x:Name="ModeRemoveTrailingPeriod" Content="{ReflectionBinding [mode.editor.postProcessing.removeTrailingPeriod], Source={StaticResource Localization}}" IsChecked="{Binding RemoveTrailingPeriod}"/></StackPanel><TextBox x:Name="ModeEnglishSpelling" Text="{Binding EnglishSpelling}" PlaceholderText="{ReflectionBinding [linux.ui.english.spelling.american.british], Source={StaticResource Localization}}"/><TextBlock Text="{ReflectionBinding [linux.ui.custom.preset.instructions], Source={StaticResource Localization}}"/><TextBox x:Name="ModeCustomInstructions" Text="{Binding CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"/><TextBlock Text="{ReflectionBinding [linux.ui.optional.system.prompt.maximum.2000.characters], Source={StaticResource Localization}}" Opacity="0.7"/><TextBox x:Name="ModeUserSystemPrompt" Text="{Binding UserSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="2000"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{ReflectionBinding [linux.ui.new], Source={StaticResource Localization}}" Command="{Binding NewCommand}"/><Button x:Name="ModeSaveButton" Classes="accent" Content="{ReflectionBinding [common.save], Source={StaticResource Localization}}" Command="{Binding SaveCommand}"/><Button x:Name="ModeDeleteButton" Content="{ReflectionBinding [common.delete], Source={StaticResource Localization}}" Command="{Binding DeleteCommand}"/></StackPanel><TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <ScrollViewer><StackPanel x:Name="SettingsScreen" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock Text="{ReflectionBinding [linux.ui.application.settings], Source={StaticResource Localization}}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.ui.default.transcription.language.preference], Source={StaticResource Localization}}"/><TextBox x:Name="SettingsLanguageInput" Text="{Binding Language}"/><TextBlock Text="{ReflectionBinding [settings.appearance.theme.title], Source={StaticResource Localization}}"/><ComboBox x:Name="SettingsThemeMode" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}"/><CheckBox x:Name="SettingsLaunchMinimized" Content="{ReflectionBinding [linux.ui.launch.with.the.window.hidden.when.the.tray.is.available], Source={StaticResource Localization}}" IsChecked="{Binding LaunchMinimized}"/><CheckBox x:Name="SettingsMinimizeToTray" Content="{ReflectionBinding [linux.ui.hide.minimized.or.closed.windows.in.the.tray], Source={StaticResource Localization}}" IsChecked="{Binding MinimizeToTray}"/><TextBlock Text="{ReflectionBinding [linux.ui.if.this.desktop.has.no.statusnotifieritem.tray.watcher.hyper.265a6b0d], Source={StaticResource Localization}}" Classes="caption"/><CheckBox x:Name="SettingsShowRecordingWindow" Content="{ReflectionBinding [linux.ui.show.the.recording.status.overlay], Source={StaticResource Localization}}" IsChecked="{Binding ShowRecordingWindow}"/><CheckBox x:Name="SettingsEnableErrorLogging" Content="{ReflectionBinding [linux.ui.send.privacy.filtered.crash.and.performance.diagnostics], Source={StaticResource Localization}}" IsChecked="{Binding EnableErrorLogging}"/><CheckBox x:Name="SettingsShareSpeedData" Content="{ReflectionBinding [settings.general.shareSpeedData.title], Source={StaticResource Localization}}" IsChecked="{Binding ShareAnonymousSpeedData}"/><TextBlock Text="{ReflectionBinding [settings.general.shareSpeedData.subtitle], Source={StaticResource Localization}}" Classes="caption"/><TextBlock Text="{ReflectionBinding [linux.ui.no.transcript.audio.prompt.or.credential.content.is.attached.14a7239e], Source={StaticResource Localization}}" Classes="caption"/>
        <Separator/><TextBlock Text="{ReflectionBinding [linux.ui.shortcuts.and.push.to.talk], Source={StaticResource Localization}}" FontWeight="SemiBold"/><TextBlock Text="{ReflectionBinding [linux.ui.use.comma.separated.control.alt.shift.and.meta.leave.both.fi.f2eb583d], Source={StaticResource Localization}}" Classes="caption"/><TextBlock Text="{ReflectionBinding [linux.ui.toggle.batch.recording.modifiers.and.key], Source={StaticResource Localization}}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsToggleModifiers" Text="{Binding ToggleShortcutModifiers}"/><TextBox x:Name="SettingsToggleKey" Grid.Column="1" Text="{Binding ToggleShortcutKey}"/></Grid><TextBlock Text="{ReflectionBinding [linux.ui.cancel.active.recording.modifiers.and.key], Source={StaticResource Localization}}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsCancelModifiers" Text="{Binding CancelShortcutModifiers}"/><TextBox x:Name="SettingsCancelKey" Grid.Column="1" Text="{Binding CancelShortcutKey}"/></Grid><TextBlock Text="{ReflectionBinding [linux.ui.change.mode.modifiers.and.key], Source={StaticResource Localization}}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsChangeModeModifiers" Text="{Binding ChangeModeShortcutModifiers}"/><TextBox x:Name="SettingsChangeModeKey" Grid.Column="1" Text="{Binding ChangeModeShortcutKey}"/></Grid><TextBlock Text="{ReflectionBinding [linux.ui.start.stop.live.streaming.modifiers.and.key], Source={StaticResource Localization}}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsStreamingShortcutModifiers" Text="{Binding StreamingShortcutModifiers}"/><TextBox x:Name="SettingsStreamingShortcutKey" Grid.Column="1" Text="{Binding StreamingShortcutKey}"/></Grid><ComboBox x:Name="SettingsPushToTalkMode" ItemsSource="{Binding PushToTalkModes}" SelectedItem="{Binding PushToTalkMode}"/><ComboBox x:Name="SettingsPushToTalkModifier" ItemsSource="{Binding PushToTalkModifiers}" SelectedItem="{Binding PushToTalkModifier}"/><TextBlock Text="{ReflectionBinding [linux.ui.custom.push.to.talk.modifiers.and.key], Source={StaticResource Localization}}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsPushToTalkCustomModifiers" Text="{Binding PushToTalkShortcutModifiers}"/><TextBox x:Name="SettingsPushToTalkCustomKey" Grid.Column="1" Text="{Binding PushToTalkShortcutKey}"/></Grid><CheckBox x:Name="SettingsPushToTalkDoubleLock" Content="{ReflectionBinding [linux.ui.double.press.to.lock.push.to.talk], Source={StaticResource Localization}}" IsChecked="{Binding PushToTalkDoublePressLock}"/><Button x:Name="SettingsResetShortcuts" Content="{ReflectionBinding [linux.ui.reset.shortcut.defaults], Source={StaticResource Localization}}" Command="{Binding ResetShortcutsCommand}" HorizontalAlignment="Left"/>

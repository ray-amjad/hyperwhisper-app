<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HyperWhisper.PortableApplication.ViewModels" x:Class="HyperWhisper.Linux.MainWindow" x:DataType="vm:ApplicationShellViewModel"
        Title="HyperWhisper" Width="1040" Height="680" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <ScrollViewer x:Name="HomeScreen">
      <StackPanel Spacing="20">
        <TextBlock Text="Record and transcribe" FontSize="22" FontWeight="SemiBold" />
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Text="Audio input" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Recording.AudioDevices}" SelectedItem="{Binding Recording.SelectedAudioDevice}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HomeStartRecordingButton" Content="Start recording" Click="OnStartRecording"/><Button x:Name="HomeStopRecordingButton" Content="Stop and transcribe" Click="OnStopRecording"/><Button x:Name="HomeCancelRecordingButton" Content="Cancel" Click="OnCancelRecording"/><Button Content="Refresh devices" Command="{Binding Recording.RefreshDevicesCommand}"/></StackPanel>
            <TextBlock Text="{Binding Recording.State, StringFormat='State: {0}'}"/><TextBlock Text="{Binding Recording.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Recording.ErrorCode}" IsVisible="{Binding Recording.HasError}" Opacity="0.7"/>
            <Separator/>
            <TextBlock Text="Transcribe an existing audio file" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="HomeAudioFileInput" Text="{Binding Recording.FilePath}" PlaceholderText="WAV, MP3, M4A, FLAC, OGG, or WebM"/><Button Grid.Column="1" Content="Browse…" Click="OnBrowseAudioFile"/><Button x:Name="HomeTranscribeFileButton" Grid.Column="2" Content="Transcribe file" Command="{Binding Recording.TranscribeFileCommand}"/><Button Grid.Column="3" Content="Cancel import" Command="{Binding Recording.CancelCommand}" IsVisible="{Binding Recording.IsImporting}"/></Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Recording.ImportProgress}" IsVisible="{Binding Recording.IsImporting}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Local library" FontSize="22" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
          <Border Padding="18" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><StackPanel><TextBlock Text="History"/><TextBlock Text="{Binding HistoryCount}" FontSize="28"/></StackPanel></Border>
          <Border Grid.Column="1" Padding="18" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><StackPanel><TextBlock Text="Vocabulary"/><TextBlock Text="{Binding VocabularyCount}" FontSize="28"/></StackPanel></Border>
          <Border Grid.Column="2" Padding="18" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><StackPanel><TextBlock Text="Modes"/><TextBlock Text="{Binding ModeCount}" FontSize="28"/></StackPanel></Border>
        </Grid>
        <Button x:Name="HomeRefreshButton" Content="Refresh library" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status.Message}" /><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
      </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <Grid x:Name="HistoryScreen" ColumnDefinitions="2*,3*" ColumnSpacing="20">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="HistorySearchInput" Text="{Binding SearchText}" PlaceholderText="Search transcripts"/><Button x:Name="HistorySearchButton" Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"/><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid>
          <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Text="From date"/><TextBlock Grid.Column="1" Text="Through date"/><DatePicker x:Name="HistoryStartDate" Grid.Row="1" SelectedDate="{Binding StartDate}"/><DatePicker x:Name="HistoryEndDate" Grid.Row="1" Grid.Column="1" SelectedDate="{Binding EndDate}"/><Button x:Name="HistoryClearFilters" Grid.Row="1" Grid.Column="2" Content="Clear filters" Command="{Binding ClearFiltersCommand}"/></Grid>
          <ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Multiple,Toggle" SelectionChanged="OnHistorySelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Text}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Date}" FontSize="11" Opacity="0.65"/><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding FailedReason}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="12">
          <TextBlock Text="Transcript detail" FontSize="20" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding SelectedStatusLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFailureReason}" Foreground="IndianRed" IsVisible="{Binding IsSelectedFailed}"/><TextBlock Text="Retry in progress…" IsVisible="{Binding IsSelectedRetrying}"/></StackPanel>
          <CheckBox x:Name="HistoryShowRawTranscript" Content="Show raw transcription" IsChecked="{Binding ShowRawTranscript}" IsEnabled="{Binding HasRawTranscript}"/>
          <TextBlock x:Name="HistoryDetailLabel" Text="{Binding DetailLabel}" FontWeight="SemiBold"/><TextBlock x:Name="HistoryDetailText" Text="{Binding DetailText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HistoryCopyButton" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}"/><TextBlock Text="{Binding Selected.TranscriptionProvider, StringFormat='Provider: {0}'}"/><TextBlock Text="{Binding Selected.Duration, StringFormat='Duration: {0:F1}s'}"/></StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Button x:Name="HistoryPlayButton" Content="{Binding PlayPauseLabel}" Command="{Binding PlayCommand}"/><Slider x:Name="HistoryPlaybackSlider" Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDurationSeconds}" Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}" IsEnabled="{Binding IsPlaybackAvailable}"/><TextBlock Grid.Column="2" Text="{Binding FormattedPlaybackPosition}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding FormattedPlaybackDuration, StringFormat=' / {0}'}" VerticalAlignment="Center"/></Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox x:Name="HistoryRetryMode" ItemsSource="{Binding AvailableRetryModes}" SelectedItem="{Binding SelectedRetryMode}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Retry mode"/><Button x:Name="HistoryRetryButton" Grid.Column="1" Content="Transcribe again" Command="{Binding RetryCommand}"/></Grid>
          <CheckBox x:Name="HistoryDeleteAudio" Content="Also delete app-owned recordings (off by default)" IsChecked="{Binding DeleteAudio}"/>
          <Button x:Name="HistoryDeleteButton" Content="Delete selected transcript(s)" Command="{Binding DeleteCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="Caller-owned files and symbolic-link targets are always retained." TextWrapping="Wrap" Opacity="0.65"/><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:VocabularyViewModel">
      <Grid x:Name="VocabularyScreen" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="VocabularyWordInput" PlaceholderText="Word or phrase" Text="{Binding Word}" Width="220"/><TextBox x:Name="VocabularyReplacementInput" PlaceholderText="Replacement (optional)" Text="{Binding Replacement}" Width="220"/><Button x:Name="VocabularyAddButton" Content="Save" Command="{Binding AddCommand}"/></StackPanel><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox x:Name="VocabularyTransferPath" Text="{Binding TransferPath}" PlaceholderText="/path/to/vocabulary.tsv"/><Button x:Name="VocabularyImportButton" Grid.Column="1" Content="Import" Command="{Binding ImportCommand}"/><Button x:Name="VocabularyExportButton" Grid.Column="2" Content="Export" Command="{Binding ExportCommand}"/></Grid></StackPanel>
        <StackPanel Grid.Row="1" Spacing="10"><ListBox x:Name="VocabularyList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="2*,2*,Auto" Margin="0,4"><TextBlock Text="{Binding Word}"/><TextBlock Grid.Column="1" Text="{Binding Replacement}"/><Button Grid.Column="2" Content="Delete" Command="{Binding $parent[ListBox].DataContext.DeleteCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ModesViewModel">
      <Grid x:Name="ModesScreen" ColumnDefinitions="2*,3*" ColumnSpacing="20">
        <ListBox x:Name="ModesList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        <ScrollViewer Grid.Column="1"><StackPanel Spacing="10">
          <TextBlock Text="Mode editor" FontSize="20" FontWeight="SemiBold"/><TextBox x:Name="ModeNameInput" PlaceholderText="Name" Text="{Binding Name}"/><TextBox x:Name="ModeLanguageInput" PlaceholderText="Language code" Text="{Binding Language}"/>
          <TextBlock Text="Transcription provider"/><ComboBox x:Name="ModeProviderType" ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding ProviderType}"/><TextBlock Text="Local engine (used for local modes)"/><ComboBox x:Name="ModeLocalEngine" ItemsSource="{Binding LocalEngines}" SelectedItem="{Binding LocalEngine}"/><TextBlock Text="Model ID or provider catalog model"/><TextBox x:Name="ModeTranscriptionModel" Text="{Binding TranscriptionModel}"/>
          <TextBlock Text="Cloud provider (used for cloud modes)"/><ComboBox x:Name="ModeCloudProvider" ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding CloudProvider}"/><TextBlock Text="HyperWhisper Cloud accuracy tier"/><ComboBox x:Name="ModeCloudAccuracyTier" ItemsSource="{Binding CloudAccuracyTiers}" SelectedItem="{Binding CloudAccuracyTier}"/><TextBlock Text="HyperWhisper Cloud domain"/><ComboBox x:Name="ModeCloudDomain" ItemsSource="{Binding CloudDomains}" SelectedItem="{Binding CloudDomain}"/><TextBlock Text="Gemini custom prompt"/><TextBox x:Name="ModeGeminiPrompt" Text="{Binding GeminiPrompt}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Mode vocabulary (comma or line separated)"/><TextBox x:Name="ModeCustomVocabulary" Text="{Binding CustomVocabulary}" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="ModeEnableScreenOcr" Content="Use screen OCR context for enhancement" IsChecked="{Binding EnableScreenOcr}"/>
          <Separator/><TextBlock Text="Post-processing" FontWeight="SemiBold"/><ComboBox x:Name="ModePostProcessingMode" ItemsSource="{Binding PostProcessingModes}" SelectedItem="{Binding PostProcessingMode}"/><TextBlock Text="Cloud provider"/><ComboBox x:Name="ModePostProcessingProvider" ItemsSource="{Binding PostProcessingProviders}" SelectedItem="{Binding PostProcessingProvider}"/><TextBlock Text="BYOK provider model"/><TextBox x:Name="ModePostProcessingModel" Text="{Binding PostProcessingModel}" PlaceholderText="gpt-4.1-mini"/><TextBlock Text="HyperWhisper Cloud provider:model"/><TextBox x:Name="ModeHyperWhisperCloudModel" Text="{Binding HyperWhisperCloudModel}" PlaceholderText="anthropic:claude-haiku-4-5"/><TextBlock Text="Local GGUF filename in models/LLM"/><TextBox x:Name="ModeLocalPostProcessingModel" PlaceholderText="gemma-4-E2B-it-Q4_K_M.gguf" Text="{Binding LocalPostProcessingModel}"/>
          <TextBlock Text="Custom OpenAI-compatible endpoint" FontWeight="SemiBold"/><TextBox x:Name="ModeCustomEndpointName" Text="{Binding CustomEndpointName}" PlaceholderText="Endpoint name"/><TextBox x:Name="ModeCustomEndpointUrl" Text="{Binding CustomEndpointUrl}" PlaceholderText="https://host/v1/chat/completions"/><TextBox x:Name="ModeCustomEndpointModel" Text="{Binding CustomEndpointModel}" PlaceholderText="Model name"/><TextBox x:Name="ModeCustomEndpointApiKey" Text="{Binding CustomEndpointApiKey}" PasswordChar="●" PlaceholderText="New API key (optional for local endpoints)"/><TextBlock Text="Endpoint credentials are kept in Secret Service or owner-only storage and never exported." TextWrapping="Wrap" Opacity="0.7"/>
          <TextBlock Text="Formatting and prompt" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><CheckBox x:Name="ModePunctuation" Content="Punctuation" IsChecked="{Binding Punctuation}"/><CheckBox x:Name="ModeCapitalization" Content="Capitalization" IsChecked="{Binding Capitalization}"/><CheckBox x:Name="ModeProfanityFilter" Content="Profanity filter" IsChecked="{Binding ProfanityFilter}"/><CheckBox x:Name="ModeRemoveTrailingPeriod" Content="Remove trailing period" IsChecked="{Binding RemoveTrailingPeriod}"/></StackPanel><TextBox x:Name="ModeEnglishSpelling" Text="{Binding EnglishSpelling}" PlaceholderText="English spelling (american/british)"/><TextBlock Text="Custom preset instructions"/><TextBox x:Name="ModeCustomInstructions" Text="{Binding CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"/><TextBlock Text="Optional system prompt (maximum 2000 characters)" Opacity="0.7"/><TextBox x:Name="ModeUserSystemPrompt" Text="{Binding UserSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="2000"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="New" Command="{Binding NewCommand}"/><Button x:Name="ModeSaveButton" Content="Save" Command="{Binding SaveCommand}"/><Button x:Name="ModeDeleteButton" Content="Delete" Command="{Binding DeleteCommand}"/></StackPanel><TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <ScrollViewer><StackPanel x:Name="SettingsScreen" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock Text="Application settings" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Default transcription language preference"/><TextBox x:Name="SettingsLanguageInput" Text="{Binding Language}"/><CheckBox x:Name="SettingsEnableErrorLogging" Content="Send privacy-filtered crash and performance diagnostics" IsChecked="{Binding EnableErrorLogging}"/><TextBlock Text="No transcript, audio, prompt, or credential content is attached. Source builds with no release DSN remain fully offline." TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Shortcuts and push-to-talk" FontWeight="SemiBold"/><TextBlock Text="Use comma-separated Control, Alt, Shift, and Meta. Leave both fields empty to unassign. Modifier-only shortcuts require at least two modifiers." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Toggle batch recording · modifiers and key"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsToggleModifiers" Text="{Binding ToggleShortcutModifiers}"/><TextBox x:Name="SettingsToggleKey" Grid.Column="1" Text="{Binding ToggleShortcutKey}"/></Grid><TextBlock Text="Cancel active recording · modifiers and key"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsCancelModifiers" Text="{Binding CancelShortcutModifiers}"/><TextBox x:Name="SettingsCancelKey" Grid.Column="1" Text="{Binding CancelShortcutKey}"/></Grid><TextBlock Text="Change mode · modifiers and key"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsChangeModeModifiers" Text="{Binding ChangeModeShortcutModifiers}"/><TextBox x:Name="SettingsChangeModeKey" Grid.Column="1" Text="{Binding ChangeModeShortcutKey}"/></Grid><TextBlock Text="Start/stop live streaming · modifiers and key"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsStreamingShortcutModifiers" Text="{Binding StreamingShortcutModifiers}"/><TextBox x:Name="SettingsStreamingShortcutKey" Grid.Column="1" Text="{Binding StreamingShortcutKey}"/></Grid><ComboBox x:Name="SettingsPushToTalkMode" ItemsSource="{Binding PushToTalkModes}" SelectedItem="{Binding PushToTalkMode}"/><ComboBox x:Name="SettingsPushToTalkModifier" ItemsSource="{Binding PushToTalkModifiers}" SelectedItem="{Binding PushToTalkModifier}"/><TextBlock Text="Custom push-to-talk modifiers and key"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="SettingsPushToTalkCustomModifiers" Text="{Binding PushToTalkShortcutModifiers}"/><TextBox x:Name="SettingsPushToTalkCustomKey" Grid.Column="1" Text="{Binding PushToTalkShortcutKey}"/></Grid><CheckBox x:Name="SettingsPushToTalkDoubleLock" Content="Double press to lock push-to-talk" IsChecked="{Binding PushToTalkDoublePressLock}"/><Button x:Name="SettingsResetShortcuts" Content="Reset shortcut defaults" Command="{Binding ResetShortcutsCommand}" HorizontalAlignment="Left"/>
        <Separator/><TextBlock Text="Text output" FontWeight="SemiBold"/><CheckBox x:Name="SettingsPasteResultText" Content="Paste the result into the active application" IsChecked="{Binding PasteResultText}"/><CheckBox x:Name="SettingsRemoveFillerWords" Content="Remove filler words when AI post-processing is off" IsChecked="{Binding RemoveFillerWords}"/><CheckBox x:Name="SettingsAutocapitalizeInsert" Content="Best-effort capitalization matching at the insertion point" IsChecked="{Binding AutocapitalizeInsert}"/><TextBlock Text="Insertion context is classified without retaining surrounding text. Unsupported or inaccessible fields leave capitalization unchanged." TextWrapping="Wrap" Opacity="0.7"/><CheckBox x:Name="SettingsRestoreClipboard" Content="Restore the previous clipboard after paste or copy" IsChecked="{Binding RestoreClipboardAfterPaste}"/><TextBlock Text="Clipboard restore delay (seconds)"/><NumericUpDown x:Name="SettingsClipboardRestoreDelay" Minimum="0" Maximum="60" Increment="0.5" Value="{Binding ClipboardRestoreDelaySeconds}"/>
        <Separator/><TextBlock Text="Live transcription" FontWeight="SemiBold"/><CheckBox x:Name="SettingsStreamingEnabled" Content="Enable the dedicated live-transcription shortcut" IsChecked="{Binding StreamingEnabled}"/><ComboBox x:Name="SettingsStreamingProvider" ItemsSource="{Binding StreamingProviders}" SelectedItem="{Binding StreamingProvider}"/><TextBox x:Name="SettingsStreamingLanguage" Text="{Binding StreamingLanguage}" PlaceholderText="auto"/><TextBox x:Name="SettingsStreamingModel" Text="{Binding StreamingModel}" PlaceholderText="Provider model (optional)"/><CheckBox x:Name="SettingsStreamingFastFormatting" Content="Enable provider fast formatting" IsChecked="{Binding StreamingFastFormatting}"/><TextBlock Text="Credentials are loaded from the secure Credentials page and are never stored in settings." TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Audio and desktop" FontWeight="SemiBold"/><CheckBox x:Name="SettingsSoundEffects" Content="Play recording start and stop sounds" IsChecked="{Binding EnableSoundEffects}"/><CheckBox x:Name="SettingsBoostMicrophone" Content="Temporarily raise low microphone volume" IsChecked="{Binding AutoIncreaseMicVolume}"/><CheckBox x:Name="SettingsKeepMicrophoneWarm" Content="Keep the selected microphone warm between recordings" IsChecked="{Binding KeepMicrophoneWarm}"/><TextBlock Text="Other-audio policy"/><ComboBox x:Name="SettingsAudioEnvironmentPolicy" ItemsSource="{Binding AudioEnvironmentPolicies}" SelectedItem="{Binding AudioEnvironmentPolicy}"/><CheckBox x:Name="SettingsAutostart" Content="Start HyperWhisper when this desktop session starts" IsChecked="{Binding AutostartEnabled}"/><TextBlock x:Name="SettingsDesktopContextStatus" Text="{Binding DesktopContextStatus}" TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Recording storage" FontWeight="SemiBold"/><CheckBox x:Name="SettingsKeepAudioFiles" Content="Keep app-owned audio after transcription" IsChecked="{Binding KeepAudioFiles}"/><CheckBox x:Name="SettingsAutoDeleteEnabled" Content="Automatically delete old transcripts and app-owned audio" IsChecked="{Binding AutoDeleteEnabled}"/><TextBlock Text="Delete items older than this many days (1–365)"/><NumericUpDown x:Name="SettingsAutoDeleteDays" Minimum="1" Maximum="365" Value="{Binding AutoDeleteDaysOld}"/><TextBlock x:Name="StoragePathText" TextWrapping="Wrap" Opacity="0.7"/><TextBlock x:Name="StorageStatusText" Text="Storage inventory loads at startup." TextWrapping="Wrap" Opacity="0.7"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SettingsStorageRefresh" Content="Refresh usage" Click="OnRefreshStorage"/><Button x:Name="SettingsStorageDeleteNow" Content="Delete now" Click="OnDeleteStoredAudioNow" IsEnabled="{Binding AutoDeleteEnabled}"/><Button x:Name="SettingsStorageOpenFolder" Content="Open recordings folder" Click="OnOpenRecordingsFolder"/></StackPanel><TextBlock Text="Linux securely stores canonical WAV files in the fixed XDG data recordings folder. Custom folders and M4A conversion are unavailable because they would weaken current ownership and portable codec guarantees. Imported caller originals are never deleted." TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Local API" FontWeight="SemiBold"/><CheckBox x:Name="SettingsLocalApiEnabled" Content="Enable the loopback-only local API" IsChecked="{Binding LocalApiEnabled}"/><TextBlock Text="Preferred port (falls back to an available loopback port)"/><NumericUpDown x:Name="SettingsLocalApiPort" Minimum="0" Maximum="65535" Value="{Binding LocalApiPort}"/><TextBlock Text="The generated bearer token and actual port are stored in a private local-api.json file." TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Local Whisper backend" FontWeight="SemiBold"/><ComboBox x:Name="SettingsLocalWhisperBackend" ItemsSource="{Binding LocalWhisperBackends}" SelectedItem="{Binding LocalWhisperBackend}"/><CheckBox x:Name="SettingsLocalWhisperCpuFallback" Content="Fall back to CPU if the selected Whisper GPU runtime cannot start" IsChecked="{Binding AllowLocalWhisperCpuFallback}"/><TextBlock x:Name="SettingsLocalWhisperRuntimeStatus" Text="{Binding LocalWhisperRuntimeStatus}" TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Auto prefers NVIDIA CUDA 12, then a physical Vulkan GPU, then CPU. Whisper runtime selection is process-wide; saved changes take effect after restart." TextWrapping="Wrap" Opacity="0.7"/>
        <Separator/><TextBlock Text="Local LLM backend" FontWeight="SemiBold"/><ComboBox x:Name="SettingsLocalLlmBackend" ItemsSource="{Binding LocalLlmBackends}" SelectedItem="{Binding LocalLlmBackend}"/><CheckBox x:Name="SettingsLocalLlmCpuFallback" Content="Fall back to CPU if GPU model loading fails" IsChecked="{Binding AllowLocalLlmCpuFallback}"/><TextBlock Text="{Binding LocalLlmRuntimeStatus}" TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="CUDA is selected only when its packaged backend and NVIDIA driver/runtime libraries are available. Physical GPU verification is still required for release." TextWrapping="Wrap" Opacity="0.7"/><Button x:Name="SettingsSaveButton" Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:ModelLibraryViewModel">
      <Grid x:Name="ModelsScreen" ColumnDefinitions="2*,3*" ColumnSpacing="20">
        <ListBox x:Name="ModelList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Opacity="0.65"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="Model library" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.DisplayName}" FontSize="18"/><TextBlock Text="{Binding Selected.Size, StringFormat='Download size: {0}'}"/><TextBlock Text="{Binding Selected.Status}" TextWrapping="Wrap"/><ProgressBar x:Name="ModelDownloadProgress" Minimum="0" Maximum="1" Value="{Binding Selected.Progress}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ModelDownloadButton" Content="Download" Command="{Binding DownloadCommand}"/><Button x:Name="ModelCancelButton" Content="Cancel" Command="{Binding CancelCommand}"/><Button x:Name="ModelDeleteButton" Content="Delete" Command="{Binding DeleteCommand}"/></StackPanel><TextBlock Text="Select the model ID in a mode after installation." TextWrapping="Wrap" Opacity="0.65"/><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:BackupViewModel">
      <StackPanel x:Name="BackupScreen" Spacing="14" MaxWidth="680" HorizontalAlignment="Left"><TextBlock Text="Universal backup" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Export or import the cross-platform universal-v2 format. API keys and transcript history are intentionally excluded." TextWrapping="Wrap"/><TextBlock Text="Unknown Linux, Windows, and macOS platform extension fields are preserved across an import/export round trip." TextWrapping="Wrap" Opacity="0.7"/><TextBox x:Name="BackupPathInput" Text="{Binding Path}" PlaceholderText="/path/to/hyperwhisper.hwbackup" Width="640"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="BackupExportButton" Content="Export backup" Command="{Binding ExportCommand}"/><Button x:Name="BackupImportButton" Content="Import backup" Command="{Binding ImportCommand}"/></StackPanel><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/></StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:CloudAccountViewModel">
      <ScrollViewer x:Name="AccountScreen">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="HyperWhisper Cloud account" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Activate the Account Key from your purchase email. The key is validated online, stored in Secret Service or owner-only storage, and never displayed after activation." TextWrapping="Wrap"/>
          <TextBlock Text="{Binding AccountState, StringFormat='Status: {0}'}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CustomerEmail, StringFormat='Email: {0}'}" IsVisible="{Binding HasCustomerEmail}"/>
          <TextBlock Text="{Binding CustomerId, StringFormat='Customer: {0}'}" IsVisible="{Binding HasCustomerId}"/>
          <TextBlock Text="{Binding ExpiresAt, StringFormat='Expires: {0}'}" IsVisible="{Binding HasExpiry}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasCredits}">
            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><StackPanel><TextBlock Text="Credits"/><TextBlock Text="{Binding Credits}" FontSize="24"/></StackPanel></Border>
            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><StackPanel><TextBlock Text="Estimated minutes"/><TextBlock Text="{Binding MinutesRemaining}" FontSize="24"/></StackPanel></Border>
          </Grid>
          <TextBox x:Name="AccountKeyInput" Text="{Binding AccountKey}" PasswordChar="●" PlaceholderText="Account Key"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AccountActivateButton" Content="Activate account" Command="{Binding ActivateCommand}"/>
            <Button x:Name="AccountStatusRefreshButton" Content="Refresh status" Command="{Binding RefreshStatusCommand}"/>
            <Button x:Name="AccountCreditsRefreshButton" Content="Refresh credits" Command="{Binding RefreshCreditsCommand}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AccountPurchaseButton" Content="Buy credits" Command="{Binding PurchaseCommand}"/>
            <Button x:Name="AccountManageButton" Content="Manage account" Command="{Binding ManageCommand}"/>
          </StackPanel>
          <Separator/>
          <TextBlock Text="Removing the account contacts the compatibility endpoint first, then removes the key from this device. The server currently does not support remote key revocation; use the account portal for account management." TextWrapping="Wrap" Opacity="0.7"/>
          <Button x:Name="AccountDeactivateButton" Content="Remove account from this device" Command="{Binding DeactivateCommand}" HorizontalAlignment="Left" IsVisible="{Binding HasAccount}"/>
          <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:CredentialManagementViewModel">
      <Grid x:Name="CredentialsScreen" ColumnDefinitions="2*,3*" ColumnSpacing="20"><ListBox x:Name="CredentialList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="6"><TextBlock Text="{Binding DisplayName}"/><TextBlock Grid.Column="1" Text="{Binding IsPresent, StringFormat='Stored: {0}'}" Opacity="0.65"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="Cloud provider credentials" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.DisplayName}" FontSize="18"/><TextBlock Text="Provider API keys use Secret Service when available, otherwise owner-only private files. Existing values are never displayed or exported. HyperWhisper Account Keys must be validated on the Cloud account page." TextWrapping="Wrap"/><TextBox x:Name="CredentialSecretInput" Text="{Binding Secret}" PasswordChar="●" PlaceholderText="Enter a new provider credential"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CredentialSaveButton" Content="Save securely" Command="{Binding SaveCommand}"/><Button x:Name="CredentialDeleteButton" Content="Delete stored credential" Command="{Binding DeleteCommand}"/></StackPanel><TextBlock Text="{Binding Status.Message}"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" Opacity="0.7"/></StackPanel></Grid>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,*,Auto" Margin="16"><StackPanel Spacing="4" Margin="8,8,8,24"><TextBlock Text="HyperWhisper" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Linux 1.0" Opacity="0.65"/></StackPanel><ListBox x:Name="Navigation" Grid.Row="1" SelectionChanged="OnNavigationChanged"><ListBoxItem Content="Home" Tag="home" IsSelected="True"/><ListBoxItem Content="Modes" Tag="modes"/><ListBoxItem Content="Models" Tag="models"/><ListBoxItem Content="History" Tag="history"/><ListBoxItem Content="Vocabulary" Tag="vocabulary"/><ListBoxItem Content="Backup" Tag="backup"/><ListBoxItem Content="Cloud account" Tag="account"/><ListBoxItem Content="Provider credentials" Tag="credentials"/><ListBoxItem Content="Settings" Tag="settings"/></ListBox><Border Grid.Row="2" Padding="10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock x:Name="PlatformStatusText" Text="Connecting Linux platform…" FontSize="12" TextWrapping="Wrap" Opacity="0.7"/></Border></Grid></Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="36,28"><TextBlock x:Name="PageTitle" Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/><Border Grid.Row="1" Margin="0,24,0,0" Padding="24" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><ContentControl x:Name="PageContent" Content="{Binding CurrentPage}"/></Border></Grid>
    <Border Grid.Column="1" Grid.Row="1" Padding="36,10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="StatusText" Text="{Binding Status.Message}" FontSize="12" Opacity="0.7"/><TextBlock Text="{Binding Status.ErrorCode}" IsVisible="{Binding Status.HasError}" FontSize="12" Opacity="0.7"/></StackPanel></Border>
  </Grid>
</Window>

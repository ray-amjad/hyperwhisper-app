  <!-- Tile colours, copied from the Windows sidebar so the two apps read as one product. -->
  <SolidColorBrush x:Key="HwTileHomeBrush" Color="#E8734A"/>
  <SolidColorBrush x:Key="HwTileModesBrush" Color="#2F7BE8"/>
  <SolidColorBrush x:Key="HwTileVocabularyBrush" Color="#2F7BE8"/>
  <SolidColorBrush x:Key="HwTileModelsBrush" Color="#6E5BD8"/>
  <SolidColorBrush x:Key="HwTileStreamingBrush" Color="#7C5CE6"/>
  <SolidColorBrush x:Key="HwTileHistoryBrush" Color="#5B6FD8"/>
  <SolidColorBrush x:Key="HwTileSettingsBrush" Color="#6B6B73"/>

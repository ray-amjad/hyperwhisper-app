  <!-- U+1F3AF DIRECT HIT: a dartboard WITH A DART IN IT. Five even-odd rings centred on
       9.5,14.5 (down and left, to clear the dart's flight in the top right corner), then the
       shaft on the 45 degree diagonal into the bullseye and a chunky four-point flight at its
       outer end. The previous thin arrow read as an arrow, not as a dart. -->
  <StreamGeometry x:Key="HwIconTarget">M 2,14.5 a 7.5,7.5 0 1 0 15,0 a 7.5,7.5 0 1 0 -15,0 Z M 3.5,14.5 a 6,6 0 1 0 12,0 a 6,6 0 1 0 -12,0 Z M 5,14.5 a 4.5,4.5 0 1 0 9,0 a 4.5,4.5 0 1 0 -9,0 Z M 6.5,14.5 a 3,3 0 1 0 6,0 a 3,3 0 1 0 -6,0 Z M 7.9,14.5 a 1.6,1.6 0 1 0 3.2,0 a 1.6,1.6 0 1 0 -3.2,0 Z M 8.86,13.86 L 16.86,5.86 L 18.14,7.14 L 10.14,15.14 Z M 21.2,2.8 L 20,8.9 L 17.4,6.6 L 15.1,4 Z</StreamGeometry>

  <!-- Home's "Add Vocabulary" disc, U+1F4DA BOOKS: three covers stepped down and to the right.
       The version this replaces drew three see-through outlines, so the rear covers showed
       straight through the front one and the stack read as a wireframe rather than as cards.

       The covers OCCLUDE, and the front one is the TOP LEFT, not the bottom right. Each rear
       cover is therefore written as the L-shaped sliver of itself that the cover in front does
       not hide (subpaths 3 and 4), rather than as a whole rectangle. Subpaths 1 and 2 are the
       front cover's outer edge and its hollow middle: only the front cover keeps an interior,
       which is what stops the glyph rendering as one solid block. Even-odd, like the rest of
       the file; the four subpaths are disjoint apart from that one deliberate nesting. -->
  <StreamGeometry x:Key="HwIconStackedPages">M 3,2.6 L 11,2.6 L 11,14.2 L 3,14.2 Z M 4.3,3.9 L 9.7,3.9 L 9.7,12.9 L 4.3,12.9 Z M 12.1,5.4 L 15.2,5.4 L 15.2,17 L 7.2,17 L 7.2,15.3 L 12.1,15.3 Z M 16.3,8.2 L 19.4,8.2 L 19.4,19.8 L 11.4,19.8 L 11.4,18.1 L 16.3,18.1 Z</StreamGeometry>

  <!-- The two History empty states. Windows draws a memo (a ruled page with a pencil across the
       lower right) on the list side and a ruled page on the detail side; Linux drew the same
       three-bar page on both. Both are stroked, not filled, on this page. -->
  <StreamGeometry x:Key="HwIconMemo">M6 3h8l4 4v14H6zm7.4 1.6V8H17zM8 12.6h6.4V14H8zm0 2.6h6.4v1.4H8zm0 2.6h4.4v1.4H8zm5.6 2.8.5-2.1 5.1-5.1 1.6 1.6-5.1 5.1z</StreamGeometry>
  <StreamGeometry x:Key="HwIconPage">M6 3h8l4 4v14H6zm7.4 1.6V8H17zM8.4 9.8h7.2v1.2H8.4zm0 2.4h7.2v1.2H8.4zm0 2.4h7.2v1.2H8.4zm0 2.4h7.2v1.2H8.4zm0 2.4h4.6v1.2H8.4z</StreamGeometry>

  <!-- Tile fills, copied from the Windows sidebar so the two apps read as one product.
       Windows paints each tile with a diagonal LinearGradientBrush from 0,0 to 1,1; a flat
       colour here read as a different, duller product beside the same rows on Windows. -->
  <LinearGradientBrush x:Key="HwTileHomeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#FF9A4D" Offset="0"/><GradientStop Color="#F05A28" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileModesBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#49A5FF" Offset="0"/><GradientStop Color="#236DFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileVocabularyBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#49A5FF" Offset="0"/><GradientStop Color="#236DFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileModelsBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#8A7CFF" Offset="0"/><GradientStop Color="#5B4BDB" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileStreamingBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#8A7CFF" Offset="0"/><GradientStop Color="#5B4BDB" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileHistoryBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#7C74FF" Offset="0"/><GradientStop Color="#4A42D8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HwTileSettingsBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#73777F" Offset="0"/><GradientStop Color="#3F444C" Offset="1"/>
  </LinearGradientBrush>

  <!-- Caption glyphs for the client-area title bar. Windows strokes these rather than filling
       them, so they are declared as geometry and drawn with a Stroke in the window markup. -->
  <StreamGeometry x:Key="HwIconCaptionMinimize">M0,0 H10</StreamGeometry>
  <StreamGeometry x:Key="HwIconCaptionClose">M1,1 L9,9 M9,1 L1,9</StreamGeometry>

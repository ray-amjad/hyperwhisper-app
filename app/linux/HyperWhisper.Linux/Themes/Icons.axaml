  <!-- One glyph per settings sub-nav row. The Linux pane used to point all ten rows at whichever
       main-sidebar geometry was nearest to hand, so seven of them drew the wrong picture: Sound a
       microphone, Cloud a tick, Backup a clock, About a house. Windows sets each row from its own
       Segoe MDL2 code point in Views/Pages/SettingsPage.xaml; these are the same pictures drawn as
       paths, because no Linux desktop ships that font. Keys are named for the picture, not for the
       row, so a later row change cannot silently reuse the wrong one. -->

  <!-- E995 Volume3: a speaker cone with three arcs. Settings ▸ Sound. -->
  <StreamGeometry x:Key="HwIconVolume">M3 9.5h3.2L10.5 6v12L6.2 14.5H3zm9.6-.1a3.6 3.6 0 0 1 0 5.2l1.15 1.15a5.2 5.2 0 0 0 0-7.5zm2.5-2.5a7.2 7.2 0 0 1 0 10.2l1.15 1.15a8.8 8.8 0 0 0 0-12.5zm2.5-2.5a10.8 10.8 0 0 1 0 15.2l1.15 1.15a12.4 12.4 0 0 0 0-17.5z</StreamGeometry>


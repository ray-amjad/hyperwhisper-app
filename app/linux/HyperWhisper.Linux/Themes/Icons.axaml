  <StreamGeometry x:Key="HwIconSettings">M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8zm8.4 3.4c0-.4 0-.8-.1-1.2l1.9-1.4-1.9-3.3-2.2.9a7 7 0 0 0-2-1.2l-.3-2.3h-3.8l-.3 2.3a7 7 0 0 0-2 1.2l-2.2-.9-1.9 3.3 1.9 1.4a7.4 7.4 0 0 0 0 2.4l-1.9 1.4 1.9 3.3 2.2-.9a7 7 0 0 0 2 1.2l.3 2.3h3.8l.3-2.3a7 7 0 0 0 2-1.2l2.2.9 1.9-3.3-1.9-1.4c.1-.4.1-.8.1-1.2z</StreamGeometry>

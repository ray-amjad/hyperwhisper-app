<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared look for the Linux shell. The Fluent defaults give square, high-contrast
       controls that do not match the Windows and macOS apps, so the rounding, spacing
       and type scale here follow app/windows/HyperWhisper/Themes. -->

  <!-- Type scale -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>

  <!-- Cards -->
  <!-- Card, row and title metrics come from the Windows theme: CardStyle is a 1px border with
       CardCornerRadius 9 and 16 padding, and a settings row is a 14px title over an 11px
       subtitle, divided by a 1px rule with 10 above and 10 below. -->
  <Style Selector="Border.card, Border.metricCard">
    <Setter Property="Background" Value="{DynamicResource HwCardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource HwWarningBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwWarningBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.notice TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HwWarningForegroundBrush}"/>
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwHoverBackgroundBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwSelectedBackgroundBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwSelectedBackgroundBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>

  <!-- The Settings sub-page column. No tile, so the rows sit tighter than the main sidebar. -->
  <Style Selector="ListBox.nav.sub ListBoxItem">
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Edition badge pinned under the sidebar, matching the Windows PRO chip. -->
  <Style Selector="Border.editionBadge">
    <Setter Property="Background" Value="{DynamicResource HwCardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style Selector="Border.editionPill">
    <Setter Property="Background" Value="{DynamicResource HwHoverBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>

  <!-- A settings row: title and description on the left, the control hard right, hairline
       under it. Windows groups these rows into one card, so the last row drops the rule. -->
  <Style Selector="Border.settingRow">
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0,0,0,10"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style Selector="Border.settingRow.last">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- A whole row that behaves as one button, for the Getting started list. -->
  <Style Selector="Button.rowAction">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,13"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.rowAction /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwCardBackgroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwHoverBackgroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.modeCard /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18,16"/>
  </Style>

  <Style Selector="Border.keyChip">
    <Setter Property="Background" Value="{DynamicResource HwHoverBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.statValue">
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>

  <!-- Empty state: a centred glyph and two lines, the shape Windows draws inside an
       empty list instead of leaving a blank rectangle. -->
  <Style Selector="StackPanel.emptyState">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Spacing" Value="6"/>
    <Setter Property="Margin" Value="0,34"/>
  </Style>
  <Style Selector="StackPanel.emptyState > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <!-- List surfaces inside a page -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="{DynamicResource HwInputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4"/>
    <!-- An empty list collapsed to a hairline and read as a stray rule across the page. -->
    <Setter Property="MinHeight" Value="180"/>
  </Style>
  <!-- The Fluent default is 296 px wide. Two of them plus a button never fit the History
       filter pane, so they drew over the transcript detail column. -->
  <Style Selector="DatePicker">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <!-- The history list runs edge to edge on the sidebar surface, as on Windows: no card, no
       rounded rows, and a selected row that fills the full pane width. -->
  <Style Selector="ListBox.flush">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="ListBox.flush ListBoxItem">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwSelectedBackgroundBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwSelectedBackgroundBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwSelectedBackgroundBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextPrimaryBrush}"/>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
    <!-- The template binds the presenter to the control, so set the control too. Styling
         only the presenter left an enabled button on the Fluent grey default. -->
    <Setter Property="Background" Value="{DynamicResource HwInputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource HwAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HwOnAccentBrush}"/>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwInputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwHoverBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwAccentBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HwAccentHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwAccentHoverBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwOnAccentBrush}"/>
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource HwInputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource HwInputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwBorderBrush}"/>
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="34"/>
  </Style>

  <!-- Separator: a hairline, not a control-sized gap -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource HwSubtleBorderBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="0,6"/>
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
  </Style>

  <!-- A disabled action should recede, not read as a filled button. -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HwSubtleBorderBrush}"/>
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HwTextTertiaryBrush}"/>
  </Style>

  <!-- The default scroll bar draws as a heavy dark bar against a card. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource HwTextTertiaryBrush}"/>
    <Setter Property="Opacity" Value="0.45"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Opacity" Value="0.75"/>
  </Style>

  <!-- Page bodies breathe better with a consistent gap between sections. -->
  <Style Selector="ScrollViewer.page">
    <Setter Property="Padding" Value="0,0,10,0"/>
  </Style>
</Styles>

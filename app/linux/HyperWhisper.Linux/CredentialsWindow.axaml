<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextOptions.TextRenderingMode="Antialias"
        xmlns:vm="using:HyperWhisper.PortableApplication.ViewModels"
        x:Class="HyperWhisper.Linux.CredentialsWindow" x:DataType="vm:CredentialManagementViewModel"
        FontFamily="{StaticResource HwUiFont}"
        FlowDirection="{ReflectionBinding FlowDirection, Source={StaticResource Localization}}"
        Title="{ReflectionBinding [settings.nav.apiKeys], Source={StaticResource Localization}}"
        Width="760" Height="760"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown"
        Background="{DynamicResource HwContentBackgroundBrush}" Foreground="{DynamicResource HwTextPrimaryBrush}">
  <!-- Windows opens its whole ApiKeysSettingsPage in a plain 760x760 modal from the Model
       Library's "API keys" button and rebuilds the library when it closes
       (the API keys window is constructed in code, Owner = MainWindow, CenterOwner, ShowDialog).
       Linux navigated the app to the credentials page instead, which lost the Model Library.

       The body is the same CredentialManagementViewModel template the credentials page uses,
       which is why that template now lives in Application.DataTemplates: a template declared on
       MainWindow is not visible to a second window. The page itself stays reachable, so nothing
       that pointed at it had to move. -->
  <!-- No footer button: the Windows modal carries none either, and is dismissed from the OS
       caption. Esc closes it here as well. -->
  <ContentControl x:Name="CredentialsHost" Margin="24" Content="{Binding}"/>
</Window>

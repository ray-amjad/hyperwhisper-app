<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared-dotnet/HyperWhisper.Platform.Abstractions/HyperWhisper.Platform.Abstractions.csproj" />
    <!-- The shared app-type classifier (issue #279). Linux had none, so every
         snapshot carried `AppType = "other"` and the Sensitive screen-OCR gate
         in the shared prompt builder could never fire. -->
    <ProjectReference Include="../../shared-dotnet/HyperWhisper.AppClassification/HyperWhisper.AppClassification.csproj" />
    <!-- The shared push-to-talk state machine (issue #287). The five-state
         machine was written here, in the Windows head and in macOS; it now lives
         in the hw-input crate and this head keeps only the evdev/portal event
         source, the timers and the clock. -->
    <ProjectReference Include="../../shared-dotnet/HyperWhisper.SharedCore/HyperWhisper.SharedCore.csproj" />
    <InternalsVisibleTo Include="HyperWhisper.Linux.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../windows/HyperWhisper/Assets/Sounds/start1.wav" Link="Assets/Sounds/start1.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../windows/HyperWhisper/Assets/Sounds/stop1.wav" Link="Assets/Sounds/stop1.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../desktop-companions/status-notifier.py" Link="DesktopCompanions/status-notifier.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  "name": "hyperwhisper-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "SKIP_ENV_VALIDATION=1 next dev --turbopack",
    "build": "next build",
    "cf:build": "node scripts/cf-build.mjs",
    "preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "deploy": "node scripts/cf-build.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test \"tests/*.test.ts\"",
    "test:coverage": "c8 npm test",
    "lint": "eslint --fix",
    "validate-appcast": "node scripts/validate-appcast.js",
    "validate-windows-appcast": "node scripts/validate-windows-appcast.js",
    "validate-appcasts": "npm run validate-appcast && npm run validate-windows-appcast",
    "preview-emails": "tsx scripts/preview-emails.ts",
    "check-appcast-live": "node scripts/check-appcast-live.js",
    "prebuild": "npm run validate-appcasts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@heroui/button": "2.2.32",
    "@heroui/card": "^2.2.28",
    "@heroui/divider": "^2.2.24",
    "@heroui/dropdown": "^2.3.32",
    "@heroui/input": "^2.4.33",
    "@heroui/link": "2.2.26",
    "@heroui/modal": "^2.2.29",
    "@heroui/navbar": "2.2.30",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@opennextjs/cloudflare": "1.20.13",
    "@sentry/nextjs": "11.7.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.7",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.540.0",
    "next": "16.4.3",
    "next-intl": "^4.9.1",
    "next-themes": "0.4.6",
    "pg": "^8.18.0",
    "pg-cloudflare": "^1.4.0",
    "posthog-js": "^1.268.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "stripe": "^20.1.0",
    "superjson": "^2.2.6",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.0",
    "@react-types/shared": "3.36.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.5.7",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "c8": "^10.1.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "ioredis": "^5.11.1",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.11",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "wrangler": "^4.151.0",
    "xml2js": "^0.6.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@node-minify/core>glob": "10.5.0"
    }
  }
}

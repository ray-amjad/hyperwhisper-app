# Cloudflare Workers Static Assets headers (DEPLOY-CLOUDFLARE.md).
# Files in public/ (and /_next/static) are served before the Worker runs, so
# next.config.mjs headers() does not reach them. This restores what Vercel sent.
# Keep the security block in step with config/security-headers.mjs.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Update feeds: read by the desktop apps and the release workflows.
/appcast.xml
  Access-Control-Allow-Origin: *
  Content-Type: application/xml

/appcast-windows.xml
  Access-Control-Allow-Origin: *
  Content-Type: application/xml

/linux-latest.json
  Access-Control-Allow-Origin: *

# Hashed build output: the file name changes whenever the content does, so it
# can be cached forever. Vercel sent the same header for these files.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Postgres for the Drizzle client. Optional at build time (Preview has none);
# the first database query throws "PLANETSCALE_DATABASE_URL is not set" without it.
PLANETSCALE_DATABASE_URL="postgresql://user:password@localhost:5432/hyperwhisper"

# Better Auth's public origin. Required: the build fails without it.
BETTER_AUTH_URL="http://localhost:3000"

# Optional support address for the download welcome email (code has a default)
# SUPPORT_EMAIL="support@example.com"

# Stripe (for billing)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Internal API secret (shared with Agentic Coding School for license grants)
HYPERWHISPER_INTERNAL_SECRET="your_internal_shared_secret_here"

# HyperWhisper Cloud apps whose licence cache an Account Key rotation purges
# (POST /internal/license-cache/invalidate, sent with the secret above).
# Comma-separated base URLs. Unset: production and staging on the production
# deployment only (DEPLOY_ENV=production), none elsewhere. Empty: no purge.
# HYPERWHISPER_CLOUD_URLS=

# HMAC key for the per-user credit_pool_id the license API hands the
# transcription service (#2026), so one user's Account Keys share one credit
# hold budget. At least 32 characters. Unset: no pool id is sent and the cloud
# holds per Account Key. Changing it splits a user's holds across the old and
# new id until each key's license cache refreshes (its next charge or balance
# read, at most the 1 hour cache TTL). Generate one with `openssl rand -hex 32`;
# never use a placeholder, since the id is only as private as this key.
# CREDIT_POOL_ID_SECRET=

# Cron bearer token. The Worker's scheduled() handler (worker.ts) calls each
# prune route with `Authorization: Bearer $CRON_SECRET`. Without it the nightly
# latency-retention and session prunes 401 forever.
CRON_SECRET="your_cron_secret_here"

# Email and rate limits are Cloudflare bindings (EMAIL, RATE_LIMIT_*) in
# wrangler.jsonc, not variables. Under plain `next dev` there are none: sends
# fail and the limiters let everything through.

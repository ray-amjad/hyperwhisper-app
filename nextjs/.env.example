NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (for billing)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Internal API secret (shared with Agentic Coding School for license grants)
HYPERWHISPER_INTERNAL_SECRET="your_internal_shared_secret_here"

# Vercel cron bearer token. Vercel sends `Authorization: Bearer $CRON_SECRET` to
# every job in vercel.json and cannot set a custom header. Without it the nightly
# latency-retention prune 401s forever.
CRON_SECRET="your_vercel_cron_secret_here"

# Resend Email Service
RESEND_API_KEY="your_resend_api_key_here"

# Upstash Redis — the site's own database. The transcription service has a
# separate one behind UPSTASH_REDIS_CLOUD_* (see hyperwhisper-cloud/.env.example).
# Both use the same @upstash/redis client and the same REST protocol, so a
# swapped value fails silently rather than loudly. Never cross-wire them.
UPSTASH_REDIS_SITE_URL="https://fake-redis.upstash.io"
UPSTASH_REDIS_SITE_TOKEN="fake_upstash_token"

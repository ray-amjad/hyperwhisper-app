# Copy to .dev.vars (gitignored) for `pnpm preview` / `wrangler dev`.
# Names only; real values come from Infisical (dev environment). Never commit
# a populated copy: this repo is public.
NEXTJS_ENV=development
# BETTER_AUTH_URL=http://localhost:8787
# BETTER_AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CRON_SECRET=
# OUTRANK_WEBHOOK_TOKEN=
# The HYPERDRIVE binding locally: set this in your shell (not here) to a dev
# Postgres URL.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
